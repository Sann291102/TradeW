# dependencies
node_modules/

# builds
dist/
.next/
# `.next/` does NOT match a sibling like `.next.prodbuild-aside-2026-08-11` —
# the trailing slash anchors it to a directory named exactly `.next`. That gap is
# why two full Next build trees are tracked in this repo today
# (apps/web/.next.prodbuild-aside-2026-08-11{,-b}): they were moved aside rather
# than deleted, which is the right instinct under Rule 1, and then silently
# became committable. `npm run dev:reset` produces exactly this shape of
# directory, so the pattern has to cover it or the next recovery adds more.
#
# Deliberately not un-tracking the two that are already in: gitignore does not
# affect tracked files, and removing them is a deletion — the user's call.
.next.*
out/
*.tsbuildinfo

# environment — never commit secrets (consolidation plan §0)
.env
.env.local
.env.*.local
.env.prod
.env.production

# logs / misc
*.log
.DS_Store
coverage/
.postman/
postman/

# python (future services)
__pycache__/
*.pyc
.venv/

# backups of env files — may contain secrets, never commit
*.env.bak
.env.bak
*.bak

# Tailscale funnel cert/key (never commit the private key)
tradew-demo.*.ts.net.crt
tradew-demo.*.ts.net.key
# SentinelIntelligence generated corpus cache — rebuilt from the repo by
# `npm run si:test` / POST /intelligence/reindex, so it is disposable by
# design. The learned-rules file beside it IS user data, but it is per-install
# state rather than source, so it stays untracked too.
services/sentinel/data/

.claude/Settings.local.json


# Terraform (infra/terraform, added 2026-08-10 with the Stage 1 AWS target).
# `*.tfvars` holds real domain names and zone ids; `*.tfstate` holds generated
# database passwords in plain text and must never be committed — the S3 backend
# in main.tf is where state belongs.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Azure deployment bundles — build artifacts, not sources. The deploy zip runs
# to hundreds of MB (past GitHub's 100MB hard limit), so it can never be
# committed; regenerate it from the build rather than tracking it.
tradew-azure-*.zip

# Cutting Room render products (added 2026-08-23). The harness is regenerated by
# build-harness.mjs — it embeds ~270KB of webfont binaries — and out/ holds the
# rendered MP4s. Both rebuild from `cutting-room.html` in a few minutes, so they
# are build artifacts, not sources.
scripts/cutting-room/.harness/
scripts/cutting-room/out/
