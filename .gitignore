# dependencies
node_modules/

# builds
dist/
.next/
out/
*.tsbuildinfo

# environment — never commit secrets (consolidation plan §0)
.env
.env.local
.env.*.local
.env.prod
.env.production

# logs / misc
*.log
.DS_Store
coverage/
.postman/
postman/

# python (future services)
__pycache__/
*.pyc
.venv/

# backups of env files — may contain secrets, never commit
*.env.bak
.env.bak
*.bak

# Tailscale funnel cert/key (never commit the private key)
tradew-demo.*.ts.net.crt
tradew-demo.*.ts.net.key
# SentinelIntelligence generated corpus cache — rebuilt from the repo by
# `npm run si:test` / POST /intelligence/reindex, so it is disposable by
# design. The learned-rules file beside it IS user data, but it is per-install
# state rather than source, so it stays untracked too.
services/sentinel/data/

.claude/Settings.local.json


# Terraform (infra/terraform, added 2026-08-10 with the Stage 1 AWS target).
# `*.tfvars` holds real domain names and zone ids; `*.tfstate` holds generated
# database passwords in plain text and must never be committed — the S3 backend
# in main.tf is where state belongs.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
