# dependencies
node_modules/

# builds
dist/
.next/
# `.next/` does NOT match a sibling like `.next.prodbuild-aside-2026-08-11` —
# the trailing slash anchors it to a directory named exactly `.next`. Two such
# moved-aside build trees were once committed by accident; they were untracked
# (not deleted from disk) in the 2026-11-14 repo cleanup. `npm run dev:reset`
# produces exactly this shape of directory, so the pattern has to cover it.
.next.*
out/
*.tsbuildinfo

# environment — never commit secrets (consolidation plan §0)
.env
.env.local
.env.*.local
.env.prod
.env.production

# logs / misc
*.log
.logs/
.DS_Store
coverage/
.postman/
postman/

# python (future services)
__pycache__/
*.pyc
.venv/

# backups of env files — may contain secrets, never commit
*.env.bak
.env.bak
*.bak

# Tailscale funnel cert/key (never commit the private key)
tradew-demo.*.ts.net.crt
tradew-demo.*.ts.net.key
# SentinelIntelligence generated corpus cache — rebuilt from the repo by
# `npm run si:test` / POST /intelligence/reindex, so it is disposable by
# design. The learned-rules file beside it IS user data, but it is per-install
# state rather than source, so it stays untracked too.
services/sentinel/data/

# Live-feed bridge last-valid-price recovery file. Public last-traded prices
# only — no credentials — but it is per-install runtime state rebuilt from the
# feed, not source. It is what lets a restart after the market closes come up
# showing the previous session's prices instead of nothing.
services/market-data/.cache/

.claude/Settings.local.json


# Terraform (infra/terraform, added 2026-08-10 with the Stage 1 AWS target).
# `*.tfvars` holds real domain names and zone ids; `*.tfstate` holds generated
# database passwords in plain text and must never be committed — the S3 backend
# in main.tf is where state belongs.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Local Azure Bicep parameter files may contain subscription identifiers,
# resource names and (in a misconfigured deployment) secrets. Keep only the
# reviewed example in source control.
infra/azure/*.local.bicepparam
crash.log

# Azure deployment bundles — build artifacts, not sources. The deploy zip runs
# to hundreds of MB (past GitHub's 100MB hard limit), so it can never be
# committed; regenerate it from the build rather than tracking it.
tradew-azure-*.zip


# ── Private company content (removed from the public repo 2026-11-14) ───────
# Kept on the owner's machine in "D:\TradeW Private Content" at these same
# paths; copy it back into a checkout to restore the features that read it
# (Sentinel's knowledge corpus, Learning pages, the admin Knowledge workspace,
# the TradeW AI agent definitions). The code runs without it. Never commit it.
/archive/
/docs/
/knowledge/
/knowledge-base/
/agents/
/ARCHITECTURE.md
/REPOSITORY_INVENTORY.md
/SENTINEL_MASTER_PLAN.md
/SENTINEL_ROOT_CAUSE_AND_PERMANENT_FIX.md
/scripts/cutting-room/
/scripts/explainer/
/workflows/
/apps/mobile/
/services/analytics/
/services/auth/
/services/notification/
/services/trading-engine/
/packages/sdk/
/packages/shared/
/.claude/launch.json
/.codex/
