# TradeW — root environment configuration (template)
#
# Consolidated 2026-08-04. This is the ONE source of truth for local dev
# environment variables across the whole monorepo: apps/web, services/api,
# services/market-data, services/sentinel, and packages/database all load
# this same root `.env` (see each service's `src/main.ts` — dotenv is pointed
# explicitly at this file's path, not the service's own directory).
#
# Copy this file to `.env` at the repo root and fill in real values:
#   cp .env.example .env
#
# Two narrow, deliberate exceptions to "one file" (both documented where they
# live, not hidden):
#   - `apps/web/.env.local` — Next.js only reads env files from the app's own
#     directory; it cannot be pointed at an external path. Holds just the two
#     NEXT_PUBLIC_* vars, which must also be duplicated here since Next.js
#     inlines them into the client bundle at build time.
#   - `packages/database/.env` — the Prisma CLI resolves `.env` from its own
#     working directory the same way; holds one mirrored line, DATABASE_URL.
#
# Production deployment uses a SEPARATE file with different value shapes
# (image tags, relative proxy paths, backup config) —
# `infra/docker/.env.prod.example` — because dev and prod are genuinely
# different configurations, not a duplicate needing consolidation.

# =============================================================================
# Database (shared: services/api, services/market-data, services/sentinel,
# packages/database)
# =============================================================================
# Must match infra/docker/docker-compose.yml's Postgres port mapping
# ('5433:5432' — host:container). Using the bare 5432 here is a common trap:
# it silently points at a DIFFERENT local Postgres if one happens to be
# running on the machine's default port.
DATABASE_URL=postgresql://tradew:tradew@localhost:5433/tradew

# =============================================================================
# Auth (services/api)
# =============================================================================
# JWT_SECRET signs every session token — anyone who knows it can forge a token
# for any user. It has NO fallback: services/api refuses to boot if this is
# unset, a known placeholder, or shorter than 32 chars. Generate a unique value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Comma-separated list of allowed browser origins for CORS.
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Google Sign-In (services/api/src/auth/google-oauth.service.ts)
# =============================================================================
# LEAVE BLANK to disable: /auth/google returns 503 and the landing page's
# "Continue with Google" reports "not available on this server" (via
# GET /auth/methods) instead of erroring. THIS IS WHY GOOGLE LOGIN CURRENTLY
# DOES NOTHING — the credentials below were never set.
#
# To enable, in Google Cloud Console → APIs & Services → Credentials:
#   1. Create an OAuth 2.0 Client ID (type: Web application).
#   2. Authorized redirect URI must EXACTLY equal GOOGLE_REDIRECT_URI below,
#      scheme + host + port included. Dev: http://localhost:4000/auth/google/callback
#      Prod: https://api.YOURDOMAIN/auth/google/callback
#   3. Paste the client id + secret here. Set API_PUBLIC_URL to the API's public
#      origin so the default redirect is correct if you omit GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to ${API_PUBLIC_URL:-http://localhost:4000}/auth/google/callback.
GOOGLE_REDIRECT_URI=
# The API's own public origin (used to build the default redirect + links).
API_PUBLIC_URL=http://localhost:4000

# =============================================================================
# Service ports & bind host
# =============================================================================
API_PORT=4000
MARKET_DATA_PORT=4020
SENTINEL_PORT=4010
# Internal services (market-data, sentinel) bind to localhost by default;
# container/K8s deployments override with HOST=0.0.0.0 behind the private
# network boundary.
HOST=127.0.0.1
# Sentinel dev-only CORS allowlist (lets the web app call it directly from
# the browser in local dev; internal-only in staging/production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# apps/web dev proxy targets (used by apps/web/next.config.mjs rewrites)
# =============================================================================
API_PROXY_TARGET=http://127.0.0.1:4000
FEED_PROXY_TARGET=http://127.0.0.1:4600

# =============================================================================
# apps/web public vars — ALSO required in apps/web/.env.local (Next.js
# inlines NEXT_PUBLIC_* at build time and cannot read an external file).
# Production instead builds with NEXT_PUBLIC_API_URL=/api,
# NEXT_PUBLIC_DHAN_LIVE_URL=/feed (relative, proxied by Caddy) — see
# .github/workflows/deploy.yml.
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DHAN_LIVE_URL=http://localhost:4600

# =============================================================================
# Dhan broker & market data credentials
# =============================================================================
# Individual access tokens expire every 24h; prefer the app key/secret
# consent flow, which stores a renewable token in BrokerCredential.
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
DHAN_APP_ID=
DHAN_APP_SECRET=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_FEED_URL=wss://api-feed.dhan.co
# The standalone live-feed bridge (services/market-data/scripts/live-feed-server.ts)
# — real Dhan prices, same ones the dashboard/charts/option chain show. This
# is NOT services/market-data's NestJS ingestor (MARKET_DATA_* below), which
# writes Postgres `Quote` from a simulated feed by default.
DHAN_LIVE_URL=http://localhost:4600

# =============================================================================
# Market data ingestion (services/market-data — the NestJS ingestor)
# =============================================================================
# simulated | dhan. Defaults to the simulator; an operator must opt in to a
# live feed so a typo can never silently label simulated data as live.
MARKET_DATA_FEED=simulated
MARKET_DATA_PROVIDER=simulated
# ticker | quote | full — richness of the subscription. Full carries depth
# and OI (162 bytes/tick); ticker is 16.
MARKET_DATA_FEED_MODE=full
# How often coalesced quotes are written to Postgres.
MARKET_DATA_FLUSH_MS=2000
# Simulator tick cadence.
MARKET_DATA_SIM_INTERVAL_MS=2000
# Emit ticks outside 09:15-15:30 IST. Off by default so the feed behaves like
# a real one — code that assumes ticks always arrive should fail in dev.
MARKET_DATA_SIM_EMIT_WHEN_CLOSED=false
# Set false for a maintenance window; the service boots without starting the feed.
INGESTION_ENABLED=true

# =============================================================================
# Admin portal (apps/web /admin, apps/admin, services/api AdminAccessGuard)
# =============================================================================
# There are TWO admin identities, and this section configures both. In both,
# ADMIN_API_TOKEN is the shared secret proving the CALLING PROCESS is an admin
# deployment — never sufficient on its own, always required.
#
#   · apps/web  (in-product console): ADMIN_API_TOKEN + a signed-in TradeW user
#     whose User.isAdmin is true. Grant with:
#       npm run admin:grant -w @tradew/database -- someone@example.com
#   · apps/admin (standalone control plane): ADMIN_API_TOKEN + a per-person
#     OperatorAccount, which is what makes an action attributable. Create with:
#       npm run operator:create -w @tradew/database -- ops@example.com "<password>"
#
# ADMIN_API_TOKEN — the operator shared secret. Unset OR structurally-invalid
# (a known placeholder, <24 chars, or a third-party vendor key like
# sk-ant-…/nvapi-…) disables the admin API entirely (fails closed). NEVER reuse
# a vendor key (e.g. ANTHROPIC_API_KEY) here — the guard rejects it. Mint one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotate by changing this and restarting; every open console is locked out.
ADMIN_API_TOKEN=

# OPERATOR_JWT_SECRET — signs the assertion that names the OperatorAccount on
# each standalone-console request. It MUST be different from JWT_SECRET: an
# operator assertion signed with the product's key would be a valid product
# bearer token, so a separate key is what keeps the two credential systems
# apart. It also must NOT be derived from ADMIN_API_TOKEN, which travels on the
# wire on every request — this secret never leaves services/api. Unset or weak
# (<32 chars / vendor key) disables the STANDALONE operator path only; the
# apps/web product-admin path is unaffected. Mint a dedicated value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OPERATOR_JWT_SECRET=

# =============================================================================
# Inter-service auth: services/api <-> services/sentinel
# =============================================================================
SENTINEL_SERVICE_URL=http://localhost:4010
# Same shared secret, read under two different names on each side (a
# consolidation follow-up candidate, not renamed in this pass to limit
# blast radius — see the implementation report's tech-debt section):
#   services/api reads this value as SENTINEL_SERVICE_TOKEN
#   services/sentinel reads this value as SERVICE_TOKEN
# Keep both lines equal. sentinel's ServiceTokenGuard rejects unset, placeholder,
# or <24-char values (fails closed) and compares in constant time. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SENTINEL_SERVICE_TOKEN=
SERVICE_TOKEN=

# =============================================================================
# Inter-service auth: services/api <-> services/sentinel-py (new Python
# rebuild, additive alongside services/sentinel above — see
# SENTINEL_MASTER_PLAN.md). Not yet wired into services/api's proxy layer.
# =============================================================================
SENTINEL_PY_SERVICE_URL=http://localhost:4011
# Shared secret, used in BOTH directions: services/api sends it when calling
# sentinel-py, and sentinel-py sends it back when pushing notifications to
# services/api's /internal/sentinel-py/notify. Rejected below 24 chars on the
# receiving side (fails closed), so an unset value denies rather than allows.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SENTINEL_PY_SERVICE_TOKEN=
# Where sentinel-py pushes notifications (services/api's ingress).
SENTINEL_PY_API_URL=http://localhost:4000

# =============================================================================
# Sentinel autonomy (services/sentinel — SentinelIntelligence background work)
# =============================================================================
# All three are ON by default and listed here only so the opt-outs are
# discoverable. Together they are what makes Sentinel observe without a browser
# open; switching any of them off returns part of that to being request-driven.
#
# SI_WATCH_ENABLED=false          stops the 60s continuous watch loop entirely.
# SI_WATCH_PERSIST_SESSION=false  retires a watch SI_WATCH_TTL_MS (default 30m)
#                                 after the last request for that symbol instead
#                                 of holding it to the market close. With the
#                                 dashboard polling /observe every 45s that
#                                 makes the browser the heartbeat again.
# SI_INDEX_ON_BOOT=false          skips the deferred corpus warm-up, leaving the
#                                 corpus empty until the first
#                                 /intelligence/reason call — while it is empty
#                                 the background watch records detections but
#                                 declines to reason about them.
#
# Cost note: a sweep only touches the metered candle API during trading hours
# and only for symbols someone has actually observed, capped by
# SI_WATCH_MAX_SYMBOLS (default 12).

# =============================================================================
# Sentinel paper execution (services/api — the loop that turns a Sentinel
# observation into a PAPER order; see services/api/src/paper-execution/)
# =============================================================================
# THE PROCESS SWITCH. Must be exactly "true" or no timer is ever started —
# ExecutionSchedulerService logs "paper execution loop is disabled" at boot and
# nothing evaluates. Arming a profile in the admin console is the OTHER switch:
# both must be on before the loop ticks by itself. Two deliberate acts, in two
# places, by two mechanisms, so a deployment that happens to carry an enabled
# profile row cannot silently start trading. ("Run pass" in the console works
# either way, and applies every policy gate.)
PAPER_EXECUTION_ENABLED=false
# How often the leader replica evaluates every armed profile. Slow on purpose:
# one pass reads candles, an option chain and the strategy engine, and that read
# changes on the bar, not on the tick.
PAPER_EXECUTION_INTERVAL_MS=60000
# How often intents are reconciled against the OMS and square-off runs. Faster,
# because it only reads local rows and its job is to notice a fill promptly.
PAPER_EXECUTION_RECONCILE_MS=15000
# Ceiling on the api→sentinel POST /execution/evaluate call. Longer than the
# trader-facing 20s ceiling — nothing is waiting on it interactively — and far
# shorter than the tick interval. Requires SENTINEL_SERVICE_TOKEN above; unset,
# the loop fails closed and says so rather than surfacing a 401.
SENTINEL_EXECUTION_TIMEOUT_MS=30000

# =============================================================================
# Knowledge Workspace (services/api — internal engineering vault, gated
# behind /admin/knowledge; see services/api/src/knowledge/)
# =============================================================================
# Absolute path to the vault; defaults to ../../knowledge relative to the
# service's cwd if left blank.
KNOWLEDGE_ROOT=
# true = always on, false = always off, unset = on outside production only.
KNOWLEDGE_WORKSPACE_ENABLED=true

# =============================================================================
# Third-party market data
# =============================================================================
# Twelve Data — FX market data (free "basic" tier: 8 req/min, 800/day).
# Server-side only; never exposed to the browser.
TWELVEDATA_API_KEY=

# =============================================================================
# Outbound email / OTP (services/api/src/mail)
# =============================================================================
# Two providers, and whichever is configured wins — SendGrid first if both are.
# LEAVE BOTH BLANK IN DEV: with neither configured the mailer logs the message
# instead of sending, and OTP endpoints return the code as `devCode` so the
# flows stay testable without credentials. NOTE that `devCode` is returned ONLY
# in that unconfigured state — once a provider is set the code is never in an
# HTTP response again, including when the provider rejects the send.
#
# ── OPTION A: SendGrid (recommended in cloud) ────────────────────────────────
# One HTTPS POST on 443. Prefer this anywhere outbound SMTP may be filtered —
# Azure restricts outbound SMTP on many subscription types, and no application
# setting overrides that. Free tier is 100 emails/day.
#   1. sendgrid.com -> Settings -> Sender Authentication -> verify your domain
#      (or a Single Sender for testing)
#   2. Settings -> API Keys -> Create, with the "Mail Send" permission only
#   3. Paste it below. The key IS the credential — there is no user field.
# MAIL_FROM's address must be one SendGrid has verified, or sends return 403.
SENDGRID_API_KEY=
#
# ── OPTION B: generic SMTP ───────────────────────────────────────────────────
# With Gmail, SMTP_PASS must be an App Password, not the account password.
# Needs port 587 (or 465) reachable outbound from wherever the API runs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From: address on every outbound email (login alerts, OTP, EOD summary).
# CAVEAT with Gmail SMTP: Gmail only lets you send as SMTP_USER or a verified
# "Send mail as" alias. If MAIL_FROM's address is neither, Gmail silently
# rewrites From: to SMTP_USER. To actually send as admin@tradew-setup.com,
# either (a) add + verify it as a Gmail alias, or (b) use that domain's own
# SMTP (Google Workspace / SES / Resend). See services/api/src/mail/templates.ts.
MAIL_FROM=TradeW · Setup <admin@tradew-setup.com>
# Reply-to / support address shown in email footers.
SUPPORT_EMAIL=admin@tradew-setup.com

# =============================================================================
# Payments — Razorpay (services/api/src/payments)
# =============================================================================
# LEAVE BLANK to keep billing disabled: /payments/catalog reports
# billingEnabled:false and /payments/checkout refuses, exactly like /pricing.
# KEY_ID is publishable (sent to the browser to open the widget); KEY_SECRET and
# WEBHOOK_SECRET are server-only. Create the webhook secret in the Razorpay
# dashboard and point the webhook at POST /payments/webhook with events
# payment.captured, order.paid, payment.failed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# =============================================================================
# End-of-day summary email (services/api/src/sim/eod-summary.service.ts)
# =============================================================================
# OFF by default — set true to email every active paper-trading user a daily
# portfolio + orders wrap-up after market close. Guarded by leader-election,
# trading-day, after-close-hour and once-per-user-per-day, so it can't spam.
# Users can opt out with the `eod_email_enabled=false` preference.
EOD_EMAIL_ENABLED=false
# Hour (IST, 0-23) after which the summary may send. Default 16:00, past the
# 15:30 NSE close so the day's numbers are final.
EOD_EMAIL_HOUR_IST=16

# =============================================================================
# Sentinel — AI providers (services/sentinel)
# All optional; without keys Sentinel composes messages deterministically
# from signals instead of calling an LLM.
# =============================================================================
# Preference order, comma-separated — config decides, never code.
AI_LLM_ORDER=nvidia-nim,anthropic,openai,ollama
AI_EMBEDDING_ORDER=nvidia-nim,voyage,openai
AI_RESEARCH_ORDER=tavily,brave,anthropic-web-search,firecrawl

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=

# NVIDIA NIM: hosted (integrate.api.nvidia.com) needs the API key; a
# self-hosted NIM (incl. a distilled student model) needs only the base URL.
# Free key: https://build.nvidia.com -> any model -> "Get API Key" (nvapi-...)
# To run Sentinel entirely on the free tier, put nvidia-nim first in
# AI_LLM_ORDER / AI_EMBEDDING_ORDER above.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Retrieval embeddings (1024-dim); MemoryRecord.embedding is dimension-flexible.
NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# Per-tier model pinning (blank keeps the built-in default). Measured on the
# free tier 2026-07-23 — latency is NOT predicted by parameter count and the
# catalog never shows it; always time a model before pinning it.
#   meta/llama-3.1-8b-instruct              0.3-6.7s   tool calls OK
#   nvidia/llama-3.3-nemotron-super-49b-v1  1.5-15s    tool calls OK
#   google/diffusiongemma-26b-a4b-it        ~200-290s  reasoning; 504s sometimes
#   meta/llama-3.2-3b-instruct              AVOID — timed out repeatedly
# 'fast' is the workhorse tier: every Sentinel agent, the orchestrator, the
# explain service, the brain and the news classifier all run on it.
NVIDIA_NIM_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_NIM_MODEL_BALANCED=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_NIM_MODEL_DEEP=google/diffusiongemma-26b-a4b-it
# Reasoning gate for models that support it (diffusiongemma); llama models
# silently ignore it, safe to leave on provider-wide. Thinking is billed out
# of max_tokens — short-budget calls get truncated answers.
NVIDIA_NIM_ENABLE_THINKING=true
NVIDIA_NIM_TOP_P=0.95
# Must exceed the slowest model above or deep-tier calls abort mid-flight.
NVIDIA_NIM_TIMEOUT_MS=300000
OLLAMA_BASE_URL=

# =============================================================================
# Sentinel — live market data bridge
# =============================================================================
# Sentinel reads real candles + breadth/VIX from the standalone Dhan
# live-feed bridge (same as DHAN_LIVE_URL above) when set; falls back to the
# Candle table, then the simulator, if unset or unreachable.
SENTINEL_LIVE_FEED_URL=http://localhost:4600
SENTINEL_LIVE_FEED_TIMEOUT_MS=4000

# =============================================================================
# Operational limits and background jobs  (added 2026-08-10, readiness audit)
# =============================================================================
# Rate limiting — see services/api/src/common/throttling.ts. Two buckets per
# caller: `global` spans every route, `route` is per endpoint. Counters live in
# the API process's memory, so these are PER REPLICA: with two API containers
# the effective ceiling is double. Moving to a shared store is a Stage 1
# prerequisite, not a tuning knob — see docs/CLOUD-ARCHITECTURE.md.
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_ROUTE_PER_MIN=240
# Credential endpoints (login, signup, phone/verify, password/reset).
RATE_LIMIT_AUTH_PER_MIN=8
# Endpoints that send an SMS or an email on every call.
RATE_LIMIT_OTP_PER_MIN=3
# Unauthenticated third-party proxies (/crypto, /forex, /us-stocks, /news).
RATE_LIMIT_PUBLIC_PER_MIN=60
# Sentinel reasoning — an operational per-minute ceiling beside the plan quota.
RATE_LIMIT_EXPENSIVE_PER_MIN=30

# How many reverse-proxy hops sit in front of services/api. This is what makes
# the rate limiter and the security audit log see the real client IP instead of
# the proxy's. It MUST match the deployment: 0 when the API is directly exposed
# (any value > 0 would then let a client forge X-Forwarded-For and mint itself a
# fresh rate-limit bucket per request), 1 behind Caddy, 2 behind CloudFront→ALB.
TRUSTED_PROXY_HOPS=0

# Singleton background jobs (matching engine, settlement sweep, performance
# snapshots, telemetry retention) coordinate through the JobLease table so
# exactly one replica runs them — see services/api/src/common/leader-election.ts.
# Renewal must stay well below the TTL or leadership flaps; the service refuses
# to start otherwise.
JOB_LEASE_TTL_MS=30000
JOB_LEASE_RENEW_MS=10000

# How long API/AI/agent telemetry is kept before the hourly retention sweep
# deletes it. Every HTTP request writes an ApiCallLog row, so this is the only
# thing bounding those tables. The admin portal's views are day- and week-
# scoped, so nothing in the product reads further back than this.
TELEMETRY_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Cognition network — the four-layer perceptor network behind /admin/cognition.
# Architecture: knowledge/Decisions/2026-08-12 - Cognition network (perceptors
# + four layers).md. Code: packages/ai-core/src/cognition/.
#
# OFF BY DEFAULT. Unset, the 17 perceptors are still registered (so the console
# can show the roster) and no passes run. A learning loop that switches itself
# on during a deploy nobody scoped for it is not a feature.
#
# It is leader-elected through the same JobLease table as the jobs above: two
# replicas would double-count every observation, and each would lay eligibility
# traces that the other's outcomes could never score.
COGNITION_ENABLED=false

# How often a full L1..L4 pass runs, and the default lookback window each pass
# senses. The perceptors compare against the immediately preceding window of the
# same length, so changing this changes what counts as a baseline.
COGNITION_PASS_MS=300000

# How often changed weights are written back to NeuralSynapse. Batched rather
# than write-through because one pass can touch hundreds of synapses and a
# round trip inside the association loop is the hot path. Accepted loss on a
# crash is bounded by this interval.
COGNITION_FLUSH_MS=30000

# L1's attention budget: percepts below this salience are counted and dropped.
# Raise it if the console shows the layers being fed noise; lower it if the
# gated count is always zero, which means the floor is not doing anything.
COGNITION_SALIENCE_FLOOR=0.15

# Percept and CognitiveEpisode retention. NOTE: this deliberately does NOT apply
# to NeuralSynapse. Percepts and episodes are history and regenerate; a weight
# is weeks of accumulated outcomes that cannot be recomputed from anything else
# in the database. Pruning it would delete everything the network has learned.
COGNITION_RETENTION_DAYS=30

# Postgres pool size PER PROCESS. Prisma's default is (cpus * 2 + 1), which is
# fine for one container and an easy way to exhaust `max_connections` once
# several replicas each open their own pool. Set it explicitly and size it
# against the database's ceiling, not the container's CPU count — append
# `?connection_limit=10&pool_timeout=10` to DATABASE_URL rather than setting a
# separate variable (Prisma reads it from the URL).
