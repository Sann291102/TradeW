{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strict": true,
    "skipLibCheck": true
  },
  // Same rationale as services/market-data: build only the service, so `nest
  // build` cannot shift the inferred rootDir and emit dist/src/main.js instead
  // of dist/main.js.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
