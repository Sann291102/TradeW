# Market data ingestion runtime — internal service, never public.
# SINGLETON: do not run more than one instance (see src/main.ts).
PORT=4020
HOST=127.0.0.1

# Same Postgres as services/api. This service is the sole writer of Quote and
# of the broker-metadata columns on Instrument.
DATABASE_URL=postgresql://tradew:tradew@localhost:5433/tradew

# --- Provider selection -------------------------------------------------------
# Defaults to the simulator. An operator must opt in to a live feed, so a typo
# can never silently label simulated data as live.
#   simulated | dhan
MARKET_DATA_FEED=simulated
MARKET_DATA_PROVIDER=simulated

# ticker | quote | full — richness of the subscription.
# Full carries depth and OI (162 bytes/tick); ticker is 16. Subscribe only
# actively-viewed instruments as full once the universe is large.
MARKET_DATA_FEED_MODE=full

# How often coalesced quotes are written to Postgres.
MARKET_DATA_FLUSH_MS=2000

# Simulator tick cadence.
MARKET_DATA_SIM_INTERVAL_MS=2000
# Emit ticks outside 09:15-15:30 IST. Off by default so the feed behaves like a
# real one — code that assumes ticks always arrive should fail in dev.
MARKET_DATA_SIM_EMIT_WHEN_CLOSED=false

# Set false for a maintenance window; the service boots without starting the feed.
INGESTION_ENABLED=true

# --- Dhan (not enabled yet) ---------------------------------------------------
# Blocked on the licensing question in DHAN-MARKET-DATA-INTEGRATION.md §3.1:
# whether a partner may serve exchange data to end users under one account.
# Individual access tokens expire every 24h; prefer API key/secret (12 months).
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
DHAN_FEED_URL=wss://api-feed.dhan.co
