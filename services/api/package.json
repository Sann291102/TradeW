{
  "name": "@tradew/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "npm run seed -w @tradew/database",
    "verify:paper-execution": "ts-node --transpile-only -P tsconfig.json scripts/verify-paper-execution.ts",
    "verify:kill-switch": "ts-node --transpile-only -P tsconfig.json scripts/verify-kill-switch.ts",
    "verify:learning": "ts-node --transpile-only -P tsconfig.json scripts/verify-learning-pipeline.ts",
    "verify:live-loop": "ts-node --transpile-only -P tsconfig.json scripts/verify-live-loop.ts",
    "verify:user-binding": "ts-node --transpile-only -P tsconfig.json scripts/verify-user-account-binding.ts",
    "prisma:generate": "prisma generate --schema ../../packages/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../../packages/database/prisma/schema.prisma",
    "verify:agent-lab": "ts-node --transpile-only -P tsconfig.json scripts/verify-agent-lab.ts",
    "verify:backtest": "ts-node --transpile-only -P tsconfig.json scripts/verify-backtest.ts",
    "verify:admin-routes": "ts-node --transpile-only -P tsconfig.json scripts/verify-admin-routes.ts",
    "agents:risk-bounds": "ts-node --transpile-only -P tsconfig.json scripts/set-agent-risk-bounds.ts",
    "verify:execution-path": "ts-node --transpile-only -P tsconfig.json scripts/verify-execution-path.ts",
    "//verify:autonomous-scan": "Proves India, BTC and Gold all reach the SAME decision layer through their own data source, against live data, with no Sentinel constructed. Reads only; the engine flag is set for that process alone and nothing is written to .env.",
    "verify:autonomous-scan": "ts-node --transpile-only -P tsconfig.json scripts/verify-autonomous-scan.ts",
    "//brain:report": "Read-only view of the autonomous brain's learning dataset: coverage, why it refused, whether the predictions paid, whether the refusals were right, and the Sentinel benchmark. Proposes nothing and writes nothing.",
    "brain:report": "ts-node --transpile-only -P tsconfig.json scripts/brain-report.ts",
    "//verify:autonomous-trading": "End-to-end proof of the autonomous PAPER trading feature against the running app: coverage, armed accounts, the trailing contract on the brief's own example, the live decision pipeline, contract selection and the premium 1:3 gate against the live chain, sizing, the paper order lifecycle, and the learning dataset.",
    "verify:autonomous-trading": "ts-node --transpile-only -P tsconfig.json scripts/verify-autonomous-trading.ts",
    "//verify:trade-lifecycle": "Opens ONE real paper trade through the real gates and proves the whole lifecycle: order, fill, position, sizing, idempotency, management and the ratchet. The setup is arranged; no gate is bypassed.",
    "verify:trade-lifecycle": "ts-node --transpile-only -P tsconfig.json scripts/verify-trade-lifecycle.ts",
    "session": "ts-node --transpile-only -P tsconfig.json scripts/session-view.ts",
    "verify:trade": "ts-node --transpile-only -P tsconfig.json scripts/verify-trade-provenance.ts",
    "watch:trades": "ts-node --transpile-only -P tsconfig.json scripts/watch-trades.ts"
  },
  "prisma": {
    "schema": "../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@tradew/ai-core": "*",
    "@tradew/database": "*",
    "@tradew/market-data": "*",
    "@tradew/strategy-core": "*",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
