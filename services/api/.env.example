DATABASE_URL=postgresql://tradew:tradew@localhost:5432/tradew
JWT_SECRET=dev-secret-change-me
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Paper Trading OMS (services/sim) ---
# The standalone Dhan live-feed bridge (services/market-data/scripts/live-feed-server.ts)
# — same real prices the dashboard/charts/option chain show. NOT services/market-data's
# NestJS ingestor (that writes Postgres Quote from a simulated feed by default).
DHAN_LIVE_URL=http://localhost:4600

# --- entitlements / ops ---
# static token guarding /entitlements/admin/* (leave unset to disable admin API)
ADMIN_API_TOKEN=

# --- Sentinel service (internal-only; never exposed publicly) ---
SENTINEL_SERVICE_URL=http://localhost:4010
# shared service-to-service secret; must match services/sentinel SERVICE_TOKEN
SENTINEL_SERVICE_TOKEN=dev-sentinel-token-change-me

# --- Knowledge Workspace (internal developer tool; reads TradeW/knowledge/) ---
# Absolute path to the vault; defaults to ../../knowledge relative to this service's cwd
KNOWLEDGE_ROOT=
# true = always on, false = always off, unset = on outside production only
KNOWLEDGE_WORKSPACE_ENABLED=

# --- Outbound email (services/api/src/mail) -----------------------------------
# Generic SMTP. With Gmail, SMTP_PASS must be an App Password (a normal account
# password will not authenticate once 2FA is on).
# LEAVE BLANK IN DEV: with no SMTP_HOST/USER/PASS the mailer logs the message
# instead of sending, and OTP endpoints return the code as `devCode` so the
# flows stay testable without credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TradeW <no-reply@tradew.local>
