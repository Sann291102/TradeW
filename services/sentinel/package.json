{
  "name": "@tradew/sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel AI — observation-only trading intelligence desk. Internal service, called exclusively by services/api. Never places, blocks, or delays orders.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "ontology:validate": "ts-node -T --project tsconfig.scripts.json scripts/validate-ontology.ts",
    "ontology:seed": "ts-node -T --project tsconfig.scripts.json scripts/seed-ontology.ts",
    "ontology:smoke": "ts-node -T --project tsconfig.scripts.json scripts/smoke-concept-graph.ts",
    "nim:smoke": "ts-node -T --project tsconfig.scripts.json scripts/smoke-nvidia-nim.ts",
    "backtest:ema": "ts-node -T --project tsconfig.scripts.json scripts/backtest-ema-cross.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@tradew/ai-core": "*",
    "@tradew/types": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@tradew/market-data": "*"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
