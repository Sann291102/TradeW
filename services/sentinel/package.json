{
  "name": "@tradew/sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel AI — observation-only trading intelligence desk. Internal service, called exclusively by services/api. Never places, blocks, or delays orders.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "ontology:validate": "ts-node -T --project tsconfig.scripts.json scripts/validate-ontology.ts",
    "ontology:seed": "ts-node -T --project tsconfig.scripts.json scripts/seed-ontology.ts",
    "ontology:smoke": "ts-node -T --project tsconfig.scripts.json scripts/smoke-concept-graph.ts",
    "nim:smoke": "ts-node -T --project tsconfig.scripts.json scripts/smoke-nvidia-nim.ts",
    "backtest:ema": "ts-node -T --project tsconfig.scripts.json scripts/backtest-ema-cross.ts",
    "learning:test": "ts-node -T --project tsconfig.scripts.json scripts/test-learning.ts",
    "learning:scan": "ts-node -T --project tsconfig.scripts.json scripts/scan-books.ts",
    "learning:preview": "ts-node -T --project tsconfig.scripts.json scripts/preview-chunks.ts",
    "reasoning:test": "ts-node -T --project tsconfig.scripts.json scripts/test-reasoning.ts",
    "advisor:test": "ts-node -T --project tsconfig.scripts.json scripts/test-strategy-advisor.ts",
    "verify:runtime": "ts-node -T --project tsconfig.scripts.json scripts/verify-runtime.ts",
    "learning-platform:test": "ts-node -T --project tsconfig.scripts.json scripts/test-learning-platform.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@tradew/ai-core": "*",
    "@tradew/types": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@tradew/market-data": "*"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
