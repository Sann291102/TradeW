# Sentinel — internal service (never exposed to the public internet)
PORT=4010
HOST=127.0.0.1

# shared secret; must match services/api SENTINEL_SERVICE_TOKEN
SERVICE_TOKEN=dev-sentinel-token-change-me

# same Postgres as services/api; Sentinel touches only the tables it owns
# (SentinelObservation) + the 'sentinel' memory namespace
DATABASE_URL=postgresql://tradew:tradew@localhost:5432/tradew

# --- AI providers (all optional; without keys Sentinel composes messages
#     deterministically from signals) ---
# preference order, comma-separated — config decides, never code
AI_LLM_ORDER=anthropic,nvidia-nim,openai,ollama
AI_EMBEDDING_ORDER=voyage,nvidia-nim,openai
AI_RESEARCH_ORDER=tavily,brave,anthropic-web-search,firecrawl

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
# NVIDIA NIM: hosted (integrate.api.nvidia.com) needs the API key; a
# self-hosted NIM (incl. a distilled student model) needs only the base URL
# Free key: https://build.nvidia.com -> any model -> "Get API Key" (nvapi-...)
# To run Sentinel entirely on the free tier, put nvidia-nim first in
# AI_LLM_ORDER / AI_EMBEDDING_ORDER above.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# retrieval embeddings (1024-dim); MemoryRecord.embedding is dimension-flexible
NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Per-tier model pinning (any tier left blank keeps the built-in default).
# Measured on the free tier 2026-07-23. Latency is NOT predicted by parameter
# count and the catalog never shows it — always time a model before pinning it.
#   meta/llama-3.1-8b-instruct              0.3-6.7s   tool calls OK
#   nvidia/llama-3.3-nemotron-super-49b-v1  1.5-15s    tool calls OK
#   google/diffusiongemma-26b-a4b-it        ~200-290s  reasoning; 504s sometimes
#   meta/llama-3.2-3b-instruct              AVOID — 2 of 4 prose calls timed out
#                                           at 90s; never answered a tool call
# 'fast' is the workhorse tier: every Sentinel agent, the orchestrator, the
# explain service, the brain and the news classifier all run on it.
NVIDIA_NIM_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_NIM_MODEL_BALANCED=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_NIM_MODEL_DEEP=google/diffusiongemma-26b-a4b-it
# reasoning gate for models that support it (diffusiongemma); llama models
# silently ignore it, so it is safe to leave on provider-wide. Thinking is
# billed out of max_tokens — short-budget calls get truncated answers.
NVIDIA_NIM_ENABLE_THINKING=true
NVIDIA_NIM_TOP_P=0.95
# must exceed the slowest model above or deep-tier calls abort mid-flight
NVIDIA_NIM_TIMEOUT_MS=300000
OLLAMA_BASE_URL=
