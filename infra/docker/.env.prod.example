# TradeW production environment — copy to repo-root .env.prod and fill in.
#   cp infra/docker/.env.prod.example .env.prod
# NEVER commit .env.prod. Rotate every secret below off these examples.

# --- Public domain (DNS A record must point at the VM's public IP) ---
DOMAIN=tradew.example.com
ACME_EMAIL=ops@example.com

# --- Postgres (self-hosted, pgvector) ---
POSTGRES_USER=tradew
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=tradew
# Both api and sentinel read this; host = the compose service name.
DATABASE_URL=postgresql://tradew:CHANGE_ME_strong_db_password@postgres:5432/tradew

# --- Auth / service secrets (MUST be changed off the examples) ---
JWT_SECRET=CHANGE_ME_long_random_string
# Must match on api (SENTINEL_SERVICE_TOKEN) and sentinel (SERVICE_TOKEN).
SERVICE_TOKEN=CHANGE_ME_shared_internal_token
SENTINEL_SERVICE_TOKEN=CHANGE_ME_shared_internal_token

# --- Frontend ---
# Same-origin; the browser calls /api/*, Caddy proxies to the API.
NEXT_PUBLIC_API_URL=/api
FRONTEND_URL=https://tradew.example.com
# The API's own public origin — used for the Google OAuth default redirect and
# email links. With Caddy same-origin routing this is the site behind /api.
API_PUBLIC_URL=https://tradew.example.com

# --- Admin operator console (docker-compose.admin.yml override, loopback-only) ---
# The shared secret the API's AdminGuard/AdminTokenGuard enforces AND the admin
# console signs its session with. Must be >=24 chars and NOT a vendor key
# (the boot-time secret guard rejects weak/placeholder/Anthropic-key values).
ADMIN_API_TOKEN=CHANGE_ME_long_random_admin_token

# --- Outbound email / OTP (services/api/src/mail) ---
# Real transactional email: login alerts, OTP, password-changed, payment
# receipts, EOD summary. Leave SMTP_* blank to log emails instead of sending.
# CAVEAT: Gmail rewrites From: unless MAIL_FROM is a verified alias — use the
# domain's own SMTP (Workspace/SES/Resend) to actually send as admin@tradew-setup.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TradeW · Setup <admin@tradew-setup.com>
SUPPORT_EMAIL=admin@tradew-setup.com

# --- Google Sign-In (services/api/src/auth/google-oauth.service.ts) ---
# Blank => /auth/google returns 503 and the button reports "not available".
# Redirect URI in Google Cloud must equal: ${API_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tradew.example.com/auth/google/callback

# --- Payments / Razorpay (services/api/src/payments) ---
# Blank => billingEnabled:false and checkout is disabled (nothing is charged).
# Point a Razorpay webhook (payment.captured, order.paid, payment.failed) at
# ${API_PUBLIC_URL}/api/payments/webhook and put its secret in WEBHOOK_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- End-of-day summary email (services/api/src/sim/eod-summary.service.ts) ---
# Off by default. true => email active paper-trading users a daily wrap-up after
# EOD_EMAIL_HOUR_IST (IST). Requires SMTP configured above.
EOD_EMAIL_ENABLED=false
EOD_EMAIL_HOUR_IST=16

# --- Knowledge Workspace (internal dev tool) ---
# Off in production by default. Set true ONLY if you deliberately want it live.
# As of 2026-08-04 it's served at /api/admin/knowledge/* behind the same
# AdminGuard double-gate (isAdmin JWT + ADMIN_API_TOKEN) as the rest of the
# admin portal — this flag alone no longer controls who can reach it, only
# whether the route exists at all.
KNOWLEDGE_WORKSPACE_ENABLED=false

# --- AI providers (all optional; Sentinel degrades without them) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
TAVILY_API_KEY=

# --- Container image refs (set by CI to the pushed registry tags) ---
IMAGE_WEB=ghcr.io/OWNER/tradew-web:latest
IMAGE_API=ghcr.io/OWNER/tradew-api:latest
IMAGE_SENTINEL=ghcr.io/OWNER/tradew-sentinel:latest
# Added 2026-08-04 alongside services/market-data/Dockerfile and its
# docker-compose.prod.yml entry (previously missing both).
IMAGE_MARKET_DATA=ghcr.io/OWNER/tradew-market-data:latest
# Operator console (only used with docker-compose.admin.yml).
IMAGE_ADMIN=ghcr.io/OWNER/tradew-admin:latest

# --- Backups (OCI Object Storage via rclone remote name) ---
BACKUP_RCLONE_REMOTE=oci-backups
BACKUP_BUCKET=tradew-db-backups
BACKUP_RETENTION_DAYS=14
