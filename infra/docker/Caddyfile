# Caddy — the single public entrypoint. Automatic HTTPS via Let's Encrypt
# (needs ports 80 + 443 reachable and DOMAIN's DNS A record pointing at the VM).
#
# Same-origin routing avoids CORS: the browser calls /api/* on the same host,
# Caddy strips the /api prefix and forwards to the API. The internal Sentinel
# service is intentionally NOT routed here — only the API reaches it.

{
	email {$ACME_EMAIL}
}

# www -> apex. Kept as a separate site block so the apex stays the single
# canonical origin: cookies set on the apex do not apply to www, so serving
# both as equals would let a user be logged in on one and not the other.
# Caddy provisions a cert for this name too, so it also needs a DNS A record.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Security headers are set by the applications themselves (services/api's
	# middleware in main.ts, apps/web's next.config.mjs) so that they are
	# identical in development and production and cannot be lost by swapping the
	# proxy. The two set here are the ones only the edge can know about.
	header {
		# Caddy terminates TLS, so this is the layer that can honestly promise
		# HTTPS for the whole origin.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# Never advertise the proxy version to the internet.
		-Server
	}

	# API — handle_path strips the /api prefix (browser /api/auth/login -> api /auth/login).
	handle_path /api/* {
		reverse_proxy api:4000 {
			# Server-Sent Events (the Knowledge Workspace live stream) need
			# unbuffered streaming; Caddy flushes immediately by default.
			flush_interval -1
		}
	}

	# Everything else -> the Next.js web app, INCLUDING /feed/*.
	#
	# The feed bridge is deliberately NOT routed directly here. It has no
	# authentication of its own, so the only thing standing between it and the
	# internet is apps/web's explicit route allowlist (feed-proxy-routes.mjs).
	# A `handle_path /feed/*` block at this layer would bypass that allowlist
	# and republish every route the bridge has — which is exactly the structural
	# defect the allowlist was introduced to fix. Leave this alone.
	handle {
		reverse_proxy web:3000
	}
}
