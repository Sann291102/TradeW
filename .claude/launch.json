{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 4000,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "sentinel",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:sentinel"],
      "port": 4010,
      "autoPort": false
    },
    {
      "name": "dhan-bridge",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "ts-node",
        "--project",
        "services/market-data/tsconfig.scripts.json",
        "services/market-data/scripts/live-feed-server.ts"
      ],
      "port": 4600,
      "autoPort": false
    }
  ]
}
