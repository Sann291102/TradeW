# services/api base URL this console talks to. Never exposed to the browser
# (no NEXT_PUBLIC_ prefix) — every call goes through a server-side Route
# Handler.
ADMIN_API_URL=http://localhost:4000

# The SAME shared secret services/api's AdminTokenGuard enforces
# (services/api/src/auth/admin-token.guard.ts). Must match exactly, or every
# admin sign-in attempt fails at the verification call. Server-side only; the
# browser never receives it — the proxy attaches it as x-admin-token per call.
ADMIN_API_TOKEN=

# Seals the operator session cookie (AES-256-GCM). The operator assertion is
# encrypted under this key and stored ONLY inside the httpOnly cookie as opaque
# ciphertext — so this is what keeps the assertion out of browser-accessible
# JavaScript. Must be >=32 chars; unset/short disables sign-in entirely (fails
# closed). Distinct from ADMIN_API_TOKEN on purpose: that secret travels the
# wire every request, this one only ever seals at-rest session state. Mint one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# apps/web's URL, for the "View as Trader" passthrough. Public because it is
# just a link target, not a credential.
NEXT_PUBLIC_TRADEW_WEB_URL=http://localhost:3000
