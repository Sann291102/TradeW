# services/api base URL this console talks to. Never exposed to the browser
# (no NEXT_PUBLIC_ prefix) — every call goes through a server-side Route
# Handler.
ADMIN_API_URL=http://localhost:4000

# The SAME shared secret services/api's AdminTokenGuard enforces
# (services/api/src/auth/admin-token.guard.ts). Must match exactly, or every
# admin sign-in attempt fails at the verification call.
ADMIN_API_TOKEN=

# apps/web's URL, for the "View as Trader" passthrough. Public because it is
# just a link target, not a credential.
NEXT_PUBLIC_TRADEW_WEB_URL=http://localhost:3000
