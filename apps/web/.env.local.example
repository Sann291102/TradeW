# Next.js can only read env files from this app's own directory, so this
# file (and the .env.local you copy it to) can't be replaced by the root
# .env.example — see that file's header comment for why. Keep these two
# values in sync with NEXT_PUBLIC_API_URL / NEXT_PUBLIC_DHAN_LIVE_URL in the
# root .env.example (consolidated 2026-08-04).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DHAN_LIVE_URL=http://localhost:4600

# Optional. The application's public origin, e.g. https://app.example.com (no
# trailing slash). Feeds `metadataBase`, the legal pages' canonical URLs, the
# robots.txt sitemap reference and sitemap.xml itself.
#
# LEFT UNSET DELIBERATELY: TradeW has no established public domain, and every
# `tradew.*` string in this repository is a test fixture or an illustrative
# hostname in a design document. With it unset, Next emits relative canonicals
# and the sitemap is empty — which is correct. A guessed value would tell every
# crawler that the canonical copy of each page lives on a host TradeW does not
# control. See docs/footer/FOOTER_RESEARCH_REPORT.md §1.
#
# Inlined at BUILD time, so it must be set for `next build`, not at runtime.
# NEXT_PUBLIC_SITE_URL=
