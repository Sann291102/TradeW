0:["y07uMnhZvjRDJDyCaG9hS",[[["",{"children":["(workspace)",{"children":["learning",{"children":["strategy",{"children":[["id","sebi-derivatives-framework","d"],{"children":["__PAGE__?{\"id\":\"sebi-derivatives-framework\"}",{}]}]}]}]}]},"$undefined","$undefined",true],["",{"children":["(workspace)",{"children":["learning",{"children":["strategy",{"children":[["id","sebi-derivatives-framework","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"mx-auto max-w-[820px] space-y-4 p-4","children":[["$","div",null,{"children":[["$","$L2",null,{"href":"/learning","className":"text-[11px] font-semibold text-teal hover:underline","children":"← All lessons"}],["$","div",null,{"className":"mt-2 flex flex-wrap items-center gap-2","children":[["$","h1",null,{"className":"text-lg font-bold text-text","children":"SEBI's Index Derivatives Framework"}],["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-bold leading-tight whitespace-nowrap bg-hover text-muted border border-border2 px-1.5 py-0 text-[9px]","children":"intermediate"}],false]}],["$","p",null,{"className":"mt-1 text-[12px] leading-relaxed text-muted","children":"The six measures SEBI introduced from October 2024 onward, what each one changed, and how they interact with short option positions."}]]}],false,["$","div",null,{"className":"rounded-card border px-[18px] py-4 transition-colors duration-panel ease-standard bg-card border-border shadow-card","children":[["$","div",null,{"className":"mb-3 flex items-center gap-2","children":["$undefined",["$","h2",null,{"className":"text-base font-semibold leading-tight","children":["Lesson",false]}],false]}],["$","div",null,{"className":"text-[12.5px] leading-relaxed text-muted [&_h1]:mb-2 [&_h1]:text-base [&_h1]:font-bold [&_h1]:text-text [&_h2]:mb-1.5 [&_h2]:mt-5 [&_h2]:text-[13px] [&_h2]:font-bold [&_h2]:text-text [&_h3]:mb-1 [&_h3]:mt-4 [&_h3]:text-[12px] [&_h3]:font-semibold [&_h3]:text-text [&_p]:mb-2.5 [&_strong]:font-semibold [&_strong]:text-text [&_ul]:mb-2.5 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mb-2.5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1 [&_code]:rounded [&_code]:bg-bg [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[11px] [&_code]:text-text [&_table]:mb-3 [&_table]:w-full [&_table]:text-left [&_table]:text-[11.5px] [&_th]:border-b [&_th]:border-border [&_th]:pb-1 [&_th]:pr-3 [&_th]:font-semibold [&_th]:text-text [&_td]:border-b [&_td]:border-border [&_td]:py-1 [&_td]:pr-3 [&_td]:align-top [&_a]:text-teal hover:[&_a]:underline [&_blockquote]:border-l-2 [&_blockquote]:border-border2 [&_blockquote]:pl-3 [&_blockquote]:italic","children":[["$","h1","h1-0",{"children":"SEBI's Index Derivatives Framework"}],"\n",["$","p","p-0",{"children":"Between October 2024 and April 2025, SEBI introduced a connected set of\r\nmeasures that reshaped index derivatives trading in India. They are usually\r\nlisted as six items. Understanding them as a set matters more than memorising\r\nthem individually, because they converge on the same target: short-dated short\r\noption positions held into expiry."}],"\n",["$","p","p-1",{"children":["$","em","em-0",{"children":"Verified 24 July 2026."}]}],"\n",["$","h2","h2-0",{"children":"The six measures"}],"\n",["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"Measure"}],["$","th","th-1",{"children":"Effective"}],["$","th","th-2",{"children":"What changed"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":"Upfront premium collection"}],["$","td","td-1",{"children":"Oct 2024"}],["$","td","td-2",{"children":"Option buyers pay the full premium at entry; no intraday leverage on purchases"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":"Contract size increase"}],["$","td","td-1",{"children":"Nov 2024"}],["$","td","td-2",{"children":"Minimum index contract value raised to ₹15–20 lakh from ₹5–10 lakh"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":"Weekly expiry rationalisation"}],["$","td","td-1",{"children":"Nov 2024"}],["$","td","td-2",{"children":"One weekly index per exchange — NIFTY on NSE, SENSEX on BSE"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":"Expiry-day extreme loss margin"}],["$","td","td-1",{"children":"Nov 2024"}],["$","td","td-2",{"children":"Additional 2% ELM on short option positions on expiry day"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":"Calendar-spread benefit withdrawn"}],["$","td","td-1",{"children":"Feb 2025"}],["$","td","td-2",{"children":"No margin offset across expiries on expiry day"}]]}],["$","tr","tr-5",{"children":[["$","td","td-0",{"children":"Intraday position-limit monitoring"}],["$","td","td-1",{"children":"Apr 2025"}],["$","td","td-2",{"children":"Limits checked at multiple points intraday, not only at close"}]]}]]}]]}],"\n",["$","h2","h2-1",{"children":"How they interact"}],"\n",["$","p","p-2",{"children":"Read individually, each looks like a modest administrative change. Read\r\ntogether, they describe a single position type being progressively constrained:\r\na short option, in a short-dated contract, held into expiry, sized against\r\nmargin rather than notional."}],"\n",["$","p","p-3",{"children":[["$","strong","strong-0",{"children":"Upfront premium collection"}]," removed the ability to fund option purchases\r\nintraday, which had allowed positions larger than the account could settle."]}],"\n",["$","p","p-4",{"children":[["$","strong","strong-0",{"children":"The contract-value floor"}]," raised the minimum notional exposure per lot. This\r\nis the measure most often misread as \"lot sizes went up\". What SEBI fixed is\r\nthe ",["$","em","em-0",{"children":"contract value"}]," band; lot size is the dependent variable, recalculated\r\nwhenever the index level drifts far enough that the notional leaves the band.\r\nThis is why NIFTY's lot size has been revised more than once and will be again.\r\nSee ",["$","code","code-0",{"children":"india-market-structure/contract-value-and-lot-size.md"}],"."]}],"\n",["$","p","p-5",{"children":[["$","strong","strong-0",{"children":"Weekly rationalisation"}]," removed four of NSE's five weekly indices, ending a\r\nstructure where an expiry fell on nearly every trading day."]}],"\n",["$","p","p-6",{"children":[["$","strong","strong-0",{"children":"The expiry-day ELM and the calendar-spread withdrawal"}]," both target the same\r\nsession. Gamma on expiry day is at its maximum, and both measures increase the\r\ncapital a short position must hold precisely then. The calendar-spread\r\nwithdrawal is the sharper of the two: a position that was margin-offset by a\r\nlonger-dated hedge loses that relief on the day the hedge is least effective,\r\nbecause a far-dated option does not respond to a near-dated gamma event."]}],"\n",["$","p","p-7",{"children":[["$","strong","strong-0",{"children":"Intraday monitoring"}]," closed the gap between real intraday exposure and\r\nend-of-day reported exposure."]}],"\n",["$","h2","h2-2",{"children":"What this means for position sizing"}],"\n",["$","p","p-8",{"children":"The framework's implicit message is that margin is not a measure of risk."}],"\n",["$","p","p-9",{"children":"A short option position's margin can be a small fraction of its notional\r\nexposure. SEBI's response was to raise the notional floor, add margin\r\nspecifically where risk concentrates, and remove offsets that understated it.\r\nSizing a book against blocked margin rather than against contract value\r\nproduces a position that satisfies every rule and still cannot absorb a tail\r\nmove."}],"\n",["$","p","p-10",{"children":[["$","code","code-0",{"children":"risk/position-sizing.md"}]," covers the arithmetic."]}],"\n",["$","h2","h2-3",{"children":"What it does not do"}],"\n",["$","p","p-11",{"children":"None of these measures caps loss on a short option. A naked short call retains\r\nunbounded loss; a short strangle retains unbounded loss on both sides. The\r\nframework raises the capital required to hold such positions and reduces the\r\nleverage available, but the payoff shape is unchanged."}],"\n",["$","p","p-12",{"children":"Defined-risk structures — spreads, condors, butterflies — bound the loss\r\nstructurally rather than by regulation, and receive materially lower margin as\r\na result. That margin differential is the mechanism by which the framework\r\npushes activity toward bounded structures."}],"\n",["$","h2","h2-4",{"children":"Related"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"children":"india-market-structure/expiry-architecture.md"}]," — the schedule these rules produced"]}],"\n",["$","li","li-1",{"children":[["$","code","code-0",{"children":"india-market-structure/margins.md"}]," — SPAN, exposure and ELM in detail"]}],"\n",["$","li","li-2",{"children":[["$","code","code-0",{"children":"india-market-structure/contract-value-and-lot-size.md"}]," — why lot sizes keep changing"]}],"\n",["$","li","li-3",{"children":[["$","code","code-0",{"children":"strategies/volatility/short-strangle.md"}]," — the position most affected"]}],"\n"]}]]}]]}],["$","p",null,{"className":"text-[10px] leading-relaxed text-faint","children":["Educational material describing how a structure behaves. Not a recommendation, not a signal, and not personalised advice. Source: ",["$","code",null,{"className":"font-mono","children":"docs/learning/india-market-structure/sebi-derivatives-framework.md"}]]}]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","$L6",null,{"children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":"404"}],["$","div",null,{"style":{"display":"inline-blo