lex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Outlook it expresses"}],["$","dd",null,{"className":"text-text","children":"bearish"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Opens with"}],["$","dd",null,{"className":"text-text","children":"a debit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Best case"}],["$","dd",null,{"className":"text-text","children":"Strike minus premium, reached if the underlying goes to zero"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Worst case"}],["$","dd",null,{"className":"text-text","children":"The premium paid"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Breakeven"}],["$","dd",null,{"className":"text-text","children":"Strike minus premium paid"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Exposures"}],["$","dd",null,{"className":"text-text","children":"delta negative · gamma positive · theta negative · vega positive"}]]}]]}]]}],["$","div",null,{"className":"rounded-card border px-[18px] py-4 transition-colors duration-panel ease-standard bg-card border-border shadow-card","children":[["$","div",null,{"className":"mb-3 flex items-center gap-2","children":["$undefined",["$","h2",null,{"className":"text-base font-semibold leading-tight","children":["Lesson",false]}],false]}],["$","div",null,{"className":"text-[12.5px] leading-relaxed text-muted [&_h1]:mb-2 [&_h1]:text-base [&_h1]:font-bold [&_h1]:text-text [&_h2]:mb-1.5 [&_h2]:mt-5 [&_h2]:text-[13px] [&_h2]:font-bold [&_h2]:text-text [&_h3]:mb-1 [&_h3]:mt-4 [&_h3]:text-[12px] [&_h3]:font-semibold [&_h3]:text-text [&_p]:mb-2.5 [&_strong]:font-semibold [&_strong]:text-text [&_ul]:mb-2.5 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mb-2.5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1 [&_code]:rounded [&_code]:bg-bg [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[11px] [&_code]:text-text [&_table]:mb-3 [&_table]:w-full [&_table]:text-left [&_table]:text-[11.5px] [&_th]:border-b [&_th]:border-border [&_th]:pb-1 [&_th]:pr-3 [&_th]:font-semibold [&_th]:text-text [&_td]:border-b [&_td]:border-border [&_td]:py-1 [&_td]:pr-3 [&_td]:align-top [&_a]:text-teal hover:[&_a]:underline [&_blockquote]:border-l-2 [&_blockquote]:border-border2 [&_blockquote]:pl-3 [&_blockquote]:italic","children":[["$","h1","h1-0",{"children":"Long Put"}],"\n",["$","p","p-0",{"children":"A long put is one bought put option — the bearish mirror of the long call, with\r\none asymmetry that matters."}],"\n",["$","h2","h2-0",{"children":"The structure"}],"\n",["$","p","p-1",{"children":"One leg: a long put, usually at or near the money, in the near expiry. Premium\r\nis paid upfront in full."}],"\n",["$","h2","h2-1",{"children":"What it is exposed to"}],"\n",["$","p","p-2",{"children":[["$","strong","strong-0",{"children":"Direction (delta)."}]," Negative. An at-the-money put has a delta near −0.5,\r\ngaining roughly ₹0.50 per ₹1 the underlying falls, with delta moving toward\r\n−1.00 as it goes deeper in the money."]}],"\n",["$","p","p-3",{"children":[["$","strong","strong-0",{"children":"Acceleration (gamma)."}]," Positive, peaking at the money and rising into\r\nexpiry, exactly as for a call."]}],"\n",["$","p","p-4",{"children":[["$","strong","strong-0",{"children":"Time (theta)."}]," Negative. Extrinsic value bleeds away daily."]}],"\n",["$","p","p-5",{"children":[["$","strong","strong-0",{"children":"Volatility (vega)."}]," Positive. A long put gains if implied volatility rises."]}],"\n",["$","p","p-6",{"children":"This last exposure is where puts differ from calls in practice. Equity index\r\nimplied volatility is persistently skewed — downside strikes trade at higher\r\nimplied volatility than equivalent upside strikes, because demand for downside\r\nprotection is structural rather than speculative. Two consequences follow. A\r\nput is generally more expensive than the equidistant call. And falling markets\r\ntend to raise implied volatility, so a long put often gains on both delta and\r\nvega at once, which is why puts are convex in a way calls are not."}],"\n",["$","h2","h2-2",{"children":"Payoff"}],"\n",["$","p","p-7",{"children":"Above the strike at expiry, the put expires worthless and the premium is lost.\r\nBelow the strike, intrinsic value accrues as the underlying falls. Breakeven at\r\nexpiry is strike minus premium paid."}],"\n",["$","p","p-8",{"children":"Maximum gain is bounded, unlike a long call: an underlying cannot fall below\r\nzero, so the most a put can be worth is the strike itself, less the premium\r\npaid. In practice this bound is theoretical for an index."}],"\n",["$","h2","h2-3",{"children":"Indian market specifics"}],"\n",["$","p","p-9",{"children":[["$","strong","strong-0",{"children":"Skew makes entry cost asymmetric."}]," Because index puts carry a volatility\r\npremium, a long put bought in calm conditions is paying for that skew. The same\r\nput bought after a fall is paying an even larger one, since implied volatility\r\nhas already risen — buying protection after the move is materially more\r\nexpensive than before it."]}],"\n",["$","p","p-10",{"children":[["$","strong","strong-0",{"children":"India VIX"}]," is computed from NIFTY option prices and is the standard\r\nreference for whether index implied volatility is historically high or low.\r\nA long put entered when VIX is depressed has a very different vega profile\r\nfrom one entered when it is elevated."]}],"\n",["$","p","p-11",{"children":[["$","strong","strong-0",{"children":"Cost and settlement."}]," No STT on purchase. STT of 0.15% of intrinsic value\r\non exercise. A stock put finishing in the money obliges ",["$","em","em-0",{"children":"delivery"}]," of shares\r\non E+2 — the holder must have the stock or buy it. Index puts are cash\r\nsettled."]}],"\n",["$","p","p-12",{"children":[["$","strong","strong-0",{"children":"Expiry cadence."}]," NIFTY weeklies expire Tuesday; BANKNIFTY and the other\r\nindices are monthly-only, last Tuesday. SENSEX weeklies expire Thursday on BSE."]}],"\n",["$","h2","h2-4",{"children":"How it typically fails"}],"\n",["$","p","p-13",{"children":"Holding a long put through a drift-upward market is the common loss: theta and\r\nfalling volatility compound, and the position bleeds on two exposures at once\r\neven when the underlying barely moves. The second pattern is buying puts as\r\ninsurance during a panic, when skew and VIX have already repriced, and then\r\nwatching volatility normalise faster than the underlying falls."}],"\n",["$","h2","h2-5",{"children":"Related"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"children":"strategies/vertical-spreads/bear-put-spread.md"}]," — same view, cheaper, capped"]}],"\n",["$","li","li-1",{"children":[["$","code","code-0",{"children":"strategies/directional/protective-put.md"}]," — the same leg used as a hedge\r\nagainst held stock rather than as a directional position"]}],"\n",["$","li","li-2",{"children":[["$","code","code-0",{"children":"volatility/smile-and-skew.md"}]," — why puts cost what they cost"]}],"\n"]}]]}]]}],["$","p",null,{"className":"text-[10px] leading-relaxed text-faint","children":["Educational material describing how a structure behaves. Not a recommendation, not a signal, and not personalised advice. Source: ",["$","code",null,{"className":"font-mono","children":"docs/learning/strategies/directional/long-put.md"}]]}]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children","$4","children"],"error":"$undefined",