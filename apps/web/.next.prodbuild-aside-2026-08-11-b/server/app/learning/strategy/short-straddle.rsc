-2","children":[["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Outlook it expresses"}],["$","dd",null,{"className":"text-text","children":"direction-neutral, expecting little movement"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Opens with"}],["$","dd",null,{"className":"text-text","children":"a credit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Best case"}],["$","dd",null,{"className":"text-text","children":"Total premium received, if the underlying settles exactly at the strike"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Worst case"}],["$","dd",null,{"className":"text-text","children":"Unlimited on the upside, very large on the downside"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Breakeven"}],["$","dd",null,{"className":"text-text","children":"Strike plus total premium, and strike minus total premium"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Exposures"}],["$","dd",null,{"className":"text-text","children":"delta neutral · gamma negative · theta positive · vega negative"}]]}]]}]]}],["$","div",null,{"className":"rounded-card border px-[18px] py-4 transition-colors duration-panel ease-standard bg-card border-border shadow-card","children":[["$","div",null,{"className":"mb-3 flex items-center gap-2","children":["$undefined",["$","h2",null,{"className":"text-base font-semibold leading-tight","children":["Lesson",false]}],false]}],["$","div",null,{"className":"text-[12.5px] leading-relaxed text-muted [&_h1]:mb-2 [&_h1]:text-base [&_h1]:font-bold [&_h1]:text-text [&_h2]:mb-1.5 [&_h2]:mt-5 [&_h2]:text-[13px] [&_h2]:font-bold [&_h2]:text-text [&_h3]:mb-1 [&_h3]:mt-4 [&_h3]:text-[12px] [&_h3]:font-semibold [&_h3]:text-text [&_p]:mb-2.5 [&_strong]:font-semibold [&_strong]:text-text [&_ul]:mb-2.5 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mb-2.5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1 [&_code]:rounded [&_code]:bg-bg [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[11px] [&_code]:text-text [&_table]:mb-3 [&_table]:w-full [&_table]:text-left [&_table]:text-[11.5px] [&_th]:border-b [&_th]:border-border [&_th]:pb-1 [&_th]:pr-3 [&_th]:font-semibold [&_th]:text-text [&_td]:border-b [&_td]:border-border [&_td]:py-1 [&_td]:pr-3 [&_td]:align-top [&_a]:text-teal hover:[&_a]:underline [&_blockquote]:border-l-2 [&_blockquote]:border-border2 [&_blockquote]:pl-3 [&_blockquote]:italic","children":[["$","h1","h1-0",{"children":"Short Straddle"}],"\n",["$","p","p-0",{"children":"A short call and a short put at the same strike, same expiry. The mirror of the long\r\nstraddle, and the structure with the most concentrated risk profile in common\r\nretail use in the Indian market."}],"\n",["$","h2","h2-0",{"children":"The structure"}],"\n",["$","p","p-1",{"children":"Two short legs at one strike, usually at the money. Premium from both is\r\ncredited at entry. Margin is blocked on both."}],"\n",["$","p","p-2",{"children":"Delta is near zero at entry. The position is short movement."}],"\n",["$","h2","h2-1",{"children":"What it is exposed to"}],"\n",["$","p","p-3",{"children":[["$","strong","strong-0",{"children":"Theta"}]," strongly positive, collected on two at-the-money legs — the largest\r\ntheta available from any two-leg structure. This is the attraction."]}],"\n",["$","p","p-4",{"children":[["$","strong","strong-0",{"children":"Gamma"}]," strongly negative, and this is the entire risk. The position acquires\r\ndelta ",["$","em","em-0",{"children":"against"}]," the direction of movement: it becomes short as the underlying\r\nrises and long as it falls. Every point of movement makes the next point more\r\nexpensive. Gamma magnitude peaks at the money and rises steeply into expiry,\r\nso the position is most dangerous exactly where and when it earns the most\r\ntheta."]}],"\n",["$","p","p-5",{"children":"There is no way to separate these. The theta is compensation for the gamma."}],"\n",["$","p","p-6",{"children":[["$","strong","strong-0",{"children":"Vega"}]," strongly negative. A volatility expansion damages the position\r\nindependently of direction."]}],"\n",["$","h2","h2-2",{"children":"Payoff"}],"\n",["$","p","p-7",{"children":"Maximum profit is the full premium, achieved only if the underlying settles\r\nexactly at the strike. Losses accrue in both directions beyond strike ± total\r\npremium — unbounded above, bounded only by zero below."}],"\n",["$","p","p-8",{"children":"The distribution is extreme: a high probability of a moderate gain against a\r\nlow probability of a loss with no defined ceiling. This is the payoff shape\r\nthat win-rate statistics describe worst."}],"\n",["$","h2","h2-3",{"children":"Indian market specifics"}],"\n",["$","p","p-9",{"children":"This structure interacts with Indian market rules more than any other in this\r\nfolder, and every interaction runs the same direction."}],"\n",["$","p","p-10",{"children":[["$","strong","strong-0",{"children":"Expiry-day margin."}]," An additional 2% extreme loss margin on short option\r\npositions applies on expiry day, in force since November 2024 — precisely when\r\na short straddle's gamma is at its maximum."]}],"\n",["$","p","p-11",{"children":[["$","strong","strong-0",{"children":"Calendar-spread benefit withdrawn."}]," From February 2025, margin offset from\r\npositions in other expiries is not available on expiry day. A short straddle\r\npartially hedged by longer-dated longs loses that margin relief on the day it\r\nis most needed."]}],"\n",["$","p","p-12",{"children":[["$","strong","strong-0",{"children":"Intraday position monitoring."}]," Since April 2025 position limits are checked\r\nat multiple points during the day rather than at close, so an intraday\r\nexpansion cannot be quietly netted out before the snapshot."]}],"\n",["$","p","p-13",{"children":[["$","strong","strong-0",{"children":"Gap risk."}]," The position is held overnight against global cues, results and\r\npolicy. A gap opens beyond the breakeven with no opportunity to exit in\r\nbetween. No stop-loss executes across a gap."]}],"\n",["$","p","p-14",{"children":[["$","strong","strong-0",{"children":"Physical settlement."}]," On a stock straddle, whichever leg finishes in the\r\nmoney is assigned, producing a delivery or receipt obligation for the full\r\ncontract value on E+2 — a cash requirement unrelated to the margin the position\r\nwas sized against."]}],"\n",["$","p","p-15",{"children":[["$","strong","strong-0",{"children":"Weekly concentration."}]," Since only NIFTY carries an NSE weekly, short-dated\r\nstraddle flow concentrates there, which is also where gamma is sharpest."]}],"\n",["$","h2","h2-4",{"children":"How it typically fails"}],"\n",["$","p","p-16",{"children":"It works, repeatedly, and that is the mechanism of failure. A short straddle\r\nretains premium in most expiries, which builds a track record that justifies\r\nlarger size, which is then in place when a gap or a volatility expansion\r\narrives. The loss is not proportional to the gains that preceded it and is not\r\nbounded by them."}],"\n",["$","p","p-17",{"children":"Every element of SEBI's post-2024 derivatives framework — the margin additions,\r\nthe expiry-day treatment, the contract-value floor — is a response to the\r\naggregate of these positions, which is itself informative about the risk\r\nprofile."}],"\n",["$","h2","h2-5",{"children":"Related"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"children":"strategies/volatility/iron-butterfly.md"}]," — the same structure with wings\r\nbought, converting unbounded loss to a defined one"]}],"\n",["$","li","li-1",{"children":[["$","code","code-0",{"children":"strategies/volatility/short-strangle.md"}]," — wider strikes, less theta, more room"]}],"\n",["$","li","li-2",{"children":[["$","code","code-0",{"children":"greeks/gamma.md"}]," — why the loss accelerates"]}],"\n",["$","li","li-3",{"children":[["$","code","code-0",{"children":"risk/tail-risk.md"}]," — why win rate does not describe this"]}],"\n"]}]]}]]}],["$","p",null,{"className":"text-[10px] leading-relaxed text-faint","children":["Educational material describing how a structure behaves. Not a recommendation, not a signal, and not personalised advice. Source: ",["$","code",null,{"className":"font-mono","children":"docs/learning/strategies/volatility/short-straddle.md"}]]}]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","$L6",null,{"children":["$","$L3",null,{"parall