0:["y07uMnhZvjRDJDyCaG9hS",[[["",{"children":["(workspace)",{"children":["learning",{"children":["strategy",{"children":[["id","bull-put-spread","d"],{"children":["__PAGE__?{\"id\":\"bull-put-spread\"}",{}]}]}]}]}]},"$undefined","$undefined",true],["",{"children":["(workspace)",{"children":["learning",{"children":["strategy",{"children":[["id","bull-put-spread","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"mx-auto max-w-[820px] space-y-4 p-4","children":[["$","div",null,{"children":[["$","$L2",null,{"href":"/learning","className":"text-[11px] font-semibold text-teal hover:underline","children":"← All lessons"}],["$","div",null,{"className":"mt-2 flex flex-wrap items-center gap-2","children":[["$","h1",null,{"className":"text-lg font-bold text-text","children":"Bull Put Spread"}],["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-bold leading-tight whitespace-nowrap bg-hover text-muted border border-border2 px-1.5 py-0 text-[9px]","children":"intermediate"}],["$","span",null,{"className":"inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-bold leading-tight whitespace-nowrap bg-hover text-muted border border-border2 px-1.5 py-0 text-[9px]","children":[2," ","legs"]}]]}],["$","p",null,{"className":"mt-1 text-[12px] leading-relaxed text-muted","children":"A short put with a long put below it in the same expiry. Premium is received upfront and the long leg caps the loss at the spread width."}]]}],["$","div",null,{"className":"rounded-card border px-[18px] py-4 transition-colors duration-panel ease-standard bg-card border-border shadow-card","children":[["$","div",null,{"className":"mb-3 flex items-center gap-2","children":["$undefined",["$","h2",null,{"className":"text-base font-semibold leading-tight","children":["At a glance",false]}],false]}],["$","dl",null,{"className":"grid grid-cols-1 gap-x-6 gap-y-1.5 text-[11.5px] sm:grid-cols-2","children":[["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Outlook it expresses"}],["$","dd",null,{"className":"text-text","children":"neutral-to-bullish"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Opens with"}],["$","dd",null,{"className":"text-text","children":"a credit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Best case"}],["$","dd",null,{"className":"text-text","children":"Net credit received"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Worst case"}],["$","dd",null,{"className":"text-text","children":"Spread width minus net credit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Breakeven"}],["$","dd",null,{"className":"text-text","children":"Higher strike minus net credit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Exposures"}],["$","dd",null,{"className":"text-text","children":"delta positive · gamma mixed · theta positive · vega negative"}]]}]]}]]}],["$","div",null,{"className":"rounded-card border px-[18px] py-4 transition-colors duration-panel ease-standard bg-card border-border shadow-card","children":[["$","div",null,{"className":"mb-3 flex items-center gap-2","children":["$undefined",["$","h2",null,{"className":"text-base font-semibold leading-tight","children":["Lesson",false]}],false]}],["$","div",null,{"className":"text-[12.5px] leading-relaxed text-muted [&_h1]:mb-2 [&_h1]:text-base [&_h1]:font-bold [&_h1]:text-text [&_h2]:mb-1.5 [&_h2]:mt-5 [&_h2]:text-[13px] [&_h2]:font-bold [&_h2]:text-text [&_h3]:mb-1 [&_h3]:mt-4 [&_h3]:text-[12px] [&_h3]:font-semibold [&_h3]:text-text [&_p]:mb-2.5 [&_strong]:font-semibold [&_strong]:text-text [&_ul]:mb-2.5 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mb-2.5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1 [&_code]:rounded [&_code]:bg-bg [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[11px] [&_code]:text-text [&_table]:mb-3 [&_table]:w-full [&_table]:text-left [&_table]:text-[11.5px] [&_th]:border-b [&_th]:border-border [&_th]:pb-1 [&_th]:pr-3 [&_th]:font-semibold [&_th]:text-text [&_td]:border-b [&_td]:border-border [&_td]:py-1 [&_td]:pr-3 [&_td]:align-top [&_a]:text-teal hover:[&_a]:underline [&_blockquote]:border-l-2 [&_blockquote]:border-border2 [&_blockquote]:pl-3 [&_blockquote]:italic","children":[["$","h1","h1-0",{"children":"Bull Put Spread"}],"\n",["$","p","p-0",{"children":"Two legs in the same expiry: a sold put and a bought put at a lower strike.\r\nAlso called a put credit spread. The same directional view as a bull call\r\nspread, expressed for a credit rather than a debit."}],"\n",["$","h2","h2-0",{"children":"The structure"}],"\n",["$","p","p-1",{"children":"The higher strike is the short leg, the lower strike the long leg. Net credit, since the higher put\r\nis worth more."}],"\n",["$","p","p-2",{"children":"The long leg is not there to make money. It is there to convert an unbounded\r\nobligation into a defined one, and to collapse the margin requirement. Both\r\neffects are the reason this structure, rather than the naked short put,\r\ndominates retail premium selling in India."}],"\n",["$","h2","h2-1",{"children":"What it is exposed to"}],"\n",["$","p","p-3",{"children":[["$","strong","strong-0",{"children":"Delta"}]," positive but modest."]}],"\n",["$","p","p-4",{"children":[["$","strong","strong-0",{"children":"Theta"}]," positive — the position's primary source of return. Both legs decay,\r\nbut the short leg is nearer the money and therefore carries more extrinsic\r\nvalue to lose, so the net is favourable."]}],"\n",["$","p","p-5",{"children":[["$","strong","strong-0",{"children":"Gamma"}]," negative in the region that matters. As the underlying approaches the\r\nshort strike, the position's delta deteriorates at an accelerating rate. Gamma\r\nmagnitude rises into expiry, which is why a credit spread that is safely out of\r\nthe money with a week to run can become the account's dominant exposure within\r\ntwo sessions."]}],"\n",["$","p","p-6",{"children":[["$","strong","strong-0",{"children":"Vega"}]," negative. Rising implied volatility widens both legs, and the short\r\nleg widens more."]}],"\n",["$","p","p-7",{"children":"The correlation problem from the naked short put persists here in reduced form:\r\nfalling markets raise implied volatility, so delta and vega deteriorate\r\ntogether. The long leg bounds how bad this gets, but does not prevent the\r\nmark-to-market from moving faster than the underlying alone implies."}],"\n",["$","h2","h2-2",{"children":"Payoff"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"At or above the higher strike at expiry: both expire worthless, full credit retained."}],"\n",["$","li","li-1",{"children":"Between the strikes: the short put is in the money, the long is not; loss accrues."}],"\n",["$","li","li-2",{"children":"At or below the lower strike: both in the money, loss fixed at spread width minus credit."}],"\n"]}],"\n",["$","p","p-8",{"children":"Maximum profit is the net credit. Maximum loss is the spread width minus the\r\ncredit. Breakeven is the higher strike minus the credit."}],"\n",["$","h2","h2-3",{"children":"The risk-reward is inverted, and that is the point"}],"\n",["$","p","p-9",{"children":["A credit spread typically risks several rupees to make one. A spread collecting\r\n30% of its width risks 70 to make 30. This is not a defect — it is the\r\ncompensation structure for a position that wins most of the time. Expectancy\r\ndepends on whether the win rate exceeds the ratio the payoff demands, not on\r\nwhether the ratio looks attractive. See ",["$","code","code-0",{"children":"risk/expectancy.md"}],"."]}],"\n",["$","p","p-10",{"children":"Reading the credit as \"income\" and the loss as an aberration is the single most\r\ncommon misreading of this structure."}],"\n",["$","h2","h2-4",{"children":"Indian market specifics"}],"\n",["$","p","p-11",{"children":[["$","strong","strong-0",{"children":"Skew helps the entry."}]," Selling the higher put and buying the lower one means\r\nselling the cheaper implied volatility and buying the more expensive — the\r\nopposite of the bear put spread's skew capture. The credit received is\r\ntherefore smaller than a symmetric-volatility model would suggest. This is\r\nmechanical, not a mispricing."]}],"\n",["$","p","p-12",{"children":[["$","strong","strong-0",{"children":"Margin."}]," Recognised as hedged, so margin is far below the naked short put.\r\nThe 2% expiry-day extreme loss margin on short options still applies to the\r\nshort leg."]}],"\n",["$","p","p-13",{"children":[["$","strong","strong-0",{"children":"Physical settlement."}]," On a stock spread settling between the strikes, the\r\nshort put is assigned and the long expires worthless — obliging the trader to\r\n",["$","em","em-0",{"children":"take"}]," delivery of the full contract value on E+2. The long leg caps the\r\neconomic loss but does not remove the settlement obligation. This is the\r\nmechanism by which a defined-risk position produces an undefined cash\r\nrequirement, and it is specific to stock contracts. Index spreads settle in\r\ncash."]}],"\n",["$","p","p-14",{"children":[["$","strong","strong-0",{"children":"Expiry cadence."}]," NIFTY weeklies on Tuesday give the most frequent cycle;\r\nBANKNIFTY is monthly-only since the November 2024 rationalisation, so a\r\nBANKNIFTY credit spread carries a full month of gamma exposure rather than a\r\nweek."]}],"\n",["$","h2","h2-5",{"children":"How it typically fails"}],"\n",["$","p","p-15",{"children":"Consistently, until it does not. A run of expiries in which the credit is kept\r\nin full establishes a base rate that the payoff does not support, and size\r\ngrows to match the apparent reliability. The loss arrives compressed into one\r\nor two sessions, at the full spread width, on a position sized for the win\r\nrate rather than the loss."}],"\n",["$","h2","h2-6",{"children":"Related"}],"\n",["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"children":"strategies/directional/short-put.md"}]," — the same short leg, unbounded"]}],"\n",["$","li","li-1",{"children":[["$","code","code-0",{"children":"strategies/vertical-spreads/bull-call-spread.md"}]," — same view, debit"]}],"\n",["$","li","li-2",{"children":[["$","code","code-0",{"children":"strategies/volatility/iron-condor.md"}]," — this spread plus its call-side mirror"]}],"\n"]}]]}]]}],["$","p",null,{"className":"text-[10px] leading-relaxed text-faint","children":["Educational material describing how a structure behaves. Not a recommendation, not a signal, and not personalised advice. Source: ",["$","code",null,{"className":"font-mono","children":"docs/learning/strategies/vertical-spreads/bull-put-spread.md"}]]}]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["c