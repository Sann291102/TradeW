,"div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Outlook it expresses"}],["$","dd",null,{"className":"text-text","children":"direction-neutral, expecting little movement"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Opens with"}],["$","dd",null,{"className":"text-text","children":"a credit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Best case"}],["$","dd",null,{"className":"text-text","children":"Net credit received, anywhere between the short strikes"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Worst case"}],["$","dd",null,{"className":"text-text","children":"Wing width minus net credit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Breakeven"}],["$","dd",null,{"className":"text-text","children":"Short put strike minus credit, and short call strike plus credit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Exposures"}],["$","dd",null,{"className":"text-text","children":"delta neutral · gamma negative · theta positive · vega negative"}]]}]]}]]}],["$","div",null,{"className":"rounded-card border px-[18px] py-4 transition-colors duration-panel ease-standard bg-card border-border shadow-card","children":[["$","div",null,{"className":"mb-3 flex items-center gap-2","children":["$undefined",["$","h2",null,{"className":"text-base font-semibold leading-tight","children":["Lesson",false]}],false]}],["$","div",null,{"className":"text-[12.5px] leading-relaxed text-muted [&_h1]:mb-2 [&_h1]:text-base [&_h1]:font-bold [&_h1]:text-text [&_h2]:mb-1.5 [&_h2]:mt-5 [&_h2]:text-[13px] [&_h2]:font-bold [&_h2]:text-text [&_h3]:mb-1 [&_h3]:mt-4 [&_h3]:text-[12px] [&_h3]:font-semibold [&_h3]:text-text [&_p]:mb-2.5 [&_strong]:font-semibold [&_strong]:text-text [&_ul]:mb-2.5 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mb-2.5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1 [&_code]:rounded [&_code]:bg-bg [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[11px] [&_code]:text-text [&_table]:mb-3 [&_table]:w-full [&_table]:text-left [&_table]:text-[11.5px] [&_th]:border-b [&_th]:border-border [&_th]:pb-1 [&_th]:pr-3 [&_th]:font-semibold [&_th]:text-text [&_td]:border-b [&_td]:border-border [&_td]:py-1 [&_td]:pr-3 [&_td]:align-top [&_a]:text-teal hover:[&_a]:underline [&_blockquote]:border-l-2 [&_blockquote]:border-border2 [&_blockquote]:pl-3 [&_blockquote]:italic","children":[["$","h1","h1-0",{"children":"Iron Condor"}],"\n",["$","p","p-0",{"children":"Four legs, one expiry: a bull put spread below the market and a bear call\r\nspread above it. Equivalently, a short strangle with protective wings."}],"\n",["$","h2","h2-0",{"children":"The structure"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"A long put, far out of the money"}],"\n",["$","li","li-1",{"children":"A short put, nearer the money"}],"\n",["$","li","li-2",{"children":"A short call, nearer the money"}],"\n",["$","li","li-3",{"children":"A long call, far out of the money"}],"\n"]}],"\n",["$","p","p-1",{"children":"Net credit. The two bought wings cost less than the two sold inner legs bring\r\nin, since they are further from the money."}],"\n",["$","p","p-2",{"children":"The two wings are insurance, not profit centres. They exist to bound the loss\r\nand to collapse the margin requirement."}],"\n",["$","h2","h2-1",{"children":"What it is exposed to"}],"\n",["$","p","p-3",{"children":[["$","strong","strong-0",{"children":"Theta"}]," positive, from the two short legs, partially given back to the two\r\nlong legs. Net theta is lower than a comparable short strangle's."]}],"\n",["$","p","p-4",{"children":[["$","strong","strong-0",{"children":"Gamma"}]," negative near the short strikes, but bounded — as the underlying\r\nmoves past a short strike toward the corresponding wing, the long leg's\r\npositive gamma progressively offsets the short leg's negative gamma. Beyond\r\nthe wing, the position's delta is flat. This is the structural difference from\r\na strangle, where delta deterioration never stops."]}],"\n",["$","p","p-5",{"children":[["$","strong","strong-0",{"children":"Vega"}]," negative but bounded, for the same reason."]}],"\n",["$","h2","h2-2",{"children":"Payoff"}],"\n",["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"Between the short strikes: both spreads expire worthless, full credit retained."}],"\n",["$","li","li-1",{"children":"Between a short strike and its wing: that spread is partially in the money, loss accrues."}],"\n",["$","li","li-2",{"children":"Beyond a wing: loss fixed at wing width minus net credit."}],"\n"]}],"\n",["$","p","p-6",{"children":"Maximum profit is the net credit, realised across the whole range between the\r\nshort strikes. Maximum loss is the width of one wing minus the credit — only\r\none side can lose, since the underlying cannot finish both above the call\r\nstrike and below the put strike."}],"\n",["$","p","p-7",{"children":"That last point is frequently miscounted. Margin and risk are computed on one\r\nside, not both."}],"\n",["$","h2","h2-3",{"children":"The trade-off against a short strangle"}],"\n",["$","p","p-8",{"children":"The comparison is the real content of this lesson."}],"\n",["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{}],["$","th","th-1",{"children":"Short strangle"}],["$","th","th-2",{"children":"Iron condor"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":"Credit"}],["$","td","td-1",{"children":"Higher"}],["$","td","td-2",{"children":"Lower"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":"Maximum loss"}],["$","td","td-1",{"children":"Unbounded"}],["$","td","td-2",{"children":"Wing width minus credit"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":"Margin"}],["$","td","td-1",{"children":"Large"}],["$","td","td-2",{"children":"Substantially smaller"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":"Return on margin"}],["$","td","td-1",{"children":"Can be higher in quiet periods"}],["$","td","td-2",{"children":"More stable"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":"Behaviour in a tail move"}],["$","td","td-1",{"children":"Loss unbounded"}],["$","td","td-2",{"children":"Loss stops at the wing"}]]}]]}]]}],"\n",["$","p","p-9",{"children":"The condor collects less and cannot be destroyed by a single move. Whether the\r\nforfeited credit is worth the bounded tail is the allocation decision; the\r\nstructures are not interchangeable and the diagrams do not make the difference\r\nobvious."}],"\n",["$","h2","h2-4",{"children":"Indian market specifics"}],"\n",["$","p","p-10",{"children":[["$","strong","strong-0",{"children":"Margin efficiency is the main practical driver."}]," A four-leg defined-risk\r\nposition attracts a fraction of the strangle's margin, which is why condors are\r\ncommon in Indian retail books despite the smaller credit."]}],"\n",["$","p","p-11",{"children":[["$","strong","strong-0",{"children":"Costs are four legs in and four legs out."}]," Eight brokerage charges plus STT\r\non every sold leg. On a narrow condor in a weekly contract, total cost can\r\nconsume a large share of the credit. This is the most cost-sensitive structure\r\nin this folder, and narrow wings make the ratio worse, not better."]}],"\n",["$","p","p-12",{"children":[["$","strong","strong-0",{"children":"Strike steps."}]," NIFTY 50 points, BANKNIFTY 100. The ",["$","code","code-0",{"children":"ATM±2"}]," / ",["$","code","code-1",{"children":"ATM±4"}]," in the\r\nfrontmatter are strike ",["$","em","em-0",{"children":"steps"}],", so the same lesson produces a 100-point-wide\r\nwing in NIFTY and a 200-point one in BANKNIFTY. Live steps come from the scrip\r\nmaster."]}],"\n",["$","p","p-13",{"children":[["$","strong","strong-0",{"children":"Expiry-day treatment."}]," The 2% extreme loss margin on short options applies\r\nto both short legs. The February 2025 withdrawal of calendar-spread benefit\r\ndoes not affect a single-expiry condor."]}],"\n",["$","p","p-14",{"children":[["$","strong","strong-0",{"children":"Weekly versus monthly."}]," With BANKNIFTY, FINNIFTY and MIDCPNIFTY monthly-only\r\nsince November 2024, a condor in those indices is held for weeks. Theta accrues\r\nmore slowly and there is far more time for the underlying to reach a short\r\nstrike."]}],"\n",["$","p","p-15",{"children":[["$","strong","strong-0",{"children":"Physical settlement."}]," On a stock condor settling between a short strike and\r\nits wing, the short leg is assigned and the long is not — creating a\r\nfull-contract-value delivery obligation on E+2 despite the position being\r\ndefined-risk. Index condors settle in cash."]}],"\n",["$","h2","h2-5",{"children":"How it typically fails"}],"\n",["$","p","p-16",{"children":"Two ways, and they are opposite."}],"\n",["$","p","p-17",{"children":"Held to expiry, the condor's high hit rate is real and the occasional full-width\r\nloss is the payoff working as designed — problematic only if size was calibrated\r\nto the hit rate."}],"\n",["$","p","p-18",{"children":"Managed actively, the more common failure is adjusting a threatened side into a\r\nlarger position, converting a defined loss into a rolling one. The wings bound\r\nthe original position, not its successors."}],"\n",["$","h2","h2-6",{"children":"Related"}],"\n",["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"children":"strategies/volatility/short-strangle.md"}]," — the undefined-risk version"]}],"\n",["$","li","li-1",{"children":[["$","code","code-0",{"children":"strategies/volatility/iron-butterfly.md"}]," — same idea, short strikes together"]}],"\n",["$","li","li-2",{"children":[["$","code","code-0",{"children":"strategies/vertical-spreads/bull-put-spread.md"}]," — this position's lower half"]}],"\n",["$","li","li-3",{"children":[["$","code","code-0",{"children":"strategies/vertical-spreads/bear-call-spread.md"}]," — its upper half"]}],"\n"]}]]}]]}],["$","p",null,{"className":"text-[10px] leading-relaxed text-faint","children":["Educational material describing how a structure behaves. Not a recommendation, not a signal, and not personalised advice. Source: ",["$","code",null,{"className":"font-mono","children":"docs/learning/strategies/volatility/iron-condor.md"}]]}]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[null,["$","$L6",null,{"children":["$","$L3",null,{"parallelRouterKey"