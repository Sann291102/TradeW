 gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Outlook it expresses"}],["$","dd",null,{"className":"text-text","children":"moderately-bearish"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Opens with"}],["$","dd",null,{"className":"text-text","children":"a debit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Best case"}],["$","dd",null,{"className":"text-text","children":"Spread width minus net debit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Worst case"}],["$","dd",null,{"className":"text-text","children":"Net debit paid"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Breakeven"}],["$","dd",null,{"className":"text-text","children":"Higher strike minus net debit"}]]}],["$","div",null,{"className":"flex gap-2","children":[["$","dt",null,{"className":"w-36 shrink-0 text-faint","children":"Exposures"}],["$","dd",null,{"className":"text-text","children":"delta negative · gamma mixed · theta mixed · vega negative"}]]}]]}]]}],["$","div",null,{"className":"rounded-card border px-[18px] py-4 transition-colors duration-panel ease-standard bg-card border-border shadow-card","children":[["$","div",null,{"className":"mb-3 flex items-center gap-2","children":["$undefined",["$","h2",null,{"className":"text-base font-semibold leading-tight","children":["Lesson",false]}],false]}],["$","div",null,{"className":"text-[12.5px] leading-relaxed text-muted [&_h1]:mb-2 [&_h1]:text-base [&_h1]:font-bold [&_h1]:text-text [&_h2]:mb-1.5 [&_h2]:mt-5 [&_h2]:text-[13px] [&_h2]:font-bold [&_h2]:text-text [&_h3]:mb-1 [&_h3]:mt-4 [&_h3]:text-[12px] [&_h3]:font-semibold [&_h3]:text-text [&_p]:mb-2.5 [&_strong]:font-semibold [&_strong]:text-text [&_ul]:mb-2.5 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mb-2.5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1 [&_code]:rounded [&_code]:bg-bg [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[11px] [&_code]:text-text [&_table]:mb-3 [&_table]:w-full [&_table]:text-left [&_table]:text-[11.5px] [&_th]:border-b [&_th]:border-border [&_th]:pb-1 [&_th]:pr-3 [&_th]:font-semibold [&_th]:text-text [&_td]:border-b [&_td]:border-border [&_td]:py-1 [&_td]:pr-3 [&_td]:align-top [&_a]:text-teal hover:[&_a]:underline [&_blockquote]:border-l-2 [&_blockquote]:border-border2 [&_blockquote]:pl-3 [&_blockquote]:italic","children":[["$","h1","h1-0",{"children":"Bear Put Spread"}],"\n",["$","p","p-0",{"children":"The mirror of the bull call spread. Two legs in the same expiry: a bought put\r\nand a sold put at a lower strike. Also called a put debit spread."}],"\n",["$","h2","h2-0",{"children":"The structure"}],"\n",["$","p","p-1",{"children":"The higher strike is the long leg, the lower strike the short leg, same expiry. Net debit, since the\r\nhigher put is worth more."}],"\n",["$","h2","h2-1",{"children":"What it is exposed to"}],"\n",["$","p","p-2",{"children":[["$","strong","strong-0",{"children":"Delta"}]," negative, smaller in magnitude than an outright long put."]}],"\n",["$","p","p-3",{"children":[["$","strong","strong-0",{"children":"Gamma and theta"}]," mixed, changing character depending on where the underlying\r\nsits relative to the two strikes — gamma-positive near the long strike,\r\ngamma-negative near the short one, roughly offsetting between them."]}],"\n",["$","p","p-4",{"children":[["$","strong","strong-0",{"children":"Vega"}]," net negative and small in magnitude."]}],"\n",["$","p","p-5",{"children":["This last point is where the bear put spread earns its place, and the reason is\r\nspecific to puts rather than general to spreads. Index put skew means the lower\r\nstrike carries ",["$","em","em-0",{"children":"higher"}]," implied volatility than the higher strike. Selling the\r\nlower strike therefore sells the more expensive volatility and buys the\r\ncheaper. A bear put spread partially monetises skew, which an outright long put\r\npays for in full."]}],"\n",["$","p","p-6",{"children":"The practical consequence: in a high-VIX environment, a bear put spread is\r\nsubstantially cheaper relative to an outright put than the same comparison\r\nwould be for calls in a high-volatility environment. The steeper the skew, the\r\nbetter the spread compares."}],"\n",["$","h2","h2-2",{"children":"Payoff"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"Above the higher strike at expiry: both expire worthless, net debit lost."}],"\n",["$","li","li-1",{"children":"Between the strikes: the long put has intrinsic value, the short does not."}],"\n",["$","li","li-2",{"children":"At or below the lower strike: both in the money, difference fixed at spread width."}],"\n"]}],"\n",["$","p","p-7",{"children":"Maximum profit is spread width minus net debit. Maximum loss is the net debit.\r\nBreakeven is the higher strike minus the net debit."}],"\n",["$","h2","h2-3",{"children":"Indian market specifics"}],"\n",["$","p","p-8",{"children":[["$","strong","strong-0",{"children":"Skew is the reason to prefer this over a long put"}],", and it is also the\r\nreason the maximum profit looks smaller than expected. Selling the expensive\r\nlower strike brings in more premium, which lowers the debit — but the lower\r\nstrike is priced richly precisely because large downside moves happen. The\r\ncapped payoff forfeits exactly the scenario the skew is pricing."]}],"\n",["$","p","p-9",{"children":[["$","strong","strong-0",{"children":"Margin."}]," Treated as a hedged position, so margin is a fraction of the naked\r\nshort put's."]}],"\n",["$","p","p-10",{"children":[["$","strong","strong-0",{"children":"Physical settlement asymmetry."}]," On a stock spread settling between the\r\nstrikes, the long put is exercised and the short is not — obliging delivery of\r\nshares on E+2. The trader must have or acquire the stock. Index spreads are\r\ncash settled."]}],"\n",["$","p","p-11",{"children":[["$","strong","strong-0",{"children":"Costs."}]," Four legs of brokerage across entry and exit, STT of 0.15% of\r\npremium on each sold leg."]}],"\n",["$","h2","h2-4",{"children":"How it typically fails"}],"\n",["$","p","p-12",{"children":"The same way its bullish counterpart does — it caps the move it was built for.\r\nA bear put spread held through a genuine market break captures only to the\r\nlower strike, while the skew it sold reprices violently against the short leg\r\non the way down. In a fast decline the spread's mark-to-market can look far\r\nworse than its expiry payoff, because the short leg's implied volatility rises\r\nfaster than the long leg's."}],"\n",["$","h2","h2-5",{"children":"Related"}],"\n",["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"children":"strategies/directional/long-put.md"}]," — uncapped, more expensive, long vega"]}],"\n",["$","li","li-1",{"children":[["$","code","code-0",{"children":"strategies/vertical-spreads/bear-call-spread.md"}]," — same view, expressed for a credit"]}],"\n",["$","li","li-2",{"children":[["$","code","code-0",{"children":"volatility/smile-and-skew.md"}]," — why the lower strike is the expensive one"]}],"\n"]}]]}]]}],["$","p",null,{"className":"text-[10px] leading-relaxed text-faint","children":["Educational material describing how a structure behaves. Not a recommendation, not a signal, and not personalised advice. Source: ",["$","code",null,{"className":"font-mono","children":"docs/learning/strategies/vertical-spreads/bear-put-spread.md"}]]}]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(workspace)","children","learning","children","strategy","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["