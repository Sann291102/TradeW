{
  "name": "@tradew/ui",
  "version": "0.1.0",
  "private": true,
  "description": "TradeW shared design-system package — tokens, motion, and UI primitives extracted from the canonical terminal (docs/design-reference/DESIGN-SYSTEM.md). Consumed by apps/web via Next transpilePackages; no separate build step.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/tokens.css",
    "./tailwind-preset": "./src/tailwind-preset.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "framer-motion": ">=11",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
