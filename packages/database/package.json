{
  "name": "@tradew/database",
  "version": "0.1.0",
  "private": true,
  "description": "Single Prisma schema + migration history — the one schema owner for Postgres (ARCHITECTURE.md §1.4)",
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts",
    "admin:grant": "ts-node scripts/grant-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
