generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum InstrumentType {
  INDEX
  OPTION
  EQUITY
  // Added with the scrip-master importer: the Dhan master classifies FUTIDX /
  // FUTSTK contracts, and without this value they would have to be mislabelled
  // as EQUITY or dropped. Not reachable under the default segment allowlist
  // (IDX_I + NSE_EQ) — it matters when F&O segments are enabled.
  FUTURE
}

enum OrderSide {
  BUY
  SELL
}

// MARKET fills immediately at the live price. LIMIT rests until the market
// reaches `price`. SL (stop-loss limit) rests untriggered until the live
// price crosses `triggerPrice`, then behaves like a LIMIT at `price`. SL_M
// (stop-loss market) triggers the same way but fills at market once hit.
enum OrderType {
  MARKET
  LIMIT
  SL
  SL_M
}

// DAY: cancelled automatically if unfilled by session close. IOC: fill
// whatever is immediately available and cancel the remainder right away.
enum OrderValidity {
  DAY
  IOC
}

// MIS: intraday, simulated higher leverage. CNC: cash delivery (equities/
// ETFs). NRML: carry-forward (F&O). Purely affects the simulated margin
// calculation in this paper engine — there is no real broker settlement.
enum ProductType {
  MIS
  CNC
  NRML
}

// PENDING: accepted, not yet queued. OPEN: resting and working the market
// (LIMIT before fill). TRIGGER_PENDING: SL/SL_M before its trigger price is
// hit. PARTIALLY_FILLED / FILLED: filledQuantity < / == quantity. CANCELLED:
// user- or validity-cancelled before full fill. REJECTED: never accepted
// (bad lot size, insufficient margin, unresolvable instrument). EXPIRED:
// DAY validity order still open at session close.
enum OrderStatus {
  PENDING
  OPEN
  TRIGGER_PENDING
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

// Why a Position's quantity went to 0: FLATTENED = a real square-off trade
// (SELL/BUY closed it). SETTLED = a CNC position's T+1 settlement transferred
// it into a Holding row instead — no trade occurred, nothing changed hands at
// a price. CONVERTED = PositionService.convert moved this row's quantity into
// a different productType row for the same instrument — also no trade, no
// price. Positions/closed and any "closed positions" UI must not conflate
// any of the three. Null while the position is still open.
enum PositionCloseReason {
  FLATTENED
  SETTLED
  CONVERTED
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  // Nullable since Google sign-in: a user who has only ever authenticated
  // through Google has no password to hash, and storing a random unusable one
  // would make "can this account log in with a password?" unanswerable. Code
  // reading this must treat null as "no password credential", never as an
  // empty password — `login()` rejects null before reaching bcrypt.
  passwordHash         String?
  // Set when the account is linked to a Google identity. Unique so two TradeW
  // users can never claim the same Google account; nullable because most
  // accounts are email+password only.
  googleId             String?               @unique
  // E.164, e.g. +919876543210. Unique so a number identifies one account, and
  // nullable because phone is an optional second way in, not a requirement.
  phone                String?               @unique
  phoneVerifiedAt      DateTime?
  country              String                @default("IN")
  experienceLevel      String?
  optionsFamiliarity   String?
  // Admin portal access. Deliberately a per-user boolean rather than a role
  // enum: there is exactly one privileged surface (`/admin`) and one level of
  // privilege on it, so a role table would model a distinction that does not
  // exist. Defaults false — access is granted explicitly by an operator
  // (`npm run admin:grant -w @tradew/database -- <email>`), never by signup.
  //
  // This is a SECOND, independent factor on top of the shared-secret
  // `ADMIN_API_TOKEN` that `AdminTokenGuard` already checks. The admin API
  // requires both: a valid user JWT whose user row has `isAdmin`, and the
  // operator token. Leaking either one alone is not sufficient.
  isAdmin              Boolean               @default(false)
  // ---- Agent paper-trading consent --------------------------------------
  // When set, this user's PAPER account may be bound to a USER_PAPER
  // ExecutionProfile, letting Sentinel place paper orders that land in this
  // user's own order book, positions and P&L.
  //
  // A TIMESTAMP, not a boolean, for the same reason `phoneVerifiedAt` is: the
  // question an auditor asks is "when was this account opened to an autonomous
  // agent, and by whom", and a boolean cannot answer either half. Null means
  // never granted — the default for every account, including the three that
  // already exist.
  //
  // Revoking sets this back to null. It is read on EVERY execution pass rather
  // than cached on the profile, for the reason `User.isAdmin` is re-read per
  // request: a grant that outlives its revocation is not a grant, it is a leak.
  //
  // This is a consent record. It is NOT a credential, and nothing in this
  // feature ever reads `passwordHash`, `googleId` or a broker credential.
  agentPaperTradingEnabledAt DateTime?
  // The operator who granted it, for the audit trail. Free text (an operator
  // email), not an FK — operators live in `OperatorAccount`, a different
  // identity space from `User`, and an FK across the two would imply they are
  // the same kind of principal.
  agentPaperTradingGrantedBy String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  orders               Order[]
  trades               Trade[]
  positions            Position[]
  paperWallet          PaperWallet?
  refreshTokens        RefreshToken[]
  preferences          UserPreference[]
  auditEvents          AuditEvent[]
  subscriptions        Subscription[]
  entitlementOverrides EntitlementOverride[]
  journalEntries       JournalEntry[]
  notifications        Notification[]
  disciplineSessions   DisciplineSession[]
  disciplineOverrides  DisciplineOverride[]
  cryptoWallet         CryptoWallet?
  cryptoOrders         CryptoOrder[]
  cryptoPositions      CryptoPosition[]
  brokerCredentials    BrokerCredential[]
  brokerOAuthStates    BrokerOAuthState[]
  apiCallLogs          ApiCallLog[]
  aiCallLogs           AiCallLog[]
  holdings             Holding[]
  holdingSettlements   HoldingSettlement[]
  portfolioSnapshots   PortfolioSnapshot[]
  // Execution profiles whose PAPER account is this user. Non-empty only for the
  // system-owned Sentinel accounts the seed creates — a human trader's account
  // is never bound to a profile. See ExecutionProfile.
  executionProfiles    ExecutionProfile[]  @relation("ExecutionProfileAccount")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model Instrument {
  id          String         @id @default(uuid())
  // Platform-canonical lookup key. Deliberately kept globally unique so
  // findUnique({ where: { symbol } }) — used by /market-data/quote-by-symbol —
  // keeps working. The broker-native symbol lives in `tradingSymbol`.
  symbol      String         @unique
  displayName String
  type        InstrumentType
  exchange    String
  underlying  String?
  expiryDate  DateTime?
  strikePrice Decimal?       @db.Decimal(12, 2)
  optionType  String?
  lotSize     Int            @default(1)
  tickSize    Decimal        @default(0.05) @db.Decimal(10, 2)

  // ---- Broker identity (DHAN-MARKET-DATA-INTEGRATION.md §5, Phase 1) ----
  // Every Dhan REST call and WebSocket subscription addresses an instrument by
  // (exchangeSegment, securityId), never by symbol — so without these columns
  // no Dhan request can be constructed at all. Nullable because the pre-existing
  // seeded rows predate any broker mapping and must keep working unmapped.
  // Dhan exchange-standard security ID.
  securityId           String?
  // NSE_EQ | NSE_FNO | BSE_EQ | BSE_FNO | MCX_COMM | IDX_I
  exchangeSegment      String?
  isin                 String?
  // Exchange-defined instrument class: EQUITY | INDEX | OPTIDX | OPTSTK | FUTIDX | ...
  dhanInstrument       String?
  series               String?
  // M (monthly) | W (weekly), derivatives only.
  expiryFlag           String?
  // Broker-native trading symbol, which is NOT unique across exchanges.
  tradingSymbol        String?
  // Underlying's securityId for derivatives, as a plain reference (not an FK —
  // the underlying may not be imported under the current segment allowlist).
  underlyingSecurityId String?

  // Soft-delete flag. Delisted instruments are deactivated, never removed —
  // CLAUDE.md Rule 1, and Order/Trade/Position rows reference them forever.
  active           Boolean   @default(true)
  // Provenance of the metadata above: 'dhan-scrip-master' | 'seed'.
  metadataSource   String?
  metadataSyncedAt DateTime?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  quotes             Quote[]
  candles            Candle[]
  orders             Order[]
  trades             Trade[]
  positions          Position[]
  holdings           Holding[]
  holdingSettlements HoldingSettlement[]

  @@unique([exchangeSegment, securityId])
  @@index([exchangeSegment])
  @@index([active])
  @@index([isin])
}

model Quote {
  id            String     @id @default(uuid())
  instrumentId  String     @unique
  ltp           Decimal    @db.Decimal(12, 2)
  previousClose Decimal?   @db.Decimal(12, 2)
  open          Decimal?   @db.Decimal(12, 2)
  high          Decimal?   @db.Decimal(12, 2)
  low           Decimal?   @db.Decimal(12, 2)
  bid           Decimal?   @db.Decimal(12, 2)
  ask           Decimal?   @db.Decimal(12, 2)
  volume        BigInt?    @default(0)
  source        String     @default("simulated")
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())
  instrument    Instrument @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId])
}

// Historical OHLCV time series, one row per (instrument, timeframe, bar).
// Distinct from Quote (a single latest-snapshot row per instrument): Candle is
// append-only history, range-queried by (instrument + timeframe + time window),
// and retained long for backtesting/replay/historical-similarity. Design:
// docs/product-architecture/MARKET-DATA-ARCHITECTURE.md §5 (Migration 2). It is
// the missing dependency behind Sentinel Trap Detection, Charts, and TradingView.
model Candle {
  id           String     @id @default(uuid())
  instrumentId String
  // Bar timeframe — mirrors CandleInterval in @tradew/types: 1m | 5m | 15m | 1h | 1d.
  timeframe    String
  // Bar open time in UTC; bars are addressed by their opening instant.
  bucketStart  DateTime
  open         Decimal    @db.Decimal(12, 2)
  high         Decimal    @db.Decimal(12, 2)
  low          Decimal    @db.Decimal(12, 2)
  close        Decimal    @db.Decimal(12, 2)
  volume       BigInt     @default(0)
  // Open interest at bar close — derivatives only, null for cash/index.
  openInterest BigInt?
  // Provenance of the bar: 'dhan' | 'simulated' | 'yahoo' | 'tradingview' | ...
  source       String     @default("simulated")
  createdAt    DateTime   @default(now())
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId, timeframe, bucketStart])
  @@index([instrumentId, timeframe, bucketStart])
}

model Order {
  id           String @id @default(uuid())
  userId       String
  instrumentId String

  side        OrderSide
  type        OrderType     @default(MARKET)
  validity    OrderValidity @default(DAY)
  productType ProductType   @default(MIS)
  status      OrderStatus   @default(PENDING)

  quantity       Int
  // Sum of every Trade's quantity against this order so far.
  filledQuantity Int      @default(0)
  // Limit price — required for LIMIT and SL, ignored for MARKET/SL_M.
  price          Decimal? @db.Decimal(12, 2)
  // Trigger price — required for SL and SL_M, ignored otherwise. Once the
  // live price crosses this, status moves TRIGGER_PENDING -> OPEN (SL) or
  // straight to filling (SL_M).
  triggerPrice   Decimal? @db.Decimal(12, 2)
  // Quantity-weighted average across this order's trades — null until the
  // first fill.
  avgFillPrice   Decimal? @db.Decimal(12, 2)
  slippage       Decimal? @db.Decimal(12, 2)
  charges        Decimal  @default(0) @db.Decimal(12, 2)
  // Simulated margin blocked while this order is open; released on
  // fill/cancel/reject (fill converts it into the position's marginUsed).
  marginBlocked  Decimal  @default(0) @db.Decimal(12, 2)

  rejectReason String?

  // Bracket/Target order future-readiness (spec: "future-ready", not
  // implemented this phase) — a child SL or target order would reference
  // the entry order that spawned it. Nothing populates this yet.
  parentOrderId String?
  parentOrder   Order?  @relation("OrderChildren", fields: [parentOrderId], references: [id])
  childOrders   Order[] @relation("OrderChildren")

  placedAt  DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // DAY validity: end of the current session, set at placement. IOC: not used
  // (resolved immediately at placement time).
  expiresAt DateTime?

  // Set only for an order the Sentinel paper-execution loop produced — the
  // ExecutionIntent this order is the submission of. Null for every order a
  // human placed, which is what makes "was this order agent-generated?" a
  // structural question rather than a heuristic over timestamps or account
  // names. Unique because one intent submits exactly one order: that
  // constraint IS the idempotency guarantee at the order layer, alongside
  // ExecutionIntent.idempotencyKey at the decision layer (see that model).
  //
  // Nullable and additive on purpose — every existing order predates this
  // column and must keep working untouched.
  executionIntentId String?          @unique
  executionIntent   ExecutionIntent? @relation("IntentSubmission", fields: [executionIntentId], references: [id])

  // The intent whose position this order CLOSES. Set only by the
  // paper-execution loop's square-off, and the counterpart to the entry link
  // above: without it, filtering the console's order list to `source=sentinel`
  // matched the loop's entries and none of its exits, quietly under-reporting
  // agent activity by half — an exit is as much the agent's act as the entry.
  //
  // Not unique, unlike the entry link. One intent submits exactly one order, so
  // that side is a true 1:1; but a position can be flattened in more than one
  // order (an exit that fails and is retried on a later reconcile tick), and a
  // unique constraint there would turn an ordinary retry into a crash.
  exitOfIntentId    String?
  exitOfIntent      ExecutionIntent? @relation("IntentExit", fields: [exitOfIntentId], references: [id])

  user       User       @relation(fields: [userId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])
  trades     Trade[]

  @@index([userId, placedAt])
  @@index([status])
  @@index([userId, status])
  // The console's `source=sentinel` filter is `executionIntentId IS NOT NULL OR
  // exitOfIntentId IS NOT NULL` over a `placedAt` window; without this the exit
  // half of that OR is a sequential scan on every 8-second poll.
  @@index([exitOfIntentId])
}

model Trade {
  id           String     @id @default(uuid())
  orderId      String
  userId       String
  instrumentId String
  side         OrderSide
  quantity     Int
  fillPrice    Decimal    @db.Decimal(12, 2)
  charges      Decimal    @db.Decimal(12, 2)
  // Set only when this fill reduces or closes an existing position — the
  // realized P&L this specific trade locked in. Null for a trade that only
  // opens/adds to a position.
  realizedPnl  Decimal?   @db.Decimal(12, 2)
  // The portion of `quantity` that was actually closing, when this trade
  // realized P&L. Equal to `quantity` for an ordinary partial or exact close
  // — but a close-and-flip fill (e.g. closing a 10-long with a 15-SELL)
  // realizes P&L over only the closing 10, while `quantity` stays 15 (the
  // whole fill, opening leg included). Without this column, TradeHistory's
  // entry-price recovery (realizedPnl / quantity) is silently wrong for a
  // flip — this is the one number that makes it exact instead. Null
  // wherever realizedPnl is null, for the same reason.
  closedQuantity Int?
  executedAt   DateTime   @default(now())
  order        Order      @relation(fields: [orderId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@index([userId, executedAt])
  @@index([orderId])
}

model Position {
  id           String      @id @default(uuid())
  userId       String
  instrumentId String
  productType  ProductType @default(MIS)
  quantity     Int
  avgPrice     Decimal     @db.Decimal(12, 2)
  // Lifetime realized P&L for this position row (survives flatten-and-reopen
  // only in the sense that a fresh row starts back at 0 — closing to zero
  // quantity does not delete the row, see PositionService).
  realizedPnl  Decimal     @default(0) @db.Decimal(12, 2)

  // Session-open snapshot (IST calendar day), refreshed once per day on
  // first touch — see PositionService.dailyPnl. Distinguishes "today's P&L"
  // from lifetime unrealized/realized without a separate time-series table.
  sessionOpenQty         Int       @default(0)
  sessionOpenAvgPrice    Decimal?  @db.Decimal(12, 2)
  sessionOpenMarketPrice Decimal?  @db.Decimal(12, 2)
  sessionAnchorAt        DateTime?

  // Simulated margin currently blocked for this open position.
  marginUsed Decimal @default(0) @db.Decimal(12, 2)

  // ---- Settlement lifecycle (CNC only — see SettlementService) ----------
  // Trading day this position's current unsettled CNC cohort clears T+1 and
  // transfers into a Holding row. Null once nothing is pending (never set for
  // MIS/NRML — only a CNC BUY fill populates it). Position-level, not
  // per-lot: a same-day top-up of an already-unsettled CNC position joins the
  // existing cohort's date rather than starting a second one — a documented
  // simplification for a paper platform with no tax-lot reporting need.
  settlesAt   DateTime?
  // Why quantity is 0, once it is. FLATTENED = a real closing trade.
  // SETTLED = this position's quantity was transferred to a Holding, not
  // traded away. Null while still open.
  closeReason PositionCloseReason?

  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([userId, instrumentId, productType])
  @@index([userId])
}

// Settled CNC equity — created once a Position's unsettled quantity clears
// T+1 (SettlementService.settleUser). Never populated for MIS/NRML: those
// product types aren't delivery ownership, so they can never become a
// Holding. No productType column — a Holding is definitionally delivery.
model Holding {
  id              String   @id @default(uuid())
  userId          String
  instrumentId    String
  quantity        Int
  // Weighted-average acquisition cost of the settled shares. Widened on a
  // later BUY-then-settle merge the same way Position.avgPrice is; narrowed
  // (unchanged) on a sell — HoldingsService.sell realizes against this, never
  // rewrites it.
  avgCost         Decimal  @default(0) @db.Decimal(12, 2)
  // Lifetime realized P&L from selling settled holdings — separate from
  // Position.realizedPnl (a different life stage of the same underlying
  // shares), both roll up into PaperWallet.realizedPnl, the one ledger.
  realizedPnl     Decimal  @default(0) @db.Decimal(12, 2)
  firstAcquiredAt DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User       @relation(fields: [userId], references: [id])
  instrument      Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([userId, instrumentId])
  @@index([userId])
}

// Audit trail for each Position -> Holding transfer, so the settlement
// lifecycle is inspectable rather than only implicit in Position/Holding
// state. Not a Trade: no fill occurred, nothing changed hands at a price.
model HoldingSettlement {
  id           String   @id @default(uuid())
  userId       String
  instrumentId String
  // Plain reference, not an FK — this is an append-only audit log of a
  // now-flattened Position row; nothing should ever need to join back to it,
  // and a Position row surviving forever just to satisfy this FK would be
  // its own kind of bug.
  positionId   String
  quantity     Int
  costPrice    Decimal  @db.Decimal(12, 2)
  settledAt    DateTime @default(now())
  user         User       @relation(fields: [userId], references: [id])
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@index([userId, instrumentId])
}

// One row per user per IST trading day — the EOD read-model Performance
// charts and the Performance Diary are built from. Captured once daily after
// session close (PerformanceService's sweep); days before this feature
// existed (or any gap) are backfilled on read from Trade history instead of
// stored, so history isn't lost, only recomputed rather than cached.
model PortfolioSnapshot {
  id             String   @id @default(uuid())
  userId         String
  // IST calendar day this snapshot represents, 'YYYY-MM-DD' — see istDateKey.
  dateKey        String
  openingValue   Decimal  @db.Decimal(14, 2)
  closingValue   Decimal  @db.Decimal(14, 2)
  cashBalance    Decimal  @db.Decimal(14, 2)
  holdingsValue  Decimal  @db.Decimal(14, 2)
  positionsValue Decimal  @db.Decimal(14, 2)
  marginUsed     Decimal  @db.Decimal(14, 2)
  // That day's realized P&L (not lifetime) and the unrealized P&L open at
  // session close.
  realizedPnl    Decimal  @db.Decimal(14, 2)
  unrealizedPnl  Decimal  @db.Decimal(14, 2)
  charges        Decimal  @db.Decimal(14, 2)
  tradesCount    Int      @default(0)
  winCount       Int      @default(0)
  lossCount      Int      @default(0)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, dateKey])
  @@index([userId, dateKey])
}

// One paper-trading cash account per user. Created lazily on a user's first
// order (see PortfolioService) rather than at signup, so accounts that never
// trade never accumulate wallet rows.
model PaperWallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  // Paper capital granted once, at wallet creation — never changes after.
  startingBalance Decimal  @default(1000000) @db.Decimal(14, 2)
  // Cash not currently blocked as margin: startingBalance + realizedPnl -
  // marginUsed - lifetime charges. Maintained incrementally, not derived
  // per-request, so it stays correct even if trade history is pruned later.
  cashBalance     Decimal  @default(1000000) @db.Decimal(14, 2)
  marginUsed      Decimal  @default(0) @db.Decimal(14, 2)
  realizedPnl     Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

// ============================================================================
// Crypto — a SEPARATE trading space, denominated in USD.
//
// Deliberately its own tables rather than widening Order/Trade/Position:
//
//  · Precision. Crypto quantities are fractional (0.00042 BTC) and prices span
//    $100k down to $0.00002. The rupee OMS stores quantity as Int and prices as
//    Decimal(12,2) — there, the smallest possible crypto order is 1 whole BTC
//    and any asset under ₹0.01 rounds to zero. Decimal(28,8)/Decimal(20,8) here
//    matches what exchanges actually quote.
//  · Currency. The paper wallet is rupees end to end — margin, P&L, the
//    portfolio rollup, the discipline session's realizedPnl. There is no FX
//    conversion anywhere in that path, and adding one to satisfy crypto would
//    put a conversion rate inside every existing money calculation.
//  · Blast radius. The rupee order path has a known concurrency defect and no
//    test coverage. Widening its column types to serve a new asset class means
//    re-verifying arithmetic that is already load-bearing for real paper
//    accounts. A separate space touches none of it.
//
// SPOT ONLY — no margin, no leverage, no short selling. A buy costs its full
// USD notional and a sell requires already holding the asset, so there is no
// margin model here at all and none of the short-option class of error is
// reachable. That is a deliberate scope choice, not a gap.
//
// No FK to Instrument: crypto symbols are Binance pairs, not exchange-listed
// instruments in that table, and nothing needs to join them.
// ============================================================================

enum CryptoOrderStatus {
  FILLED
  REJECTED
}

// One USD paper wallet per user, separate from the rupee PaperWallet.
// Created lazily on the first crypto order.
model CryptoWallet {
  id     String @id @default(uuid())
  userId String @unique

  // USD paper capital, granted once at creation.
  startingBalance Decimal @default(10000) @db.Decimal(20, 2)
  // Free USD. Spot only, so there is no margin component — cash is simply
  // startingBalance + realizedPnl - cost of what is currently held.
  cashBalance     Decimal @default(10000) @db.Decimal(20, 2)
  realizedPnl     Decimal @default(0) @db.Decimal(20, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CryptoOrder {
  id     String @id @default(uuid())
  userId String
  // Binance pair, e.g. 'BTCUSDT'.
  symbol String

  side   OrderSide
  status CryptoOrderStatus @default(FILLED)

  // Fractional by design — 8dp is Binance's own quote precision.
  quantity  Decimal  @db.Decimal(28, 8)
  // Fill price in USD. 8dp so sub-cent assets (SHIB, PEPE) are representable.
  fillPrice Decimal? @db.Decimal(20, 8)
  // quantity × fillPrice, in USD.
  notional  Decimal? @db.Decimal(20, 2)
  fee       Decimal  @default(0) @db.Decimal(20, 2)

  rejectReason String?

  placedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, placedAt])
}

model CryptoPosition {
  id     String @id @default(uuid())
  userId String
  symbol String

  // Always >= 0. Spot only — there is no short side to represent.
  quantity    Decimal @db.Decimal(28, 8)
  avgPrice    Decimal @db.Decimal(20, 8)
  realizedPnl Decimal @default(0) @db.Decimal(20, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
}

// ============================================================================
// Discipline — self-imposed session limits.
//
// The trader states three limits before the first order of a trading day
// (time, trade count, loss budget) plus an optional profit target. The OMS
// checks them on the order-placement path; a breach never hard-blocks, it
// costs the trader a typed reason which is recorded here as behavioural data.
//
// Observation only: nothing in these tables expresses a view on any
// instrument or direction. They record what the trader asked of themselves.
// ============================================================================

// Which self-imposed limit an override was taken against.
enum DisciplineLimitType {
  MAX_TRADES
  MAX_LOSS
  MAX_MINUTES
}

// One row per user per trading day. Created when the trader fills in the
// discipline panel; its existence is what stops the panel re-appearing on a
// background/reopen, so this is server truth, never a client-side flag.
model DisciplineSession {
  id     String @id @default(uuid())
  userId String

  // IST calendar day as 'YYYY-MM-DD'. Deliberately a String, not a DateTime:
  // the unique key below must mean "one per IST trading day" exactly, and a
  // DateTime would let a server in another zone open a second session for
  // what the trader experiences as the same day.
  tradingDate String

  // ---- limits, set once at session start ----
  maxMinutes   Int
  maxTrades    Int
  maxLoss      Decimal  @db.Decimal(12, 2)
  // Optional by design — the panel advises setting one but never blocks on
  // it, and no enforcement path reads it. Only the one-time notice does.
  targetProfit Decimal? @db.Decimal(12, 2)

  // ---- counters, maintained by the OMS ----
  startedAt   DateTime @default(now())
  // Accepted order placements, not fills — "how many trades will you take"
  // is a decision count. Rejected orders never increment it.
  tradesTaken Int      @default(0)
  // Mirrors the realized P&L booked through OrderService.executeFill for
  // this session, incremented in that same transaction.
  realizedPnl Decimal  @default(0) @db.Decimal(12, 2)

  // Set the first time realizedPnl reaches targetProfit, in the same
  // transaction as the notification — that is what makes the notice
  // genuinely one-time rather than once-per-fill.
  targetNoticeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrides DisciplineOverride[]

  @@unique([userId, tradingDate])
  @@index([userId, startedAt])
}

// Append-only record of a trader choosing to trade past a limit they set.
//
// A child table rather than a Json[] column on the session: this data exists
// to be read back across dates ("every loss-limit override this quarter"),
// which a JSON array cannot be indexed for. Same reasoning as
// ConceptObservation — derived views query it, so it stays queryable.
model DisciplineOverride {
  id        String @id @default(uuid())
  sessionId String
  // Denormalised from the session so cross-date queries never need the join.
  userId    String

  limitType DisciplineLimitType
  // The trader's own words. Length is enforced in the service, not here —
  // a DB constraint would turn a UX rule into a 500.
  reason    String

  // Nonce of the signed override token this row consumed. Unique, and that
  // uniqueness IS the single-use guarantee: one typed reason authorises
  // exactly one order because a replayed token collides here. Enforced by
  // Postgres inside the same transaction as the order create, so it holds
  // under concurrent placement — an application-level check would not.
  tokenNonce String @unique

  createdAt DateTime @default(now())

  session DisciplineSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, limitType, createdAt])
  @@index([sessionId])
}

// ============================================================================
// Subscription & Entitlements (ARCHITECTURE decision Q7, 2026-07-16)
// Auth, subscription, billing, entitlements, usage and permissions are
// separate concerns. Billing providers integrate later ONLY through the
// SubscriptionLifecycle interface — nothing else mutates these tables.
// ============================================================================

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  GRACE
  CANCELED
  EXPIRED
}

enum QuotaPeriod {
  DAY
  MONTH
  BILLING_CYCLE
}

model Plan {
  id            String         @id @default(uuid())
  code          String         @unique // 'free' | 'tradew_pro' | 'sentinel_pro' | 'tradew_ultimate' | 'enterprise'
  name          String
  description   String         @default("")
  trialDays     Int            @default(0)
  graceDays     Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  grants        PlanGrant[]
  subscriptions Subscription[]
}

model PlanGrant {
  id          String       @id @default(uuid())
  planId      String
  capability  String // e.g. 'sentinel', 'ai_research', 'neural_brain'
  quotaMetric String?
  quotaLimit  Int?
  quotaPeriod QuotaPeriod?
  plan        Plan         @relation(fields: [planId], references: [id])

  @@unique([planId, capability])
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  organizationId   String? // future org/team subscriptions
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  expiresAt        DateTime?
  trialEndsAt      DateTime?
  canceledAt       DateTime?
  billingProvider  String             @default("none")
  billingReference String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id])
  plan             Plan               @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([status, expiresAt])
}

model EntitlementOverride {
  id         String    @id @default(uuid())
  userId     String
  capability String
  granted    Boolean
  reason     String
  grantedBy  String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, capability])
}

model UsageCounter {
  id        String   @id @default(uuid())
  userId    String
  metric    String // e.g. 'ai_requests', 'research_runs'
  periodKey String // e.g. '2026-07-16' (day) or '2026-07' (month)
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, metric, periodKey])
}

// ============================================================================
// AI Foundation — Memory Engine + Knowledge Graph (packages/ai-core contracts)
// pgvector on the existing Postgres (locked Q4: no external vector DB).
// The embedding column is dimension-flexible; embeddingModel/Dim record what
// produced it so mixed-provider embeddings are never compared to each other.
// ============================================================================

model MemoryRecord {
  id              String                 @id @default(uuid())
  summary         String
  content         String
  sourceKind      String // research|document|chart|indicator|conversation|market_report|trading_journal|task_output|observation|system
  sourceReference String?
  sourceProvider  String?
  confidence      Float                  @default(0.5)
  tags            String[]               @default([])
  entities        Json                   @default("[]")
  userId          String? // null = global/shared knowledge
  namespace       String                 @default("global")
  staleAfter      DateTime?
  metadata        Json?
  embedding       Unsupported("vector")?
  embeddingModel  String?
  embeddingDim    Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  relationsFrom   MemoryRelation[]       @relation("MemoryRelationFrom")
  relationsTo     MemoryRelation[]       @relation("MemoryRelationTo")

  @@index([namespace, userId])
  @@index([createdAt])
}

model MemoryRelation {
  id        String       @id @default(uuid())
  fromId    String
  toId      String
  relation  String       @default("related")
  createdAt DateTime     @default(now())
  from      MemoryRecord @relation("MemoryRelationFrom", fields: [fromId], references: [id])
  to        MemoryRecord @relation("MemoryRelationTo", fields: [toId], references: [id])

  @@unique([fromId, toId, relation])
  @@index([toId])
}

model GraphNode {
  id         String      @id @default(uuid())
  entityType String // 'symbol' | 'sector' | 'concept' | 'event' | 'pattern' | ...
  entityId   String      @unique // canonical id, e.g. 'NSE:RELIANCE', 'concept:bull-trap'
  label      String?
  properties Json        @default("{}")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  edgesFrom  GraphEdge[] @relation("GraphEdgeFrom")
  edgesTo    GraphEdge[] @relation("GraphEdgeTo")

  @@index([entityType])
}

model GraphEdge {
  id         String    @id @default(uuid())
  fromId     String
  toId       String
  relation   String // 'mentions' | 'belongs_to_sector' | 'derived_from' | 'supports' | 'contradicts' | ...
  weight     Float     @default(1)
  properties Json      @default("{}")
  createdAt  DateTime  @default(now())
  from       GraphNode @relation("GraphEdgeFrom", fields: [fromId], references: [id])
  to         GraphNode @relation("GraphEdgeTo", fields: [toId], references: [id])

  @@index([fromId, relation])
  @@index([toId, relation])
}

// ============================================================================
// Sentinel Concept Knowledge Graph — the reasoning ontology
// Canonical source of truth is YAML under knowledge-base/ at the repo root;
// these tables are its runtime projection (SENTINEL-KNOWLEDGE-GRAPH.md §3).
//
// Distinct from GraphNode/GraphEdge above, which is an *entity* graph — it
// records that a symbol and a pattern co-occurred. This is a *concept* graph:
// every edge states how two ideas relate, which is what makes it reasonable
// over. The two are bridged by ConceptObservation.symbol, not by a join.
//
// Reseed contract: the seeder rewrites only columns marked "canonical" below
// and never touches learned* / *Count / observations. That separation is what
// lets the ontology be regenerated from YAML without destroying what Sentinel
// learned at runtime.
// ============================================================================

model ConceptNode {
  // ---- canonical, projected from YAML on every reseed ----
  id             String   @id @default(uuid())
  conceptId      String   @unique // stable slug, e.g. 'liquidity-sweep'
  domain         String // one of the 15 in brain/ontology/domains.ts
  name           String
  aliases        String[] @default([])
  status         String   @default("canonical") // canonical | proposed | deprecated
  maturity       String   @default("established") // established | emerging | contested
  confidence     Float    @default(0.7)
  summary        String
  definition     String
  explainer      String // the text users actually read
  observableWhen String[] @default([])
  examples       Json     @default("[]")
  sources        String[] @default([])
  tags           String[] @default([])

  // Plain slug references, not FKs — a concept may name its successor before
  // that successor has been authored, and a FK would make seed order matter.
  supersededBy String?
  supersedes   String?

  // ---- provenance ----
  origin     String  @default("canonical") // canonical (from YAML) | learned (runtime-proposed)
  sourcePath String? // knowledge-base/<domain>/<id>.yaml
  checksum   String? // sha256 of the YAML doc; lets reseed skip untouched rows

  // ---- runtime learning, never written by the seeder ----
  observationCount Int       @default(0)
  lastObservedAt   DateTime?

  // Populated once an embedding provider is configured; unset today, in which
  // case concept search falls back to text match (same gap as MemoryRecord).
  embedding      Unsupported("vector")?
  embeddingModel String?
  embeddingDim   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edgesFrom    ConceptEdge[]        @relation("ConceptEdgeFrom")
  edgesTo      ConceptEdge[]        @relation("ConceptEdgeTo")
  observations ConceptObservation[]

  @@index([domain])
  @@index([status, confidence])
  @@index([origin])
}

model ConceptEdge {
  id       String  @id @default(uuid())
  fromId   String
  toId     String
  relation String // closed vocabulary — brain/ontology/relations.ts
  note     String?

  // canonical prior authored in YAML — rewritten by reseed
  weight Float @default(0.7)

  // runtime-derived; reseed must never overwrite these four
  learnedWeight  Float?
  supportCount   Int       @default(0)
  refuteCount    Int       @default(0)
  lastObservedAt DateTime?

  origin     String @default("canonical") // canonical | learned
  status     String @default("canonical") // canonical | proposed | deprecated
  confidence Float  @default(0.7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from ConceptNode @relation("ConceptEdgeFrom", fields: [fromId], references: [id])
  to   ConceptNode @relation("ConceptEdgeTo", fields: [toId], references: [id])

  @@unique([fromId, toId, relation])
  @@index([fromId, relation])
  @@index([toId, relation])
  @@index([origin, status])
}

// Append-only log of the graph meeting reality. Never updated, never deleted —
// learned weights are derived from these rows, so mutating one would rewrite
// history that a past explanation already cited.
model ConceptObservation {
  id        String  @id @default(uuid())
  conceptId String // FK to ConceptNode.id (not the slug)
  edgeId    String? // set when the observation is about a relation, not a concept
  symbol    String? // bridge to the entity graph / market data
  outcome   String // confirmed | refuted | inconclusive
  strength  Float   @default(0.5)
  context   Json    @default("{}")

  // SentinelObservation.id that produced this, for audit traceability.
  observationId String?
  namespace     String  @default("global")

  observedAt DateTime @default(now())

  concept ConceptNode @relation(fields: [conceptId], references: [id])

  @@index([conceptId, observedAt])
  @@index([edgeId])
  @@index([symbol, observedAt])
}

// Human review queue. Runtime learning proposes here; a person promotes the
// entry into YAML; the next reseed makes it canonical. Sentinel never edits
// the canonical source files itself.
model ConceptPromotion {
  id String @id @default(uuid())

  // Service-computed stable key. A composite @@unique cannot dedupe these
  // because Postgres treats NULLs as distinct and most columns are nullable.
  dedupeKey String @unique

  kind        String // concept | relation
  conceptId   String? // proposed concept slug
  fromConcept String?
  toConcept   String?
  relation    String?

  rationale    String
  evidence     Json   @default("{}")
  supportCount Int    @default(0)
  confidence   Float  @default(0)

  status     String    @default("pending") // pending | approved | rejected | merged
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, confidence])
}

// ============================================================================
// Sentinel — observations (compliance audit trail) + trading journal
// Every user-visible Sentinel output traces back to logged, evidenced
// observations (SENTINEL.md §6). Sentinel never blocks or delays orders.
// ============================================================================

model SentinelObservation {
  id         String   @id @default(uuid())
  userId     String? // null = market-wide observation not tied to a user
  agent      String // 'market-technical' | 'emotion' | 'trap-safety' | 'compliance-audit' | 'orchestrator'
  category   String // SEBI-relevant label assigned by the Compliance & Audit agent
  pattern    String? // e.g. 'bull_trap', 'low_volume_breakout', 'revenge_trading'
  symbol     String?
  content    String // observation text (evidence -> pattern -> soft suggestion)
  evidence   Json     @default("[]")
  confidence Float    @default(0.5)
  surfaced   Boolean  @default(false) // whether the orchestrator surfaced it to the user
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agent, createdAt])
  @@index([symbol, createdAt])
}

model JournalEntry {
  id           String   @id @default(uuid())
  userId       String
  mood         String? // 'focused' | 'anxious' | 'confident' | 'frustrated' | ...
  content      String
  flaggedByAi  Boolean  @default(false)
  aiAnnotation String?
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum NotificationCategory {
  trade
  sentinel
  learning
  research
  portfolio
  broker
  announcement
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  category  NotificationCategory
  title     String
  body      String
  read      Boolean              @default(false)
  metadata  Json? // flexible payload: orderId, symbol, link, etc.
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, read])
}

// ============================================================================
// News Event Intelligence — 13-category financial news event classification
// (NVIDIA AI Model Distillation blueprint; served by any LlmProvider, incl.
// a distilled student model on NVIDIA NIM, selected purely by config)
// ============================================================================

// ============================================================================
// Broker credentials — tokens obtained through a broker's OAuth/consent flow.
//
// Exists because a token minted at RUNTIME has nowhere else to go. Dhan's
// app-key flow returns an access token after the user completes 2FA in a
// browser; environment variables are read once at process start and cannot be
// rewritten, so the token has to be persisted somewhere the API and the feed
// bridge can both read.
//
// Dhan tokens are valid for 24 hours (their docs, verified 2026-07-29). This
// table is what makes re-consent a button rather than a manual edit of
// services/market-data/.env followed by a restart.
// ============================================================================

model BrokerCredential {
  id String @id @default(uuid())

  // 'dhan' today. A second broker would be a second row, not a second table.
  //
  // SECURITY: this used to be `@unique` on its own, which made the table a
  // single global slot — every credential write targeted the same row
  // regardless of who initiated it, so "whoever completed consent last owns
  // the platform's broker session". Uniqueness is now (provider, userId): a
  // credential belongs to exactly one user and is only ever read or written
  // through an explicit ownership check.
  provider String

  // Owning user. Every read and write of this row is authorized against this
  // column — there is no code path that resolves a credential by provider
  // alone. Cascade so deleting a user cannot leave an orphaned broker token
  // behind with no owner to authorize against.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The broker's own account identifier (Dhan: dhanClientId).
  brokerClientId   String?
  brokerClientName String?

  // The access token, ENCRYPTED AT REST as of 2026-08-20.
  //
  // Stored as `enc:v1:<keyId>:<iv>:<tag>:<ciphertext>` — AES-256-GCM, key from
  // BROKER_CREDENTIAL_ENC_KEYS, never from this database. The format and both
  // ends of it live in packages/database/src/credential-crypto.ts; nothing else
  // in the codebase encrypts or decrypts this column.
  //
  // Bound to (provider, userId) as AEAD associated data. That is not
  // decoration: without it, an attacker with write access to this table could
  // copy the feed-default user's ciphertext into their own row and inherit that
  // credential without decrypting anything.
  //
  // HISTORY, kept because it explains the migration story. This column was
  // plaintext until 2026-08-20, so any database or backup taken before then
  // contains live brokerage tokens — see
  // docs/security/BROKER_CREDENTIAL_SECURITY_DESIGN.md §7 for what to do about
  // that. Reads still accept a plaintext value (and log loudly), so deploying
  // the encrypting build disconnects nobody; the backfill is a separate,
  // explicit, dry-run-by-default command:
  //   npm run credential:migrate -w @tradew/database
  //
  // NO SCHEMA MIGRATION accompanies this change, deliberately. The column type
  // is unchanged, so there is no SQL to write — and therefore no migration that
  // can destroy a live credential by getting the transform wrong.
  //
  // WHY ENCRYPTED AND NOT HASHED, unlike RefreshToken.tokenHash / Otp.codeHash /
  // BrokerOAuthState.stateHash: those are verified, this one is REPLAYED to
  // Dhan, so it has to be recoverable.
  accessToken String

  // Broker-reported expiry. The refresh job and the /status route both read
  // this rather than assuming 24h from issue.
  expiresAt DateTime?

  // Provenance: 'consent' (OAuth flow) | 'manual' (pasted into .env).
  source String @default("consent")

  // Marks the ONE credential the shared live-feed bridge runs on.
  //
  // The bridge is a single process serving public market data to everybody, so
  // it needs one designated token. Previously it took "the only row in the
  // table", which is the single-operator assumption this migration removes:
  // with per-user credentials that would silently mean "whichever row the
  // query happened to return". The designation is now explicit, operator-only
  // (ADMIN_API_TOKEN), and enforced unique per provider by a partial index in
  // the migration — Prisma cannot express `WHERE isFeedDefault = true`, so the
  // constraint lives in SQL and is documented here.
  isFeedDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, userId])
  @@index([provider, isFeedDefault])
}

// ============================================================================
// Broker OAuth/consent state — CSRF and replay protection for the broker
// connect flow.
//
// The broker redirect (`GET /broker/dhan/callback`) cannot carry a bearer
// token: it arrives as a top-level browser navigation from the broker's own
// domain. Without a server-side record of which authenticated user started the
// flow, that endpoint accepts any well-formed callback from anyone — the exact
// gap this table closes.
//
// One row per initiated flow. Created only by an authenticated request to
// /connect, consumed exactly once by the callback, and useless after
// `expiresAt`. A callback that matches no live row is rejected and logged.
// ============================================================================

model BrokerOAuthState {
  id String @id @default(uuid())

  // 'dhan'. Scopes a state to the provider that issued it, so a state minted
  // for one broker cannot be replayed against another's callback.
  provider String

  // The authenticated user who started this flow. The credential written when
  // the callback completes is attributed to THIS user — never to anything
  // supplied in the callback request.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the state value, never the value itself — same rule as
  // RefreshToken.tokenHash. A database read cannot recover a usable state, and
  // verification is a hash-and-compare. Unique so a replayed value collides
  // rather than creating a second usable row.
  stateHash String @unique

  // The broker's consent id for this flow, when the provider returns one
  // (Dhan does). Used to correlate a callback that does not echo `state` back.
  consentAppId String?

  // Set the moment the state is used. A non-null value means "already
  // consumed", which is what makes replay detectable rather than silent.
  consumedAt DateTime?

  // Short by design (minutes). An abandoned flow must stop being usable
  // quickly; an expired row is rejected exactly like a missing one.
  expiresAt DateTime

  // Request provenance for the security log. Not used for authorization —
  // both are attacker-controlled headers — only for after-the-fact review.
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([provider, userId, consumedAt])
  @@index([expiresAt])
}

model NewsEvent {
  id           String   @id @default(uuid())
  headline     String
  source       String
  url          String?
  publishedAt  DateTime
  symbols      String[] @default([])
  eventType    String // one of the 13 standardized event categories
  classifiedBy String // provider/model that produced the label
  confidence   Float?
  raw          Json?
  createdAt    DateTime @default(now())

  @@index([eventType, publishedAt])
  @@index([publishedAt])
}

// What a one-time code is allowed to do. A code minted to log in must never
// be replayable to change a password, so purpose is part of the lookup and is
// never inferred from context.
enum OtpPurpose {
  login
  password_reset
  email_verify
  // Phone sign-in. Codes for this purpose are keyed by E.164 number rather
  // than email, and are delivered over SMS instead of mail — see SmsService.
  phone_verify
}

// Short-lived one-time codes.
//
// Keyed by destination rather than userId on purpose: a login code is
// requested before we know whether the address belongs to an account, and
// revealing that difference to the caller is an account-enumeration leak.
//
// `destination` is an email address for mail-delivered purposes and an E.164
// phone number for `phone_verify`. It was `email` on a model named EmailOtp
// until phone sign-in arrived; the column was widened rather than a parallel
// PhoneOtp table added, because every hardening property below (expiry,
// attempt cap, supersede-on-reissue, hashed storage) applies identically to
// both channels and duplicating them would mean maintaining two copies of
// security-critical logic. TRADEW-OS.md §2.1, "extend before you build".
//
// The code is stored as a SHA-256 hash for the same reason RefreshToken is —
// database read access must not yield a usable credential. `attempts` bounds
// brute force against a 6-digit space; the row is consumed (not deleted) so
// a replay is distinguishable from an expiry in the audit trail.
model Otp {
  id          String     @id @default(uuid())
  destination String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([destination, purpose, consumedAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Admin telemetry
//
// Everything below exists to answer questions the admin portal (`apps/web`
// `/admin`) asks and nothing else could: what calls did the platform serve,
// what calls did the AI make, and what were the Sentinel agents doing while it
// happened. None of it is read by trader-facing code.
//
// Two deliberate constraints shape these tables:
//
//  1. **Writes must never be able to fail a user request.** Every row here is
//     written fire-and-forget from a buffered writer (`TelemetryService`); a
//     dead telemetry table degrades the admin portal, it does not degrade the
//     platform. Nothing here participates in a user-facing transaction.
//  2. **They are append-only and high-volume.** No updates, no relations that
//     would force a join on the hot path, and `onDelete: SetNull` on the user
//     link so deleting an account does not cascade-delete the audit trail an
//     operator may still need. Retention is enforced by a prune job, not by
//     the ORM.
// ---------------------------------------------------------------------------

// One served HTTP request. Written by `ApiCallInterceptor` for every route on
// `services/api`, successful or not.
//
// `path` is the ROUTE TEMPLATE (`/market-data/quote/:symbol`), not the raw
// URL — raw URLs make grouping impossible and quietly carry identifiers into
// a table an operator reads casually. The raw query string is dropped for the
// same reason.
model ApiCallLog {
  id         String   @id @default(uuid())
  // Correlation id shared with any AiCallLog / AgentActivity rows produced
  // while serving this request. This is the join that lets the portal show
  // "this click caused these four LLM calls".
  requestId  String
  method     String
  path       String
  // Populated only when the route is parameterised; lets an operator find the
  // one bad request without denormalising it into `path`.
  routeParams Json?
  statusCode Int
  durationMs Int
  // Null for unauthenticated routes (login, health, public market data).
  userId     String?
  ip         String?
  userAgent  String?
  // Message only, never a stack — this table is rendered in a browser.
  error      String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([statusCode, createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
}

// One call to an LLM provider. Written by the provider wrapper in
// `@tradew/ai-core`, so it captures calls from every system — Sentinel's
// agents, the TradeW AI assistant, research, and the learning pipeline —
// rather than only the ones someone remembered to instrument.
model AiCallLog {
  id               String   @id @default(uuid())
  // Correlates back to the ApiCallLog that triggered it, when there was one.
  // Null for scheduled/background work (market-close review, book ingestion).
  requestId        String?
  // Which product surface made the call: `sentinel`, `tradew-ai`, `research`,
  // `learning`.
  system           String
  // Agent name from `agents/*/definitions.json` — e.g. `market-technical`,
  // `trap-safety`, `orchestrator`.
  agent            String
  provider         String
  model            String
  // `fast` | `deep` — the tier from the agent definition, kept so cost can be
  // attributed to a routing decision rather than only to a model name.
  tier             String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  // Provider cost in USD at call time. Stored rather than derived: pricing
  // changes, and a historical cost chart must not silently rewrite itself
  // when it does.
  costUsd          Float    @default(0)
  latencyMs        Int
  // `ok` | `error` | `timeout` | `refused` | `fallback`
  status           String
  error            String?
  userId           String?
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([system, createdAt])
  @@index([agent, createdAt])
  @@index([status, createdAt])
  @@index([requestId])
}

// One state transition of one agent inside one orchestrator run.
//
// This is what drives the live orbit visualisation: the portal replays recent
// rows to draw history and subscribes to the in-process event bus for the
// live edge. Rows are small and written per-transition, so a single Sentinel
// observation produces roughly a dozen — that volume is the point, it is what
// makes the animation reflect real work rather than a decorative loop.
model AgentActivity {
  id        String   @id @default(uuid())
  // Groups every transition belonging to one orchestrator run.
  runId     String
  requestId String?
  system    String
  agent     String
  // `queued` | `thinking` | `sending` | `receiving` | `done` | `error` | `idle`
  //
  // `sending`/`receiving` are directional on purpose: the orbit draws a
  // travelling pulse along the connector between `agent` and `peer`, and it
  // needs to know which way the data is moving.
  state     String
  // The other end of a `sending`/`receiving` transition — almost always
  // `orchestrator`. Null for local states like `thinking`.
  peer      String?
  // Short human-readable line shown on the agent's card in the portal:
  // "scanning 15m structure", "3 signals corroborate".
  detail    String?
  // Time spent in the state being closed out, when known.
  durationMs Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([runId, createdAt])
  @@index([agent, createdAt])
  @@index([system, createdAt])
}

// One complete orchestrator run — the parent of a set of AgentActivity rows.
// Kept separate so the portal can list runs cheaply without aggregating the
// per-transition table on every page load.
model AgentRun {
  id           String    @id @default(uuid())
  runId        String    @unique
  requestId    String?
  system       String
  // What started the run: `observe`, `chat`, `market-close`, `backtest`.
  trigger      String
  symbol       String?
  userId       String?
  // Agents that actually reported activity, so the orbit can dim the ones
  // that sat out this run.
  agentsRan    String[]
  // `running` | `ok` | `error`
  status       String    @default("running")
  // Whether the run produced user-facing copy, or stayed silent. Sentinel
  // staying quiet is a normal outcome (silence is a feature), so this is not
  // an error signal — it is the single most useful column for judging whether
  // the confidence gate is tuned correctly.
  surfaced     Boolean   @default(false)
  confidence   Float?
  error        String?
  durationMs   Int?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([startedAt])
  @@index([system, startedAt])
  @@index([status, startedAt])
  @@index([userId, startedAt])
}

// A time-bounded claim on a named singleton job, so exactly one process runs it.
//
// WHY THIS TABLE EXISTS (2026-08-10 production-readiness audit)
//
// Several services run work on a plain `setInterval` — the paper matching
// engine, T+1 settlement, the EOD performance sweep, Sentinel's market watch
// and adaptive calibration. Each of those is written as though it is the only
// copy running, and today it is, because the deployment runs exactly one
// replica of each service. Add a second replica and they do not merely
// duplicate effort: two matching engines evaluating the same resting order
// concurrently can both decide it fills, which is a double fill on a real
// user's book. That made "run two API containers" not a scaling decision but a
// correctness decision — which is the wrong shape for a scaling decision to
// have.
//
// A LEASE, NOT A POSTGRES ADVISORY LOCK
//
// `pg_advisory_lock` is the obvious tool and the wrong one here. Session-level
// advisory locks live on a specific connection, and Prisma hands work to a
// pooled connection per query, so the lock's owner and the next caller are
// usually not the same session — and behind PgBouncer in transaction mode
// (the Stage 1 target) session locks do not survive at all. The transaction-
// scoped variant does survive pooling, but it would mean holding a transaction
// open for the entire tick, and a matching-engine tick makes outbound HTTP
// calls to the price bridge. A row with an expiry is boring, works through any
// pooler, and self-heals: a holder that crashes stops renewing and the lease
// simply expires.
//
// The correctness argument is the expiry, not the row: a holder MUST stop
// working once its own lease is past `expiresAt` (see LeaderElectionService),
// because a paused or partitioned process cannot tell the difference between
// "I still hold this" and "someone took it 30 seconds ago".
model JobLease {
  // The job's stable name, e.g. `matching-engine`. One row per singleton job.
  name      String   @id
  // Which process currently holds it. Random per boot — deliberately not the
  // hostname, so two containers that a platform gives the same hostname to
  // cannot silently share a lease.
  holder    String
  // Hard deadline. Past this instant the lease is free for anyone to take, and
  // the previous holder must consider itself no longer the leader.
  expiresAt DateTime
  // When the current holder last renewed. Operational visibility only — the
  // decision is made entirely on `expiresAt`.
  renewedAt DateTime @default(now())
  // First acquisition of the current holder's tenure, for the same reason.
  acquiredAt DateTime @default(now())

  @@index([expiresAt])
}

// ===========================================================================
// Cognition — the four-layer perceptor network.
//
// WHY THESE TABLES EXIST
//
// The platform had four disconnected ways of noticing things: Sentinel watched
// the market, the admin telemetry tables watched the API, the learning pipeline
// watched ingestion, and the assistant watched nothing at all beyond the
// current conversation. Each answered "is this behaving?" for its own surface,
// and none of them answered "is this getting better?" — because nothing kept a
// scored record of whether what the system noticed turned out to matter.
//
// These five tables are that record. The split follows the layer boundaries in
// `packages/ai-core/src/cognition/`, and each is written by a different part of
// the loop, which is what makes a broken stage diagnosable:
//
//   Percept           L1 wrote it   — what was sensed
//   PerceptorState    L1 owns it    — is each sensor alive, and is it enabled
//   CognitiveEpisode  the pass      — one L1..L4 traversal and its outcome
//   CognitiveProposal L4 wrote it   — work for a human, never self-executing
//   NeuralSynapse     L4 updates it — the learned weights
//
// RETENTION IS NOT UNIFORM, AND THAT IS THE POINT
//
// `Percept` and `CognitiveEpisode` are high-volume and disposable — they can be
// pruned to a rolling window without losing anything the system knows.
// `NeuralSynapse` is the opposite: it is the only genuinely irreplaceable state
// here, because a weight represents weeks of accumulated outcomes and cannot be
// recomputed from any other table. Truncating it is data loss in the ordinary
// sense, and a retention job that treats these tables alike would quietly
// delete everything the network has learned.
// ===========================================================================

// One observation, after L1's salience gate and burst collapsing.
//
// Gated percepts are NOT stored — only counted on the episode. Persisting what
// the network deliberately ignored would multiply this table by an order of
// magnitude to answer a question ("what did we drop?") that the episode's
// `gatedCount` already answers.
model Percept {
  id          String   @id @default(uuid())
  // `PerceptorDefinition.id`, e.g. `application.error-rate`. Never renamed —
  // NeuralSynapse.source is derived from it, so a rename orphans every weight
  // that sensor ever earned.
  perceptorId String
  // `market` | `application` | `assistant` | `learning` | `platform`
  domain      String
  // Perceptor-specific event name, e.g. `error_rate_spike`, `structure_break`.
  kind        String
  // What the percept is about — an EntityRef split into two columns so it can
  // be indexed: `route`/`POST /orders`, `symbol`/`NSE:RELIANCE`.
  subjectType String
  subjectId   String
  // When the world did the thing. Deliberately distinct from `createdAt` (when
  // we noticed), so replayed and backfilled percepts are not lies.
  observedAt  DateTime
  // 0..1 — how much attention this deserves.
  salience    Float
  // 0..1 — how much we believe it. Kept separate from salience because
  // "important and uncertain" and "unimportant and certain" need different
  // handling, and one merged score cannot express the difference.
  confidence  Float
  // Named numeric features for L2. Keys are stable per `kind`.
  features    Json
  summary     String
  payload     Json?
  tags        String[]
  // >1 when this row is a collapsed burst. Without it the network mistakes
  // repetition for corroboration.
  occurrences Int      @default(1)
  // The episode whose pass produced it.
  episodeId   String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([episodeId])
  @@index([domain, createdAt])
  @@index([perceptorId, createdAt])
  @@index([subjectType, subjectId, createdAt])
}

// Per-sensor health and configuration.
//
// Exists so `enabled` and quarantine state survive a restart. Holding them only
// in memory means an operator who disables a runaway perceptor watches it come
// back on the next deploy — during the incident that made them disable it.
model PerceptorState {
  // Matches PerceptorDefinition.id.
  perceptorId         String    @id
  domain              String
  enabled             Boolean   @default(true)
  // `healthy` | `stale` | `failing` | `quarantined` | `disabled`
  status              String    @default("healthy")
  // Last time `sense()` ran, whatever it returned. Silence here on an interval
  // perceptor is the staleness signal.
  lastSensedAt        DateTime?
  // Last time it returned anything. A sensor that runs and never produces is a
  // different fault from one that has stopped running, and the console has to
  // be able to tell them apart.
  lastPerceptAt       DateTime?
  consecutiveFailures Int       @default(0)
  lastError           String?
  totalPercepts       Int       @default(0)
  // Rolling mean salience. A sensor whose salience collapses toward zero has
  // become noise and should be retuned or turned off.
  meanSalience        Float     @default(0)
  updatedAt           DateTime  @updatedAt

  @@index([domain])
  @@index([status])
}

// One full L1..L4 traversal.
//
// A pass that produced nothing is still recorded. That is what makes "the
// network is quiet" distinguishable from "the network has not run" — identical
// states in any view assembled only from things that did happen, and the two an
// operator most needs to tell apart.
model CognitiveEpisode {
  id              String    @id @default(uuid())
  episodeId       String    @unique
  // Null when the pass sensed every domain.
  domain          String?
  // `scheduled` | `conversation` | `manual` | `ingest`
  trigger         String
  // `running` | `ok` | `degraded` | `error`. `degraded` means the reasoning
  // completed but a side effect (the memory write) did not — worth keeping
  // distinct, because the reasoning is still valid and still worth reading.
  status          String    @default("running")
  perceptCount    Int       @default(0)
  // Percepts dropped below the salience floor. The tuning read-out: a gated
  // count that is always zero means the floor is too low to be doing anything.
  gatedCount      Int       @default(0)
  collapsedCount  Int       @default(0)
  hypothesisCount Int       @default(0)
  promotedCount   Int       @default(0)
  proposalCount   Int       @default(0)
  // Per-layer milliseconds, keyed by layer id. Json rather than four columns so
  // adding a layer is not a migration.
  layerTimings    Json?
  error           String?
  // --- outcome, written later, when ground truth arrives ------------------
  // 0..1, with 0.5 meaning neutral. Null means unscored — the normal state for
  // a recent episode, and it must never be read as zero.
  reward          Float?
  rewardReason    String?
  scoredAt        DateTime?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([startedAt])
  @@index([domain, startedAt])
  @@index([status, startedAt])
  // Supports "which episodes are still waiting to be scored" — the query that
  // reveals a stalled feedback loop, which otherwise stops learning silently.
  @@index([scoredAt])
}

// Something the network thinks a human should decide.
//
// THERE IS DELIBERATELY NO `execute` KIND, AND NO EXECUTION PATH.
//
// ARCHITECTURE Rule 2 keeps AI services out of the order flow entirely, and the
// same reasoning applies to the rest of the platform: a system that learns from
// outcomes and also causes them has closed a loop with nobody supervising it.
// So the most consequential thing L4 can do is insert a row here with status
// `pending`. An operator is the actuator.
model CognitiveProposal {
  id         String    @id @default(uuid())
  episodeId  String
  domain     String
  // `investigate` | `tune` | `learn` | `notify`
  kind       String
  title      String
  rationale  String
  confidence Float
  // Percept ids that led here, so a proposal can always be traced back to the
  // observations that produced it.
  perceptIds String[]
  // `pending` | `accepted` | `dismissed` | `done`
  status     String    @default("pending")
  // Who acted, and what they concluded. `dismissed` with a reason is the single
  // most valuable signal this table produces — a human labelling the network
  // wrong, which is exactly what the weights need and cannot get anywhere else.
  resolvedBy String?
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([domain, createdAt])
  @@index([episodeId])
}

// A learned association between two things the network can name.
//
// The only irreplaceable table in this group — see the block comment above.
//
// `weight` is stored as last written, NOT as last read: idle decay is computed
// on read from `lastActivatedAt`, so a process that has been down for a week
// resumes with the correctly decayed value rather than one frozen at shutdown.
// A decay sweep job would give a different answer depending on when it last ran.
model NeuralSynapse {
  id               String    @id @default(uuid())
  // `L1_PERCEPTION` | `L2_ENCODING` | `L3_ASSOCIATION` | `L4_CONSOLIDATION`.
  // Part of the identity: L2's "this feature predicts this concept" and L3's
  // "this concept predicts this outcome" are different claims and must never be
  // averaged together.
  layer            String
  // e.g. `percept:application.error-rate/error_rate_spike`
  source           String
  // e.g. `concept:deploy-regression`, `agent:trap-safety`
  target           String
  // 0..1. The default matches WEIGHT_INITIAL in ai-core's weights.ts — an
  // unknown association is weakly plausible, not impossible, or the network
  // could never learn anything it was not already looking for.
  weight           Float     @default(0.35)
  // How often it fired. Firing alone never moves the weight — if it did, the
  // loudest sensor would win regardless of ever having been right.
  activations      Int       @default(0)
  // How often an outcome scored it. Zero means this weight is a guess, and the
  // console says so rather than presenting it as a finding.
  reinforcements   Int       @default(0)
  meanReward       Float     @default(0.5)
  lastActivatedAt  DateTime?
  lastReinforcedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // The natural key. Flushes upsert through it, so it must be unique rather
  // than merely indexed.
  @@unique([layer, source, target])
  @@index([layer, weight])
  @@index([source])
  @@index([target])
}

// ---------------------------------------------------------------------------
// Operator accounts — the standalone admin console's identity store.
// ---------------------------------------------------------------------------
//
// Deliberately NOT the `User` table. `User.isAdmin` answers "this trader may
// also see the console"; that is the right model for the in-product admin pages
// in `apps/web`, where the person is already a TradeW customer. The standalone
// console at `apps/admin` is a control plane, and a control plane whose identity
// store is the product's customer table inherits every signup, password-reset
// and OAuth path the product has. An operator should not be reachable through
// "forgot password" on a trading app.
//
// This table exists because the alternative — accepting `ADMIN_API_TOKEN` on its
// own as proof of an operator — cannot answer *which* operator acted, and two
// admin routes write that answer into an audit trail: `POST /admin/users/set-
// admin` (who granted privilege to whom) and `POST /admin/cognition/proposals/
// :id/resolve` (whose judgement became the cognition network's only negative
// training label). "Somebody dismissed this finding" is not an audit trail.
//
// The operator token is still required on every request. It proves the calling
// *process* is the admin deployment. This row proves the *person*. Neither is
// sufficient alone, which is the same two-factor shape `AdminGuard` already
// enforces for the product-admin path — see AdminAccessGuard.
model OperatorAccount {
  id           String    @id @default(uuid())
  email        String    @unique
  // Display name for the audit trail and the console header. Not a credential.
  name         String?
  // bcrypt, cost 10 — same as `User.passwordHash`. Non-nullable here, unlike on
  // `User`: there is no OAuth path into this table and there never should be.
  passwordHash String
  // Revocation. Checked against the DATABASE on every request rather than being
  // baked into the assertion, for exactly the reason `User.isAdmin` is: an
  // assertion outlives a decision to revoke, and a console that keeps working
  // for hours after access was pulled is not revocation, it is a delay.
  disabledAt   DateTime?
  // Online-guessing brake. `lockedUntil` is set once `failedAttempts` crosses
  // the threshold; both reset on a successful login. The login endpoint is also
  // behind `AdminTokenGuard`, so reaching it at all already requires the
  // operator token — this is defence against someone who has that token, not
  // the first line.
  failedAttempts Int     @default(0)
  lockedUntil  DateTime?
  lastSeenAt   DateTime?
  lastLoginIp  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([disabledAt])
}

// Owned by services/sentinel-py (Python), not services/api — this table's
// migration lives here because Prisma is the monorepo's single migration
// tool, but sentinel-py reads/writes it directly over Postgres (asyncpg),
// not through this Prisma client. Keep column names in sync with
// services/sentinel-py/app/strategy/store.py if this model changes.
model UserStrategy {
  id        String   @id @default(uuid())
  userId    String
  name      String
  // Structured rules produced by the deterministic text/image/video parser —
  // see services/sentinel-py/app/strategy/parser.py. Never user-editable raw
  // SQL/JS, just the plan's rule schema (timeframe, rules[], entry, riskManagement).
  rules     Json
  rawInput  String?
  inputType String   @default("text") // text | image | video
  status    String   @default("active") // active | paused | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One watch = one (user, strategy, symbol, strike). Owned by
// services/sentinel-py — see the note on UserStrategy above.
model WatchSession {
  id         String    @id @default(uuid())
  userId     String
  strategyId String
  symbol     String
  // ── LEGACY MIRROR ───────────────────────────────────────────────────────
  // Before 2026-08-18 a watch named ONE leg and these were it. Rows created
  // then still carry only these, so they cannot be dropped without losing
  // every pre-existing watch. New rows keep them populated from the FOCUSED
  // leg so those rows and this history stay readable by one query.
  // Read through `watchLegs()` (apps/web) / `_legs_of()` (sentinel-py), never
  // directly — that is what keeps this a migration shim rather than a second
  // live single-strike path.
  strike     String?
  optionType String? // CE | PE
  expiry     String? // YYYY-MM-DD, as the Dhan bridge expects it
  // ── THE PAIR UNDER OBSERVATION ──────────────────────────────────────────
  // Sentinel watches the underlying, a CALL and a PUT together and decides
  // which leg is expressing the underlying's move. It cannot do that from one
  // leg, and it cannot do it from a strike NUMBER either — it needs the
  // contract. `securityId` is the Dhan token the live feed subscribes and the
  // historical API is addressed by; it is stored as a column rather than
  // inside a JSON blob so "which contracts are we subscribed to" is answerable
  // in SQL.
  // Both legs are null for `watchMode = 'underlying'` and only then.
  ceStrike          Decimal? @db.Decimal(12, 2)
  ceSecurityId      String?
  ceExchangeSegment String? // NSE_FNO | BSE_FNO — never assumed from the symbol
  ceDhanInstrument  String? // OPTIDX | OPTSTK
  ceTradingSymbol   String?
  ceLotSize         Int?
  ceTickSize        Decimal? @db.Decimal(10, 4)
  peStrike          Decimal? @db.Decimal(12, 2)
  peSecurityId      String?
  peExchangeSegment String?
  peDhanInstrument  String?
  peTradingSymbol   String?
  peLotSize         Int?
  peTickSize        Decimal? @db.Decimal(10, 4)
  // Which leg the strategy's rules are evaluated against. NOT which leg
  // exists — both do. The UI's CE/PE control sets this and creates nothing.
  focusedSide String? // CE | PE
  watchMode   String  @default("option") // option | underlying
  // The bars the engine reads, from the strategy's own parsed rules. Recorded
  // on the watch so an observation can be checked against the series it was
  // made on after the strategy has been edited.
  timeframe String?
  state      String    @default("IDLE") // IDLE | FORMING | CONFIRMED | IN_TRADE | EXITED
  // Set when the user confirms they took the position (P4). Null while the
  // watch is still pre-entry.
  // The user's OWN declared numbers for a position they have already taken.
  // Sentinel does not propose any of these — it is told them, and reports
  // movement relative to them. See app/intrade/monitor.py.
  entryPrice  Decimal? @db.Decimal(12, 2)
  stopPrice   Decimal? @db.Decimal(12, 2)
  targetPrice Decimal? @db.Decimal(12, 2)
  direction   String? // LONG | SHORT
  // R-multiples already announced for the current position, e.g. ["1R","2R"].
  // A milestone is a level, not an event, so "already reported" has to
  // survive a restart or it re-fires on every sweep past it.
  reachedMilestones Json @default("[]")
  // Notification gating. cooldownUntil suppresses REPEATS of a state the
  // watch is already in; a forward state change notifies regardless.
  lastNotifiedAt DateTime?
  cooldownUntil  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([state])
}

// Audit trail: every sweep writes what it saw, whether or not it notified.
// This is what the admin observation viewer reads, and what makes a
// "why did/didn't Sentinel alert me?" question answerable after the fact.
//
// Deliberately NOT the older `SentinelObservation` above: that one is the TS
// Sentinel's market-wide observation feed (agent/category/pattern/content),
// keyed by user and symbol. This one is keyed by WATCH and stores per-rule
// evaluations for one strategy on one instrument. Same word, different thing
// — folding them together would give both an optional half-empty shape.
model WatchObservation {
  id              String    @id @default(uuid())
  watchSessionId  String
  agent           String
  candleTime      DateTime?
  ruleEvaluations Json
  state           String
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@index([watchSessionId])
  @@index([createdAt])
}

// ============================================================================
// SENTINEL PAPER EXECUTION
//
// The execution capability attached to the EXISTING Sentinel — not a second
// Sentinel, not a second order book, and not a second matching engine.
// services/sentinel reasons; services/api/src/paper-execution turns a reasoning
// outcome that already cleared Sentinel's own publication gate into an
// ExecutionIntent, validates it, and submits it through the SAME OrderService a
// human order goes through. Everything downstream of that call — margin,
// matching, fills, positions, P&L, settlement — is the existing paper engine,
// untouched.
//
// WHY THIS DOES NOT CONTRADICT "AI SERVICES NEVER PLACE TRADES" (CLAUDE.md
// Rule 2, ARCHITECTURE.md). That rule governs the USER's order flow: Sentinel
// must never recommend a trade to a trader, and must never sit as a gate in the
// path between a trader and their order. Both still hold, structurally:
//
//   · services/sentinel gained no ability to write an order. It has no Prisma
//     binding to Order/Trade/Position and no client to the OMS. It returns the
//     same non-directive ObserveResponse it always has.
//   · Nothing here is reachable from a user's order path. The execution loop
//     reads Sentinel; the order ticket does not read the execution loop.
//   · Every order this produces belongs to a dedicated system-owned paper
//     account, never a real trader's account (see ExecutionProfile.account).
//
// What is new is that Sentinel's reasoning can now be scored against a filled
// paper order instead of only against a screenshot of a chart.
// ============================================================================

// The ONLY execution environment that exists. Live money is not "disabled
// here", it is UNREPRESENTABLE: there is no enum member to route to, so no
// config change, no environment variable and no compromised admin session can
// move this loop onto real capital. Adding a LIVE member would be a schema
// migration and a code review — the correct size of decision for that step,
// rather than a boolean someone can flip.
enum ExecutionEnvironment {
  PAPER
}

// The system-wide operational mode of the paper-execution loop — a runtime
// kill switch that does NOT require a redeploy, unlike `PAPER_EXECUTION_ENABLED`.
//
// The env flag decides whether the scheduler's TIMERS EXIST at all; this decides
// whether an existing, ticking loop is allowed to OPEN NEW POSITIONS. The two are
// deliberately independent: an operator watching the console at 14:55 who wants
// everything flat NOW cannot wait for a redeploy, and must not have to disable
// every profile one at a time and hope none is missed.
//
// ON             — normal operation; new entries permitted (still subject to
//                  every per-profile and per-decision gate).
// OFF            — paused. No new entries. Reconcile and scheduled square-off
//                  continue, so anything already open still closes cleanly.
// EMERGENCY_STOP — stop now. No new entries AND every open agent position is
//                  squared off on the next reconcile tick regardless of its
//                  profile's `squareOffMinute`. Lifecycle cleanup is exactly what
//                  an emergency stop must NOT block — a halt that stranded open
//                  positions would be more dangerous than the thing it halts.
enum SystemExecutionMode {
  ON
  OFF
  EMERGENCY_STOP
}

// WHOSE paper account a profile trades. Orthogonal to `ExecutionEnvironment`,
// which answers "paper or live" (and only ever answers PAPER).
//
// SYSTEM_PAPER — a dedicated account created by
//   `scripts/create-execution-profile.ts`, with no password hash and no Google
//   identity, so no person can sign in to it. This was the only mode until
//   2026-08-18 and remains the DEFAULT, which is what makes the column additive:
//   every pre-existing profile keeps its exact behaviour without a data fix.
//
// USER_PAPER — an ordinary TradeW user's own paper account. The resulting
//   Order/Trade/Position rows carry that user's `userId`, so they appear in the
//   user's own app through `/sim/orders` and `/sim/positions` with no
//   synchronisation layer: those endpoints already scope by `req.user.sub`
//   against these same tables. That is the entire mechanism — there is no
//   mirroring, no copy and no admin-side ledger.
//
// The distinction is NOT cosmetic. A USER_PAPER profile trades on an account a
// real person also trades on manually, so it additionally requires that
// person's recorded consent (`User.agentPaperTradingEnabledAt`) and a stricter
// authorization path. See ExecutionAccountService.
enum ExecutionAccountScope {
  SYSTEM_PAPER
  USER_PAPER
}

// The INTENT's lifecycle, deliberately NOT a copy of OrderStatus. The order's
// own status stays the single authority on the order (OrderStatus already
// models PENDING/OPEN/TRIGGER_PENDING/FILLED/REJECTED/…); this tracks the
// decision that produced it, which has states an order does not have — a
// decision can be REJECTED by risk policy before any order exists at all.
//
// PROPOSED  — built from a Sentinel observation, not yet validated.
// REJECTED  — failed profile/risk/account validation. No order was created.
// SUBMITTED — handed to OrderService; `order` is set from here on.
// FILLED    — the order filled and a position exists.
// CLOSED    — the position was flattened; an ExecutionOutcome exists.
// FAILED    — submission raised (unresolvable contract, no market data, OMS
//             rejection). Distinct from REJECTED: REJECTED is this loop's own
//             discipline, FAILED is the world saying no.
enum ExecutionIntentStatus {
  PROPOSED
  REJECTED
  SUBMITTED
  FILLED
  CLOSED
  FAILED
}

// Where a candidate strike sits relative to spot, for the favoured side. ITM
// and OTM are one strike step in each direction from ATM — the three contracts
// a desk actually compares for the same directional read.
enum StrikeCandidateRole {
  ITM
  ATM
  OTM
}

// One (agent, strategy, market, account, environment, policy) binding.
//
// THIS MODEL EXISTS SO THE AGENT-TO-ACCOUNT MAPPING IS NEVER HARD-CODED. Adding
// a second or third Sentinel agent on a different market against a different
// paper account is a row in this table, not a branch in the execution service.
// The first end-to-end loop is proven with exactly one enabled row.
model ExecutionProfile {
  id   String @id @default(uuid())
  // Operator-facing identity, e.g. 'sentinel-alpha-nifty'.
  name String @unique
  // Which Sentinel agent identity this profile runs as. Recorded on every
  // intent, so a filled order names the agent that produced it.
  agent String
  // Registry strategy id to pin, or null to let Sentinel choose (its own
  // 'auto' strategy mode). Passed straight through to the observe call.
  strategyId   String?
  strategyName String?
  // The underlying this profile trades, e.g. 'NIFTY'. One market per profile.
  symbol String

  // ---- The paper account -------------------------------------------------
  // A real User row with a real PaperWallet — the EXISTING account model, not a
  // parallel one. Deliberately not a human trader's account: this user is
  // created by the seed script with no password credential, so it cannot log in.
  accountUserId String
  account       User   @relation("ExecutionProfileAccount", fields: [accountUserId], references: [id])

  // Whose account `accountUserId` is. Defaults to SYSTEM_PAPER so every profile
  // that existed before 2026-08-18 keeps its behaviour with no backfill.
  //
  // This column does not GRANT anything — it declares intent, and
  // `ExecutionAccountService` checks that the declaration matches the account's
  // actual shape. A profile claiming SYSTEM_PAPER against a loginable human
  // account is refused, and so is USER_PAPER against an account that never
  // consented. Trusting the column alone would make the scope a label rather
  // than a boundary.
  accountScope ExecutionAccountScope @default(SYSTEM_PAPER)

  environment ExecutionEnvironment @default(PAPER)
  // Off by default. A profile that has never been deliberately enabled by an
  // operator must never trade, including immediately after a fresh seed.
  enabled     Boolean              @default(false)

  // ---- Execution policy --------------------------------------------------
  // Order size in LOTS, multiplied by the contract's own lotSize at submission
  // — storing a raw quantity would silently break the moment an exchange
  // revises a lot size.
  lots        Int         @default(1)
  productType ProductType @default(NRML)
  orderType   OrderType   @default(MARKET)

  // ---- Risk policy -------------------------------------------------------
  // Sentinel's own publication gate is the first authority on whether a read
  // surfaces at all; this is a SECOND, independent floor the execution layer
  // applies on top. It can only ever be stricter.
  minConfidence    Int     @default(70)
  maxOpenPositions Int     @default(1)
  maxOrdersPerDay  Int     @default(6)
  // Stop trading for the IST day once realized P&L on this account is below
  // -maxLossPerDay. Stored positive, compared against a negative.
  maxLossPerDay    Decimal @default(25000) @db.Decimal(14, 2)
  // Flatten any position this profile owns at/after this IST minute-of-day
  // (910 = 15:10). Options carried past the close are not a paper engine's
  // strength, and a position that never closes never produces an outcome.
  squareOffMinute  Int     @default(910)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intents ExecutionIntent[]

  @@index([enabled])
  @@index([symbol])
}

// One decision, with the full provenance needed to answer "why did this order
// exist?" without joining on timestamps or matching text.
model ExecutionIntent {
  id        String           @id @default(uuid())
  profileId String
  profile   ExecutionProfile @relation(fields: [profileId], references: [id])

  // ---- IDEMPOTENCY -------------------------------------------------------
  // The deterministic identity of this DECISION. Derived (see
  // deriveIdempotencyKey) from profile + Sentinel run + symbol + side + strike
  // + expiry + the decision's own minute — never from a clock read at insert
  // time, which would mint a new key on every retry and defeat the mechanism.
  //
  // UNIQUE is the enforcement, not a convention. Polling, SSE reconnects, agent
  // retries, a restart mid-submit and two API replicas racing all converge on
  // the same key, and Postgres rejects the second write. The execution service
  // catches that violation and returns the FIRST intent, so a duplicate
  // decision is a no-op rather than a second position.
  idempotencyKey String @unique

  status      ExecutionIntentStatus @default(PROPOSED)
  environment ExecutionEnvironment  @default(PAPER)

  // ---- Sentinel provenance ----------------------------------------------
  // AgentRun.runId for the observation that produced this. A plain reference,
  // not an FK: AgentRun rows are telemetry and are pruned on a retention
  // schedule (TelemetryService), and an intent must outlive its telemetry.
  sentinelRunId String?
  agent         String
  strategyId    String?
  strategyName  String?

  // ---- What was decided --------------------------------------------------
  symbol         String
  // Underlying spot at the moment of decision.
  underlyingSpot Decimal?  @db.Decimal(12, 2)
  side           OrderSide
  optionType     String    // 'CE' | 'PE' — mirrors SideInFocus.side
  bias           String    // 'bullish' | 'bearish'
  strike         Decimal   @db.Decimal(12, 2)
  expiry         DateTime
  // The canonical contract symbol handed to OrderService —
  // UNDERLYING:YYYYMMDD:STRIKE:CE|PE. Stored so the trace shows exactly what
  // was submitted, not a reconstruction of it.
  contractSymbol String
  lots           Int
  quantity       Int
  productType    ProductType
  orderType      OrderType

  // ---- Evidence ----------------------------------------------------------
  // Sentinel's confidence for this observation (0-100) and its rationale.
  // Copied, not referenced: the observation is ephemeral, this is the record.
  confidence Int
  rationale  String[] @default([])
  // The four-condition publication gate's conditions[], corroborating sources
  // and conflicts.
  publication Json?
  // SideInFocus.optionContext — PCR, max pain, OI walls, ATM/focus strike.
  optionContext Json?
  // Everything the decision was made against that has no column of its own:
  // market profile, strategy matches, risk read, market state.
  marketSnapshot Json?

  // Why an intent never became an order. Set for REJECTED (policy) and FAILED
  // (submission raised). Null otherwise.
  rejectReason String?

  // The SAME refusal, as an id rather than a sentence: the first policy check
  // that failed (`daily-loss-limit`, `max-open-positions`, …), or one of the
  // non-policy stops (`submission-raised`, `oms-rejected`).
  //
  // `rejectReason` is written for a human reading one intent and interpolates
  // live numbers ("Realized -₹110,987.50 today, at or past the -₹25,000
  // floor"), so no two rows agree and the column cannot be grouped. Answering
  // "why did nothing trade today?" then means reading rejections one at a time
  // — which is the day the 2026-08-18 audit spent on the read path. This column
  // is the groupable form of the same fact; the sentence stays for the detail
  // it carries.
  rejectCheckId String?

  decidedAt   DateTime  @default(now())
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // The order this intent produced. One intent, at most one order — enforced by
  // Order.executionIntentId being @unique on the other side.
  order      Order?  @relation("IntentSubmission")
  // The order(s) that closed it. Plural because a retried square-off is
  // ordinary — see Order.exitOfIntentId.
  exitOrders Order[] @relation("IntentExit")
  candidates ExecutionStrikeCandidate[]
  outcome    ExecutionOutcome?

  @@index([profileId, decidedAt])
  @@index([status])
  @@index([symbol, decidedAt])
  @@index([sentinelRunId])
  // Backs the rejection breakdown: a decidedAt window grouped by check.
  @@index([rejectCheckId, decidedAt])
}

// One of the three candidate strikes evaluated for a decision, INCLUDING the
// two that were not selected. Storing the rejected candidates is the point:
// "why this strike" is only answerable if the alternatives and the reason each
// lost are on the record. Written whether or not the intent was submitted.
model ExecutionStrikeCandidate {
  id       String          @id @default(uuid())
  intentId String
  intent   ExecutionIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  role       StrikeCandidateRole
  strike     Decimal             @db.Decimal(12, 2)
  optionType String              // 'CE' | 'PE'
  // Live premium read from the option chain at decision time. Null when the
  // chain carried no price for this leg — itself a valid reason for a candidate
  // to lose, and never to be confused with a premium of zero.
  premium      Decimal? @db.Decimal(12, 2)
  openInterest BigInt?
  volume       BigInt?
  impliedVol   Float?
  // Distance from spot in points, signed toward the favoured side.
  moneyness    Decimal? @db.Decimal(12, 2)

  selected Boolean @default(false)
  // Did this candidate pass every hard check (priced, liquid enough, inside the
  // profile's premium band)? A candidate can be tradable and still lose.
  tradable Boolean @default(false)
  // Why it was or was not selected, in the evaluator's own words.
  reason   String
  // The individual checks that ran, so a rejection is inspectable rather than a
  // single sentence: [{ id, label, passed, detail }].
  checks   Json    @default("[]")

  createdAt DateTime @default(now())

  @@unique([intentId, role])
  @@index([intentId])
}

// The realized result of one execution, recorded once the position closes.
// Deliberately minimal and provenance-shaped: this is what a future learning
// pipeline will read, NOT the learning pipeline itself.
model ExecutionOutcome {
  id       String          @id @default(uuid())
  intentId String          @unique
  intent   ExecutionIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  entryPrice  Decimal  @db.Decimal(12, 2)
  exitPrice   Decimal? @db.Decimal(12, 2)
  quantity    Int
  // Realized P&L net of the charges the paper engine actually applied.
  realizedPnl Decimal  @db.Decimal(14, 2)
  charges     Decimal  @default(0) @db.Decimal(14, 2)
  // 'WIN' | 'LOSS' | 'SCRATCH' — derived from realizedPnl, stored so the
  // learning read does not re-derive it inconsistently.
  result      String
  // How the position ended: 'TARGET' | 'STOP' | 'SQUARE_OFF' | 'INVALIDATED' |
  // 'MANUAL'. Square-off is the common one for an intraday paper loop.
  exitReason  String
  // Set when Sentinel's own read went invalid before the exit — the single most
  // useful column for judging whether the decision or the market was wrong.
  invalidationReason String?
  holdingSeconds     Int?

  entryAt   DateTime
  exitAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([result])
}

// The single, global operational control for the whole paper-execution loop.
//
// THIS IS A SINGLETON. `key` is fixed to "GLOBAL" and is @unique, so there is
// exactly one row and reading it is a keyed lookup, not a "find the newest"
// scan that could race. The service upserts on that key; nothing creates a
// second row. A missing row is read as the safe default (ON) — the absence of
// an explicit stop is not itself a stop, but the row exists the moment anyone
// sets a mode, and its every change is audited via AuditEvent.
//
// Why a table and not an env var: an env var is set at deploy time and changing
// it means a redeploy. This is the switch an operator flips from the console
// mid-session, and the loop re-reads it every pass — so the effect is immediate
// and needs no process restart. It is a SECOND control on top of
// `PAPER_EXECUTION_ENABLED`, never a replacement: the env flag still decides
// whether the scheduler runs at all.
model SystemExecutionControl {
  key       String              @id @default("GLOBAL")
  mode      SystemExecutionMode @default(ON)
  // Free-text note an operator leaves when flipping the switch ("flattening for
  // the RBI policy statement"), surfaced on the console beside the mode.
  reason    String?
  // Who last changed it — an OperatorAccount identifier, echoed from the audited
  // admin route, so the console can show "EMERGENCY_STOP set by ops@… at 14:55".
  updatedBy String?
  updatedAt DateTime            @updatedAt
  createdAt DateTime            @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// FUNDAMENTAL RESEARCH CACHE
//
// The `/research` workspace reads company fundamentals from an external vendor
// (see packages/market-data/src/providers/fundamentals). These two models are a
// CACHE of that vendor's answers, never a source of truth and never a place a
// number may be invented.
//
// ── WHY A DURABLE CACHE AT ALL ──────────────────────────────────────────────
//
// Fundamentals endpoints are credit-metered and the vendor's entry tier allows
// single-digit requests per minute. Statements change once a QUARTER. A
// process-local cache would be lost on every deploy and multiplied by every
// replica, making upstream cost a function of traffic rather than of reporting
// periods. So the facts are persisted, keyed by the period they describe.
//
// ── WHAT IS NOT HERE ────────────────────────────────────────────────────────
//
// No computed ratios and no AI output. Ratios are recomputed from these facts on
// every read (packages/market-data/.../ratios.ts) so a formula fix cannot leave
// a stale derived number behind, and AI prose is not cached because its evidence
// basis must be re-stated from whatever the cache holds at answer time.
// ─────────────────────────────────────────────────────────────────────────────

enum ResearchStatementType {
  income
  balance
  cash_flow
}

enum ResearchPeriodType {
  annual
  quarterly
}

/// Cached company identity + slow-moving descriptive fields.
/// Separate from `Instrument`, deliberately: an Instrument is a tradeable
/// contract (with a lot size, an expiry, a broker security id) and a company is
/// an issuer. One company has many instruments; the option chain must not grow a
/// `sector` column, and this table must not grow a `tickSize`.
model ResearchCompany {
  id       String @id @default(uuid())
  /// Vendor-canonical symbol, uppercased by the service before write.
  symbol   String
  exchange String

  name        String
  currency    String
  sector      String?
  industry    String?
  country     String?
  isin        String?
  website     String?
  employees   Int?
  description String?

  /// Provenance — mirrors `Provenance` in the fundamentals contract. `source`
  /// is the vendor id, `sourceTimestamp` the vendor's own stamp (null when it
  /// publishes none — never backfilled with fetchedAt), `fetchedAt` ours.
  source          String
  sourceTimestamp DateTime?
  fetchedAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, exchange])
  @@index([symbol])
  @@index([fetchedAt])
}

/// One statement line item, for one period, for one company.
///
/// Fully normalized (one row per metric) rather than a wide table or a JSON
/// blob, for three reasons: vendors differ in which lines they publish so a wide
/// table would be mostly NULL and every NULL would be ambiguous between "not
/// filed" and "zero"; a new line item is data rather than a migration; and the
/// `basis` column can then be per-metric, which is what lets the UI mark Free
/// Cash Flow as derived while Revenue beside it is reported.
///
/// ABSENCE IS MEANINGFUL. A metric the vendor did not publish has NO ROW. There
/// is no zero-means-missing convention anywhere in this subsystem.
model ResearchStatementFact {
  id String @id @default(uuid())

  symbol        String
  statementType ResearchStatementType
  periodType    ResearchPeriodType
  fiscalYear    Int
  /// 1-4 for a quarterly period, and 0 for an annual one.
  ///
  /// NOT NULLABLE, deliberately. This column is part of the unique key below,
  /// and Postgres treats NULLs as DISTINCT in a unique index — so a nullable
  /// `fiscalQuarter` would silently permit unlimited duplicate annual rows for
  /// the same metric and year, and the cache would grow a new copy on every
  /// refresh instead of updating one. A `0` sentinel makes the constraint
  /// actually constrain. The service maps 0 <-> "annual, no quarter" at the
  /// boundary, so the domain type keeps `fiscalQuarter?: number` and nothing
  /// above the cache sees the sentinel.
  fiscalQuarter Int
  periodEnd     DateTime

  metric   String
  /// Decimal(30,4): total assets of a large issuer in rupees runs to 15 digits
  /// before the decimal point, and per-share figures need four after it. Never
  /// a float — a balance sheet that fails to reconcile because of binary
  /// rounding would be indistinguishable from one that fails because the vendor
  /// dropped a line.
  value    Decimal @db.Decimal(30, 4)
  currency String
  /// 'reported' | 'derived'. Stored, not inferred: whether Free Cash Flow came
  /// off the filing or out of `OCF − |CapEx|` is exactly what a reader
  /// cross-checking against an annual report needs to know.
  basis    String  @default("reported")

  source          String
  sourceTimestamp DateTime?
  fetchedAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, statementType, periodType, fiscalYear, fiscalQuarter, metric])
  /// The read path: "every fact for this symbol's income statement, annual,
  /// newest first".
  @@index([symbol, statementType, periodType, periodEnd])
  /// The staleness sweep.
  @@index([fetchedAt])
}
