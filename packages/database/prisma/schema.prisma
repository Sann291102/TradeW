generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum InstrumentType {
  INDEX
  OPTION
  EQUITY
  /// Added with the scrip-master importer: the Dhan master classifies FUTIDX /
  /// FUTSTK contracts, and without this value they would have to be mislabelled
  /// as EQUITY or dropped. Not reachable under the default segment allowlist
  /// (IDX_I + NSE_EQ) — it matters when F&O segments are enabled.
  FUTURE
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  FILLED
  REJECTED
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  passwordHash       String
  country            String           @default("IN")
  experienceLevel    String?
  optionsFamiliarity String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  orders             Order[]
  trades             Trade[]
  positions          Position[]
  refreshTokens      RefreshToken[]
  preferences        UserPreference[]
  auditEvents        AuditEvent[]
  subscriptions         Subscription[]
  entitlementOverrides  EntitlementOverride[]
  journalEntries        JournalEntry[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model Instrument {
  id          String         @id @default(uuid())
  /// Platform-canonical lookup key. Deliberately kept globally unique so
  /// findUnique({ where: { symbol } }) — used by /market-data/quote-by-symbol —
  /// keeps working. The broker-native symbol lives in `tradingSymbol`.
  symbol      String         @unique
  displayName String
  type        InstrumentType
  exchange    String
  underlying  String?
  expiryDate  DateTime?
  strikePrice Decimal?       @db.Decimal(12, 2)
  optionType  String?
  lotSize     Int            @default(1)
  tickSize    Decimal        @default(0.05) @db.Decimal(10, 2)

  // ---- Broker identity (DHAN-MARKET-DATA-INTEGRATION.md §5, Phase 1) ----
  // Every Dhan REST call and WebSocket subscription addresses an instrument by
  // (exchangeSegment, securityId), never by symbol — so without these columns
  // no Dhan request can be constructed at all. Nullable because the pre-existing
  // seeded rows predate any broker mapping and must keep working unmapped.
  /// Dhan exchange-standard security ID.
  securityId           String?
  /// NSE_EQ | NSE_FNO | BSE_EQ | BSE_FNO | MCX_COMM | IDX_I
  exchangeSegment      String?
  isin                 String?
  /// Exchange-defined instrument class: EQUITY | INDEX | OPTIDX | OPTSTK | FUTIDX | ...
  dhanInstrument       String?
  series               String?
  /// M (monthly) | W (weekly), derivatives only.
  expiryFlag           String?
  /// Broker-native trading symbol, which is NOT unique across exchanges.
  tradingSymbol        String?
  /// Underlying's securityId for derivatives, as a plain reference (not an FK —
  /// the underlying may not be imported under the current segment allowlist).
  underlyingSecurityId String?

  /// Soft-delete flag. Delisted instruments are deactivated, never removed —
  /// CLAUDE.md Rule 1, and Order/Trade/Position rows reference them forever.
  active           Boolean   @default(true)
  /// Provenance of the metadata above: 'dhan-scrip-master' | 'seed'.
  metadataSource   String?
  metadataSyncedAt DateTime?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  quotes    Quote[]
  orders    Order[]
  trades    Trade[]
  positions Position[]

  @@unique([exchangeSegment, securityId])
  @@index([exchangeSegment])
  @@index([active])
  @@index([isin])
}

model Quote {
  id             String     @id @default(uuid())
  instrumentId   String     @unique
  ltp            Decimal    @db.Decimal(12, 2)
  previousClose  Decimal?   @db.Decimal(12, 2)
  open           Decimal?   @db.Decimal(12, 2)
  high           Decimal?   @db.Decimal(12, 2)
  low            Decimal?   @db.Decimal(12, 2)
  bid            Decimal?   @db.Decimal(12, 2)
  ask            Decimal?   @db.Decimal(12, 2)
  volume         BigInt?    @default(0)
  source         String     @default("simulated")
  updatedAt      DateTime   @updatedAt
  createdAt      DateTime   @default(now())
  instrument     Instrument @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId])
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  instrumentId   String
  side           OrderSide
  quantity       Int
  status         OrderStatus @default(FILLED)
  requestedPrice Decimal?    @db.Decimal(12, 2)
  fillPrice      Decimal     @db.Decimal(12, 2)
  slippage       Decimal     @db.Decimal(12, 2)
  charges        Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id])
  instrument     Instrument  @relation(fields: [instrumentId], references: [id])
  trade          Trade?

  @@index([userId, createdAt])
}

model Trade {
  id           String     @id @default(uuid())
  orderId      String     @unique
  userId       String
  instrumentId String
  side         OrderSide
  quantity     Int
  fillPrice    Decimal    @db.Decimal(12, 2)
  charges      Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  order        Order      @relation(fields: [orderId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@index([userId, createdAt])
}

model Position {
  id           String     @id @default(uuid())
  userId       String
  instrumentId String
  quantity     Int
  avgPrice     Decimal    @db.Decimal(12, 2)
  realizedPnl  Decimal    @default(0) @db.Decimal(12, 2)
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([userId, instrumentId])
  @@index([userId])
}

// ============================================================================
// Subscription & Entitlements (ARCHITECTURE decision Q7, 2026-07-16)
// Auth, subscription, billing, entitlements, usage and permissions are
// separate concerns. Billing providers integrate later ONLY through the
// SubscriptionLifecycle interface — nothing else mutates these tables.
// ============================================================================

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  GRACE
  CANCELED
  EXPIRED
}

enum QuotaPeriod {
  DAY
  MONTH
  BILLING_CYCLE
}

model Plan {
  id            String         @id @default(uuid())
  code          String         @unique // 'free' | 'tradew_pro' | 'sentinel_pro' | 'tradew_ultimate' | 'enterprise'
  name          String
  description   String         @default("")
  trialDays     Int            @default(0)
  graceDays     Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  grants        PlanGrant[]
  subscriptions Subscription[]
}

model PlanGrant {
  id          String       @id @default(uuid())
  planId      String
  capability  String // e.g. 'sentinel', 'ai_research', 'neural_brain'
  quotaMetric String?
  quotaLimit  Int?
  quotaPeriod QuotaPeriod?
  plan        Plan         @relation(fields: [planId], references: [id])

  @@unique([planId, capability])
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  organizationId   String? // future org/team subscriptions
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  expiresAt        DateTime?
  trialEndsAt      DateTime?
  canceledAt       DateTime?
  billingProvider  String             @default("none")
  billingReference String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id])
  plan             Plan               @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([status, expiresAt])
}

model EntitlementOverride {
  id         String    @id @default(uuid())
  userId     String
  capability String
  granted    Boolean
  reason     String
  grantedBy  String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, capability])
}

model UsageCounter {
  id        String   @id @default(uuid())
  userId    String
  metric    String // e.g. 'ai_requests', 'research_runs'
  periodKey String // e.g. '2026-07-16' (day) or '2026-07' (month)
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, metric, periodKey])
}

// ============================================================================
// AI Foundation — Memory Engine + Knowledge Graph (packages/ai-core contracts)
// pgvector on the existing Postgres (locked Q4: no external vector DB).
// The embedding column is dimension-flexible; embeddingModel/Dim record what
// produced it so mixed-provider embeddings are never compared to each other.
// ============================================================================

model MemoryRecord {
  id              String                 @id @default(uuid())
  summary         String
  content         String
  sourceKind      String // research|document|chart|indicator|conversation|market_report|trading_journal|task_output|observation|system
  sourceReference String?
  sourceProvider  String?
  confidence      Float                  @default(0.5)
  tags            String[]               @default([])
  entities        Json                   @default("[]")
  userId          String? // null = global/shared knowledge
  namespace       String                 @default("global")
  staleAfter      DateTime?
  metadata        Json?
  embedding       Unsupported("vector")?
  embeddingModel  String?
  embeddingDim    Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  relationsFrom   MemoryRelation[]       @relation("MemoryRelationFrom")
  relationsTo     MemoryRelation[]       @relation("MemoryRelationTo")

  @@index([namespace, userId])
  @@index([createdAt])
}

model MemoryRelation {
  id        String       @id @default(uuid())
  fromId    String
  toId      String
  relation  String       @default("related")
  createdAt DateTime     @default(now())
  from      MemoryRecord @relation("MemoryRelationFrom", fields: [fromId], references: [id])
  to        MemoryRecord @relation("MemoryRelationTo", fields: [toId], references: [id])

  @@unique([fromId, toId, relation])
  @@index([toId])
}

model GraphNode {
  id         String      @id @default(uuid())
  entityType String // 'symbol' | 'sector' | 'concept' | 'event' | 'pattern' | ...
  entityId   String      @unique // canonical id, e.g. 'NSE:RELIANCE', 'concept:bull-trap'
  label      String?
  properties Json        @default("{}")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  edgesFrom  GraphEdge[] @relation("GraphEdgeFrom")
  edgesTo    GraphEdge[] @relation("GraphEdgeTo")

  @@index([entityType])
}

model GraphEdge {
  id         String    @id @default(uuid())
  fromId     String
  toId       String
  relation   String // 'mentions' | 'belongs_to_sector' | 'derived_from' | 'supports' | 'contradicts' | ...
  weight     Float     @default(1)
  properties Json      @default("{}")
  createdAt  DateTime  @default(now())
  from       GraphNode @relation("GraphEdgeFrom", fields: [fromId], references: [id])
  to         GraphNode @relation("GraphEdgeTo", fields: [toId], references: [id])

  @@index([fromId, relation])
  @@index([toId, relation])
}

// ============================================================================
// Sentinel Concept Knowledge Graph — the reasoning ontology
// Canonical source of truth is YAML under knowledge-base/ at the repo root;
// these tables are its runtime projection (SENTINEL-KNOWLEDGE-GRAPH.md §3).
//
// Distinct from GraphNode/GraphEdge above, which is an *entity* graph — it
// records that a symbol and a pattern co-occurred. This is a *concept* graph:
// every edge states how two ideas relate, which is what makes it reasonable
// over. The two are bridged by ConceptObservation.symbol, not by a join.
//
// Reseed contract: the seeder rewrites only columns marked "canonical" below
// and never touches learned* / *Count / observations. That separation is what
// lets the ontology be regenerated from YAML without destroying what Sentinel
// learned at runtime.
// ============================================================================

model ConceptNode {
  // ---- canonical, projected from YAML on every reseed ----
  id             String   @id @default(uuid())
  conceptId      String   @unique // stable slug, e.g. 'liquidity-sweep'
  domain         String // one of the 15 in brain/ontology/domains.ts
  name           String
  aliases        String[] @default([])
  status         String   @default("canonical") // canonical | proposed | deprecated
  maturity       String   @default("established") // established | emerging | contested
  confidence     Float    @default(0.7)
  summary        String
  definition     String
  explainer      String // the text users actually read
  observableWhen String[] @default([])
  examples       Json     @default("[]")
  sources        String[] @default([])
  tags           String[] @default([])

  // Plain slug references, not FKs — a concept may name its successor before
  // that successor has been authored, and a FK would make seed order matter.
  supersededBy String?
  supersedes   String?

  // ---- provenance ----
  origin     String  @default("canonical") // canonical (from YAML) | learned (runtime-proposed)
  sourcePath String? // knowledge-base/<domain>/<id>.yaml
  checksum   String? // sha256 of the YAML doc; lets reseed skip untouched rows

  // ---- runtime learning, never written by the seeder ----
  observationCount Int       @default(0)
  lastObservedAt   DateTime?

  // Populated once an embedding provider is configured; unset today, in which
  // case concept search falls back to text match (same gap as MemoryRecord).
  embedding      Unsupported("vector")?
  embeddingModel String?
  embeddingDim   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edgesFrom    ConceptEdge[]        @relation("ConceptEdgeFrom")
  edgesTo      ConceptEdge[]        @relation("ConceptEdgeTo")
  observations ConceptObservation[]

  @@index([domain])
  @@index([status, confidence])
  @@index([origin])
}

model ConceptEdge {
  id       String  @id @default(uuid())
  fromId   String
  toId     String
  relation String // closed vocabulary — brain/ontology/relations.ts
  note     String?

  // canonical prior authored in YAML — rewritten by reseed
  weight Float @default(0.7)

  // runtime-derived; reseed must never overwrite these four
  learnedWeight  Float?
  supportCount   Int       @default(0)
  refuteCount    Int       @default(0)
  lastObservedAt DateTime?

  origin     String @default("canonical") // canonical | learned
  status     String @default("canonical") // canonical | proposed | deprecated
  confidence Float  @default(0.7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from ConceptNode @relation("ConceptEdgeFrom", fields: [fromId], references: [id])
  to   ConceptNode @relation("ConceptEdgeTo", fields: [toId], references: [id])

  @@unique([fromId, toId, relation])
  @@index([fromId, relation])
  @@index([toId, relation])
  @@index([origin, status])
}

/// Append-only log of the graph meeting reality. Never updated, never deleted —
/// learned weights are derived from these rows, so mutating one would rewrite
/// history that a past explanation already cited.
model ConceptObservation {
  id       String  @id @default(uuid())
  conceptId String // FK to ConceptNode.id (not the slug)
  edgeId   String? // set when the observation is about a relation, not a concept
  symbol   String? // bridge to the entity graph / market data
  outcome  String // confirmed | refuted | inconclusive
  strength Float   @default(0.5)
  context  Json    @default("{}")

  /// SentinelObservation.id that produced this, for audit traceability.
  observationId String?
  namespace     String  @default("global")

  observedAt DateTime @default(now())

  concept ConceptNode @relation(fields: [conceptId], references: [id])

  @@index([conceptId, observedAt])
  @@index([edgeId])
  @@index([symbol, observedAt])
}

/// Human review queue. Runtime learning proposes here; a person promotes the
/// entry into YAML; the next reseed makes it canonical. Sentinel never edits
/// the canonical source files itself.
model ConceptPromotion {
  id String @id @default(uuid())

  /// Service-computed stable key. A composite @@unique cannot dedupe these
  /// because Postgres treats NULLs as distinct and most columns are nullable.
  dedupeKey String @unique

  kind        String // concept | relation
  conceptId   String? // proposed concept slug
  fromConcept String?
  toConcept   String?
  relation    String?

  rationale    String
  evidence     Json   @default("{}")
  supportCount Int    @default(0)
  confidence   Float  @default(0)

  status     String    @default("pending") // pending | approved | rejected | merged
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, confidence])
}

// ============================================================================
// Sentinel — observations (compliance audit trail) + trading journal
// Every user-visible Sentinel output traces back to logged, evidenced
// observations (SENTINEL.md §6). Sentinel never blocks or delays orders.
// ============================================================================

model SentinelObservation {
  id         String   @id @default(uuid())
  userId     String? // null = market-wide observation not tied to a user
  agent      String // 'market-technical' | 'emotion' | 'trap-safety' | 'compliance-audit' | 'orchestrator'
  category   String // SEBI-relevant label assigned by the Compliance & Audit agent
  pattern    String? // e.g. 'bull_trap', 'low_volume_breakout', 'revenge_trading'
  symbol     String?
  content    String // observation text (evidence -> pattern -> soft suggestion)
  evidence   Json     @default("[]")
  confidence Float    @default(0.5)
  surfaced   Boolean  @default(false) // whether the orchestrator surfaced it to the user
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agent, createdAt])
  @@index([symbol, createdAt])
}

model JournalEntry {
  id           String   @id @default(uuid())
  userId       String
  mood         String? // 'focused' | 'anxious' | 'confident' | 'frustrated' | ...
  content      String
  flaggedByAi  Boolean  @default(false)
  aiAnnotation String?
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ============================================================================
// News Event Intelligence — 13-category financial news event classification
// (NVIDIA AI Model Distillation blueprint; served by any LlmProvider, incl.
// a distilled student model on NVIDIA NIM, selected purely by config)
// ============================================================================

model NewsEvent {
  id           String   @id @default(uuid())
  headline     String
  source       String
  url          String?
  publishedAt  DateTime
  symbols      String[] @default([])
  eventType    String // one of the 13 standardized event categories
  classifiedBy String // provider/model that produced the label
  confidence   Float?
  raw          Json?
  createdAt    DateTime @default(now())

  @@index([eventType, publishedAt])
  @@index([publishedAt])
}
