{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // Specs are excluded from the build, not merely from the published surface.
  // ai-core is consumed by its compiled `dist/`, and `postinstall` builds it on
  // every clean checkout — a spec left in `include` would put vitest on the
  // critical path of `npm install` for every service in the monorepo, and emit
  // test files into the package's public output.
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts"]
}
